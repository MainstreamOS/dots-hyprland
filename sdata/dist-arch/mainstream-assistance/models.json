  "scripts": {
    "geminiUsage": {
      "userAgent": "antigravity/1.5.12 linux/amd64",
      "generalFallback": [
        "gemini-4-hydrogen-sonar",
        "gemini-3.8-flash-tiered",
        "gemini-3.1-pro-low",
        "gemini-3.6-flash-high",
        "gemini-pro-agent"
      ],
      "buckets": [
        {
          "match": "carbon",
          "preferred": [
            "gemini-4-carbon",
            "gemini-4-carbon-high",
            "gemini-4-carbon-medium",
            "gemini-4-carbon-low"
          ],
          "substrKey": "carbon",
          "missingMeansExhausted": true
        },
        {
          "match": "argon",
          "preferred": [
            "gemini-4-argon",
            "gemini-4.0-argon",
            "gemini-4-argon-high",
            "gemini-4-argon-medium",
            "gemini-4-argon-low"
          ],
          "substrKey": "argon",
          "missingMeansExhausted": true
        },
        {
          "match": "neon",
          "preferred": [
            "gemini-4-neon",
            "gemini-4-neon-high",
            "gemini-4-neon-xhigh",
            "gemini-4-neon-medium",
            "gemini-4-neon-low"
          ],
          "substrKey": "neon",
          "missingMeansExhausted": false
        },
        {
          "match": "hydrogen",
          "preferred": [
            "gemini-4-hydrogen",
            "gemini-4-hydrogen-sonar",
            "gemini-4-hydrogen-high",
            "gemini-4-hydrogen-xhigh",
            "gemini-4-hydrogen-medium",
            "gemini-4-hydrogen-low"
          ],
          "substrKey": "hydrogen",
          "missingMeansExhausted": false
        },
        {
          "match": "pro",
          "preferred": [
            "gemini-3.1-pro-low",
            "gemini-3.1-pro-high",
            "gemini-pro-agent",
            "gemini-2.5-pro"
          ],
          "substrKey": null,
          "missingMeansExhausted": false
        },
        {
          "match": "flash",
          "preferred": [
            "gemini-3.8-flash-tiered",
            "gemini-3.8-flash-medium",
            "gemini-3.6-flash-high",
            "gemini-3.1-flash-lite"
          ],
          "substrKey": null,
          "missingMeansExhausted": false
        }
      ]
    },
    "translate": {
      "model": "gemini-3.8-flash",
      "thinkingLevel": "low"
    },
    "wallpaperCategorize": {
      "model": "gemini-3.5-flash-lite"
    },
    "liveTranscribe": {
      "model": "models/gemini-3.5-transcribe-live",
      "apiVersion": "v1alpha"
    }
  },
