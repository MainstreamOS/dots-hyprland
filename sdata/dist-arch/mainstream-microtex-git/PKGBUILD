# Maintainer: mainstreamos <https://github.com/MainstreamOS>
groups=(mainstream)
pkgname=mainstream-microtex-git
_pkgname=MicroTeX
pkgver=r494.0e3707f
pkgrel=5
pkgdesc='MicroTeX for Mainstream OS dotfiles.'
provides=('illogical-impulse-microtex-git')
replaces=('illogical-impulse-microtex-git')
#pkgdesc="A dynamic, cross-platform, and embeddable LaTeX rendering library"
arch=("x86_64")
options=(!debug)
#url="https://github.com/NanoMichael/${_pkgname}"
url="https://github.com/end-4/${_pkgname}"
license=('MIT')
depends=(
  cairomm
  libcairomm-1.0.so
  fontconfig
  libfontconfig.so
  gcc-libs
  glibc
  gtkmm3
  libgtkmm-3.0.so
  gtksourceviewmm
  'tinyxml2>=11'
  'tinyxml2<12'
)
makedepends=("git" "cmake")
source=("git+${url}.git")
sha256sums=("SKIP")

prepare() {
  cd $_pkgname
  sed -i 's/gtksourceviewmm-3.0/gtksourceviewmm-4.0/' CMakeLists.txt
}

build() {
  cd $_pkgname
  cmake -B build -S . -DCMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  cd $_pkgname
  install -Dm0755 -t "$pkgdir/opt/$_pkgname/" build/LaTeX
  cp -r build/res "$pkgdir/opt/$_pkgname/"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
