#!/usr/bin/env bash
# mainstream-kernels: privileged helper for the Kernel section in Settings > Gaming.
# Installed at /usr/lib/mainstream/mainstream-kernels and invoked via pkexec
# (polkit action org.mainstreamos.kernels).
#
# Subcommands:
#   install <kernel>    linux, mainstream, mainstream-performance or
#                       mainstream-performance-eac, with its headers, from a repository
#   remove <kernel>     one of those, while another kernel stays installed
#   next <kernel>       one of those: the kernel the boot menu starts at the next start
#   migrate             move what still names a renamed kernel package to its new
#                       name (mainstream-system's pacman hook; refused through pkexec)
#
# A kernel is always named by its package and never by a file path. Mainstream's
# kernels are also accepted under the names they had before (linux-mainstream,
# linux-mainstream-performance), and the package of either name is the one changed.
#
# Exit codes:
#   0   success
#   1   general error (one-line human reason on stderr: "mainstream-kernels: <reason>")
#   2   bad usage, or a kernel this helper does not handle
#   3   precondition not met (started from a snapshot, or a boot setup this helper
#       cannot change)
#   4   the package transaction failed
#   5   this processor cannot run the performance or anti-cheat kernel
#   6   the EFI partition does not have room for another kernel, or the room could
#       not be measured
#   7   the kernel is installed, but the graphics driver could not be built for it
#   8   remove refused (the running kernel, a kernel that is not installed, or the
#       only kernel)
#   9   the boot menu's choice cannot be stored on this system
#   10  another change is running (kernel, Secure Boot, update, or package manager)
#   11  no repository offers the kernel
#   12  next refused: the kernel has no graphics driver while another kernel has one
#   13  install refused: the anti-cheat kernel cannot load the NVIDIA driver in use

set -uo pipefail
umask 022
PATH=/usr/bin
export PATH LC_ALL=C

# Test harness root & mock binary override: strictly ignored when invoked via
# pkexec (which strips environment variables and sets PKEXEC_UID). The mock
# directory replaces /usr/bin, so a tool with no stand-in is missing, never real.
ROOT=""
if [[ -z ${PKEXEC_UID:-} && -n ${MAINSTREAM_KERNELS_TEST_ROOT:-} ]]; then
    ROOT=${MAINSTREAM_KERNELS_TEST_ROOT%/}
    if [[ -n ${MAINSTREAM_KERNELS_TEST_BIN:-} ]]; then
        PATH=${MAINSTREAM_KERNELS_TEST_BIN}
    fi
fi

ROOT_MOUNT="${ROOT:-/}"

LIMINE_DEFAULT="$ROOT/etc/default/limine"
LOG_DIR="$ROOT/var/log/mainstream"
LOG="$LOG_DIR/mainstream-kernels.log"
LOCK_DIR="$ROOT/run/lock"
LOCK_FILE="$LOCK_DIR/mainstream-kernels.lock"
# The locks of the other things that change boot files or packages.
SECURITY_LOCK="$LOCK_DIR/mainstream-system-security.lock"
UPDATE_LOCK="$LOCK_DIR/mainstream-update.lock"
PACMAN_LOCK="$ROOT/var/lib/pacman/db.lck"
EFIVARS_DIR="$ROOT/sys/firmware/efi/efivars"
# Where Limine records the entry it started, which it preselects at the next start.
LAST_ENTRY_VAR="$EFIVARS_DIR/LimineLastBootedEntry-03884334-1756-4978-9c8c-86fb8998b4ea"
MODULES_DIR="$ROOT/usr/lib/modules"
CPUINFO="$ROOT/proc/cpuinfo"
GPU_LIB="$ROOT/usr/local/lib/gpu-config.sh"
GPU_INSTALL_LIB="$ROOT/usr/local/lib/gpu-driver-install.sh"

VERBS=(install remove next)
STANDARD_KERNEL=linux
PERFORMANCE_KERNEL=mainstream-performance
EAC_KERNEL=mainstream-performance-eac
# The kernels Settings offers.
MAINSTREAM_KERNELS=(mainstream "$PERFORMANCE_KERNEL" "$EAC_KERNEL")
# Every Mainstream kernel as old:new package name. A system keeps the old packages
# until an update swaps them, and an older Settings or setup still uses the old names.
RENAMED_KERNELS=(
    linux-mainstream:mainstream
    linux-mainstream-performance:mainstream-performance
    linux-mainstream-performance-eac:mainstream-performance-eac
)

ROOT_FSTYPE=""
ROOT_SUBVOL=""
ESP=""
ENTRY=""
ENTRY_ATTRS=""

log() {
    local msg=$*
    [[ -L $LOG ]] && return 0
    [[ -d $LOG_DIR ]] || mkdir -p -m 755 -- "$LOG_DIR" 2>/dev/null || return 0
    printf '%s %s\n' "$(date '+%F %T')" "${msg//[[:cntrl:]]/?}" >>"$LOG" 2>/dev/null || true
}

die() {  # $1 = exit code, $2... = message
    local code=$1 msg
    shift
    msg=$*
    log "failed ($code): $msg"
    printf 'mainstream-kernels: %s\n' "${msg//[[:cntrl:]]/?}" >&2
    exit "$code"
}

refuse_symlinks() {
    local p
    for p in "$@"; do
        [[ -L $p ]] && die 1 "refusing to work through symlink $p"
    done
    return 0
}

is_one_of() {  # $1 = word, $2... = the words it may be
    local word=$1 w
    shift
    for w in "$@"; do
        [[ $w == "$word" ]] && return 0
    done
    return 1
}

# A kernel's name today, whichever of its names $1 is.
kernel_name() {
    local pair
    for pair in "${RENAMED_KERNELS[@]}"; do
        if [[ $1 == "${pair%%:*}" ]]; then
            printf '%s' "${pair#*:}"
            return 0
        fi
    done
    printf '%s' "$1"
}

# Both names of a kernel, today's first; one name for a kernel that was never renamed.
kernel_names() {
    local name pair
    name=$(kernel_name "$1")
    printf '%s\n' "$name"
    for pair in "${RENAMED_KERNELS[@]}"; do
        [[ $name == "${pair#*:}" ]] && printf '%s\n' "${pair%%:*}"
    done
    return 0
}

# By the explicit list: a pattern would also take mainstream-system and the rest.
is_mainstream_kernel() {
    local name pair
    name=$(kernel_name "$1")
    for pair in "${RENAMED_KERNELS[@]}"; do
        [[ $name == "${pair#*:}" ]] && return 0
    done
    return 1
}

detect_root_info() {
    local src="" fstype=""
    read -r src fstype < <(findmnt -n -o SOURCE,FSTYPE "$ROOT_MOUNT" 2>/dev/null | head -n1) || true
    ROOT_SUBVOL=""
    if [[ $src == *\[*\] ]]; then
        ROOT_SUBVOL=${src#*\[}
        ROOT_SUBVOL=${ROOT_SUBVOL%\]}
    fi
    ROOT_FSTYPE="$fstype"
}

# A snapshot started from the boot menu runs on the read-only snapshot itself or on an
# overlay above it; packages changed there do not last, while the EFI partition and
# the firmware keep the change.
require_installed_system() {
    detect_root_info
    if [[ $ROOT_FSTYPE == overlay || $ROOT_SUBVOL =~ (^|/)(@|@?\.)snapshots/[0-9]+/snapshot$ ]]; then
        die 3 "started from a snapshot; restart into the installed system first"
    fi
}

# The boot image and the menu entry of a kernel are made by these tools' package hooks.
require_limine_tools() {
    local tool
    for tool in limine-update limine-mkinitcpio limine-enroll-config; do
        command -v "$tool" >/dev/null 2>&1 || \
            die 3 "this system does not use Mainstream's Limine boot tools ($tool is missing)"
    done
}

limine_setting() {
    local key=$1 f line val=""
    for f in "$ROOT"/usr/share/limine-entry-tool.d/*.conf \
             "$ROOT/etc/limine-entry-tool.conf" \
             "$ROOT"/etc/limine-entry-tool.d/*.conf \
             "$LIMINE_DEFAULT"; do
        [[ -f $f ]] || continue
        while IFS= read -r line || [[ -n $line ]]; do
            [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
            [[ ${BASH_REMATCH[1]} == "$key" ]] || continue
            val=${BASH_REMATCH[2]}
            val=${val%\"}
            val=${val#\"}
        done <"$f"
    done
    printf '%s' "$val"
}

find_esp() {
    ESP=""
    local p cfg
    cfg=$(limine_setting ESP_PATH)
    if [[ -n ${cfg// /} ]]; then
        if [[ -d "$ROOT$cfg" ]]; then
            ESP="$ROOT$cfg"
            return 0
        fi
    fi
    for p in /boot/efi /efi /boot /limine; do
        [[ -d "$ROOT$p" ]] || continue
        if [[ -z $ROOT ]]; then
            if [[ $(findmnt -no FSTYPE -M "$p" 2>/dev/null | head -n1) == vfat ]]; then
                ESP="$p"
                return 0
            fi
        else
            if [[ -d "$ROOT$p/EFI" || -f "$ROOT$p/limine.conf" ]]; then
                ESP="$ROOT$p"
                return 0
            fi
        fi
    done
    return 1
}

# pacman -Q also answers for a package that only provides the name.
pkg_installed() {
    [[ $(pacman -Qq -- "$1" 2>/dev/null) == "$1" ]]
}

pkg_in_repo() {
    pacman -Si -- "$1" >/dev/null 2>&1
}

# The installed package of kernel $1, under either of its names.
installed_package() {
    local name
    while IFS= read -r name; do
        if pkg_installed "$name"; then
            printf '%s' "$name"
            return 0
        fi
    done < <(kernel_names "$1")
    return 1
}

# The package a repository offers, with its headers, for kernel $1: today's name, or
# the old one while the repositories still carry that.
repo_package() {
    local name
    while IFS= read -r name; do
        if pkg_in_repo "$name" && pkg_in_repo "$name-headers"; then
            printf '%s' "$name"
            return 0
        fi
    done < <(kernel_names "$1")
    return 1
}

# The package of the kernel that is running. Its module tree is gone once the package
# was updated or removed under it, and the release still ends in the package's name.
running_kernel() {
    local rel base=""
    rel=$(uname -r 2>/dev/null) || rel=""
    if [[ -n $rel && -r "$MODULES_DIR/$rel/pkgbase" ]]; then
        IFS= read -r base <"$MODULES_DIR/$rel/pkgbase" || true
    fi
    if [[ -z $base ]]; then
        case $rel in
            *-mainstream-performance-eac) base=mainstream-performance-eac ;;
            *-mainstream-performance) base=$PERFORMANCE_KERNEL ;;
            *-mainstream) base=mainstream ;;
            *-arch[0-9]*) base=$STANDARD_KERNEL ;;
        esac
    fi
    printf '%s' "$base"
}

# Every kernel this system can start, one package name per line: a module tree with a
# kernel image and the name of the package that owns it.
installed_kernels() {
    local d base
    for d in "$MODULES_DIR"/*/; do
        [[ -f "${d}vmlinuz" && -r "${d}pkgbase" ]] || continue
        base=""
        IFS= read -r base <"${d}pkgbase" || true
        [[ -n $base ]] && printf '%s\n' "$base"
    done
    return 0
}

kernel_has_nvidia_module() {  # $1 = kernel package
    local d base f
    for d in "$MODULES_DIR"/*/; do
        [[ -f "${d}vmlinuz" && -r "${d}pkgbase" ]] || continue
        base=""
        IFS= read -r base <"${d}pkgbase" || true
        [[ $base == "$1" ]] || continue
        for f in "${d}"updates/dkms/nvidia.ko* "${d}"extramodules/nvidia.ko* \
                 "${d}"kernel/drivers/video/nvidia.ko*; do
            # The anti-cheat kernel loads only modules signed with its own key, which
            # a DKMS build never is.
            [[ $1 == "$EAC_KERNEL" && $f == "${d}"updates/dkms/* ]] && continue
            [[ -f $f ]] && return 0
        done
    done
    return 1
}

# Whether an NVIDIA kernel driver package is installed: none of them loads on the
# anti-cheat kernel, so a card that uses one would start it without graphics.
nvidia_driver_installed() {
    local pkgs
    pkgs=$(pacman -Qq 2>/dev/null) || return 1
    grep -qxE 'nvidia(-open)?(-[0-9]+xx)?(-dkms|-lts)?' <<<"$pkgs"
}

# The performance and anti-cheat kernels are built for x86-64-v3.
cpu_runs_performance_kernel() {
    local line flags="" flag
    [[ -r $CPUINFO ]] || return 1
    while IFS= read -r line; do
        if [[ $line == flags* ]]; then
            flags=" ${line#*:} "
            break
        fi
    done <"$CPUINFO"
    for flag in avx avx2 bmi1 bmi2 f16c fma movbe xsave; do
        [[ $flags == *" $flag "* ]] || return 1
    done
    [[ $flags == *" abm "* || $flags == *" lzcnt "* ]]
}

# The size in bytes of what the boot menu starts for kernel $1: its one image, or its
# kernel and initramfs where the system does not build single images. 0 when none.
kernel_image_bytes() {
    local kernel=$1 f size best=0 total=0 d
    for f in "$ESP"/EFI/Linux/*_"$kernel".efi "$ESP/EFI/Linux/$kernel.efi"; do
        [[ -f $f ]] || continue
        size=$(stat -c %s -- "$f" 2>/dev/null) || continue
        [[ $size =~ ^[0-9]+$ ]] && (( size > best )) && best=$size
    done
    if (( best == 0 )); then
        for d in "$ESP"/*/"$kernel"/; do
            [[ -d $d ]] || continue
            total=0
            for f in "$d"*; do
                [[ -f $f ]] || continue
                size=$(stat -c %s -- "$f" 2>/dev/null) || continue
                [[ $size =~ ^[0-9]+$ ]] && total=$((total + size))
            done
            (( total > best )) && best=$total
        done
    fi
    printf '%s' "$best"
}

# The largest boot image of the installed kernels, which stands for the next one.
largest_image_bytes() {
    local kernel size best=0
    while IFS= read -r kernel; do
        [[ -n $kernel ]] || continue
        size=$(kernel_image_bytes "$kernel")
        (( size > best )) && best=$size
    done < <(installed_kernels)
    (( best > 0 )) || return 1
    printf '%s' "$best"
}

# The snapshot tooling keeps a copy of each boot image, so a kernel takes its image
# twice. 32 MiB stays free for the next image an update builds.
require_esp_room() {
    local image avail need
    find_esp || die 6 "could not find the EFI partition, so its free space cannot be checked"
    image=$(largest_image_bytes) || \
        die 6 "could not find an installed kernel's boot image on the EFI partition, so the room for another kernel cannot be checked"
    avail=$(df -B1 --output=avail -- "$ESP" 2>/dev/null | tail -n1 | tr -d '[:space:]')
    [[ $avail =~ ^[0-9]+$ ]] || die 6 "could not read the free space on the EFI partition"
    need=$((image * 2 + 32 * 1024 * 1024))
    if (( avail < need )); then
        die 6 "the EFI partition has $((avail / 1048576)) MiB free and another kernel needs $(((need + 1048575) / 1048576)) MiB"
    fi
    log "EFI partition: $((avail / 1048576)) MiB free, $(((need + 1048575) / 1048576)) MiB needed"
}

# Four bytes of attributes, then the entry's path in the menu, ended by a zero byte.
read_last_entry() {
    ENTRY=""
    ENTRY_ATTRS=""
    [[ -f $LAST_ENTRY_VAR && ! -L $LAST_ENTRY_VAR ]] || return 1
    ENTRY=$(tail -c +5 -- "$LAST_ENTRY_VAR" 2>/dev/null | tr -d '\0') || return 1
    ENTRY_ATTRS=$(head -c 4 -- "$LAST_ENTRY_VAR" 2>/dev/null | od -An -tx1) || return 1
    [[ -n $ENTRY && $ENTRY_ATTRS =~ ^(\ [0-9a-f]{2}){4}$ ]]
}

# Whether the recorded entry is a kernel of the installed system, which is the only
# kind of entry whose place in the menu says where another kernel's entry is.
entry_is_installed_kernel() {
    [[ $ENTRY == */Snapshots/* ]] && return 1
    [[ $ENTRY == ?*/?* ]] || return 1
    # shellcheck disable=SC2046
    is_one_of "$(kernel_name "${ENTRY##*/}")" "$STANDARD_KERNEL" "${MAINSTREAM_KERNELS[@]}" \
        || is_one_of "${ENTRY##*/}" $(installed_kernels)
}

# efivarfs marks its files immutable and takes a variable in one write.
write_last_entry() {  # $1 = the entry's path in the menu
    local new=$1 got
    chattr -i -- "$LAST_ENTRY_VAR" 2>/dev/null || true
    # shellcheck disable=SC2059
    { printf "${ENTRY_ATTRS// /\\x}"; printf '%s\0' "$new"; } \
        | dd of="$LAST_ENTRY_VAR" bs=4096 iflag=fullblock status=none 2>/dev/null || return 1
    got=$(tail -c +5 -- "$LAST_ENTRY_VAR" 2>/dev/null | tr -d '\0') || return 1
    [[ $got == "$new" ]]
}

# The kernel the boot menu goes to once $1 is removed: the first left of the
# performance, Mainstream and Arch kernels, then any other, taking one with the
# NVIDIA module where another kernel has one. Fails when none is left. Prints the
# package as installed, which is what its boot menu entry is named after.
fallback_kernel() {  # $1 = the removed kernel
    local k want
    local -a left=() order=()
    while IFS= read -r k; do
        [[ -n $k && $k != "$1" ]] && left+=("$k")
    done < <(installed_kernels)
    (( ${#left[@]} )) || return 1
    for want in "$PERFORMANCE_KERNEL" mainstream "$STANDARD_KERNEL"; do
        for k in "${left[@]}"; do
            [[ $(kernel_name "$k") == "$want" ]] && ! is_one_of "$k" "${order[@]}" && order+=("$k")
        done
    done
    for k in "${left[@]}"; do
        is_one_of "$k" "${order[@]}" || order+=("$k")
    done
    for k in "${order[@]}"; do
        if kernel_has_nvidia_module "$k"; then
            printf '%s' "$k"
            return 0
        fi
    done
    printf '%s' "${order[0]}"
}

# A default_entry that names the removed kernel's entry would name nothing.
# ./setup writes that setting as the entry's path; the number the ISO writes
# needs no change. Returns 1 when the menu could not be changed, and sets
# DEFAULT_ENTRY_MOVED when it was.
DEFAULT_ENTRY_MOVED=0
repoint_default_entry() {  # $1 = the kernel whose entry goes, $2 = the kernel to name instead
    local conf line val="" tmp lock rc=0
    find_esp || return 0
    conf="$ESP/limine.conf"
    [[ -f $conf && ! -L $conf ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*/ ]] && break
        if [[ $line =~ ^[[:space:]]*default_entry:[[:space:]]*(.*[^[:space:]])[[:space:]]*$ ]]; then
            val=${BASH_REMATCH[1]}
        fi
    done <"$conf"
    [[ $val == ?*/"$1" ]] || return 0
    tmp="$conf.mainstream-kernels"
    lock="$LOCK_DIR/boot-partition.lock"
    refuse_symlinks "$tmp" "$lock"
    # The lock limine-entry-tool and limine-snapper-sync take for this file.
    (
        flock -w 60 9 || exit 1
        local entries=0
        while IFS= read -r line || [[ -n $line ]]; do
            [[ $line =~ ^[[:space:]]*/ ]] && entries=1
            if (( ! entries )) && [[ $line =~ ^([[:space:]]*default_entry:[[:space:]]*)(.*/)"$1"[[:space:]]*$ ]]; then
                line="${BASH_REMATCH[1]}${BASH_REMATCH[2]}$2"
            fi
            printf '%s\n' "$line"
        done <"$conf" >"$tmp" && mv -f "$tmp" "$conf"
    ) 9>>"$lock" || rc=1
    rm -f "$tmp" 2>/dev/null
    (( rc == 0 )) || return 1
    DEFAULT_ENTRY_MOVED=1
    log "the boot menu's default entry names $2 instead of $1"
    # An enrolled checksum of the old file would stop Limine at the next start.
    if [[ $(limine_setting ENABLE_ENROLL_LIMINE_CONFIG) == yes ]]; then
        limine-enroll-config </dev/null >>"$LOG" 2>&1 || return 1
    fi
}

# The driver packages build for the kernels they find, and the prebuilt driver serves
# the standard kernel alone, so every installed kernel is checked for a module.
# Returns 1 when a kernel is left without one.
nvidia_modules_for_all_kernels() {
    local lib
    for lib in "$GPU_LIB" "$GPU_INSTALL_LIB"; do
        if [[ ! -f $lib || -L $lib ]]; then
            log "install: ${lib#"$ROOT"} is missing, so no graphics driver step was run"
            printf 'mainstream-kernels: %s is missing, so the NVIDIA driver was not checked for the new kernel\n' \
                "${lib#"$ROOT"}" >&2
            return 0
        fi
    done
    # In a subshell: the libraries set many variables and are not written for this
    # helper's own settings.
    (
        set +u
        GPU_SUDO=""
        GPU_DB_REFRESH=false
        # shellcheck source=/dev/null
        source "$GPU_LIB" || exit 1
        # shellcheck source=/dev/null
        source "$GPU_INSTALL_LIB" || exit 1
        gpu_detect || exit 0
        [[ ${HAS_NVIDIA:-false} == true ]] || exit 0
        echo "NVIDIA card found; checking the driver for every installed kernel."
        gpu_classify_nvidia_driver
        gpu_nvidia_ensure_modules
    ) </dev/null >>"$LOG" 2>&1
}

# ── Renamed kernel packages ──────────────────────────────────────────────────
# An update swaps a renamed kernel's package for the new one like any kernel update:
# the boot tools' removal hooks take the old entries, images and preset away. What
# names the old package stays: BOOT_ORDER, a default entry by path and the firmware's
# boot record, and another boot loader's menu. Whatever the hooks left behind goes
# too. updatems-system and mainstream-system's pacman hook run this; it changes only
# what still names an old package, so a second run does nothing. Prints one line per
# change, sets BOOT_ORDER_MOVED to the kernels whose place in the menu changed, and
# returns 1 when a step failed.
BOOT_ORDER_MOVED=()
migrate_renamed_kernels() {
    local pair old new rc=0
    BOOT_ORDER_MOVED=()
    for pair in "${RENAMED_KERNELS[@]}"; do
        old=${pair%%:*} new=${pair#*:}
        # Half way, with the old package still in place, everything stays as it is.
        pkg_installed "$old" && continue
        pkg_installed "$new" || continue
        # shellcheck disable=SC2046
        is_one_of "$new" $(installed_kernels) || continue
        # On a Limine system nothing moves before the new package has its entry, so no
        # setting names an entry the menu lacks and the kernel never drops off it.
        if find_esp && [[ -f $ESP/limine.conf ]] && ! menu_has_entry "$ESP/limine.conf" "$new" ""; then
            log "migrate: $new has no boot menu entry yet, so nothing moves from $old"
            continue
        fi
        # The settings that pick an entry move first, so none of them names an entry
        # that is about to go.
        migrate_boot_order "$old" "$new" || rc=1
        DEFAULT_ENTRY_MOVED=0
        if repoint_default_entry "$old" "$new"; then
            (( DEFAULT_ENTRY_MOVED )) && printf "The boot menu's default entry names %s instead of %s\n" "$new" "$old"
        else
            rc=1
        fi
        migrate_last_entry "$old" "$new" || rc=1
        migrate_preset "$old" "$new" || rc=1
        remove_old_entries "$old" || rc=1
        remove_old_boot_files "$old" || rc=1
        forget_old_signed_files "$old" || rc=1
        migrate_other_loaders "$old" "$new" || rc=1
    done
    return "$rc"
}

# The name limine-entry-tool gives a kernel's boot image in EFI/Linux: the prefix
# (CUSTOM_UKI_NAME, or the machine ID) and the kernel's name, unless the name already
# starts with the prefix, as mainstream and mainstream-performance do.
uki_file_name() {  # $1 = prefix, $2 = kernel entry name
    if [[ $2 == "$1"* ]]; then
        printf '%s.efi' "$2"
    else
        printf '%s_%s.efi' "$1" "$2"
    fi
}

# Whether $2 is kernel $1's name in a boot file's name: alone or with -fallback after
# it, and never the start of a longer kernel name such as $1-performance.
names_kernel() {  # $1 = kernel, $2 = word
    [[ $2 == "$1" || $2 == "$1-fallback" ]]
}

# BOOT_ORDER in /etc/default/limine names the entries the menu lists first.
migrate_boot_order() {  # $1 = old name, $2 = new name
    local line out="" changed=0 item word joined tmp
    local -a items
    [[ -f $LIMINE_DEFAULT && ! -L $LIMINE_DEFAULT ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ ^([[:space:]]*BOOT_ORDER[[:space:]]*=[[:space:]]*\"?)([^\"]*)(\"?[[:space:]]*)$ ]]; then
            local lead=${BASH_REMATCH[1]} rest=${BASH_REMATCH[3]}
            IFS=, read -ra items <<<"${BASH_REMATCH[2]}"
            joined=""
            for item in "${items[@]}"; do
                word=${item#"${item%%[![:space:]]*}"}
                word=${word%"${word##*[![:space:]]}"}
                if names_kernel "$1" "$word"; then
                    item=${item/"$1"/"$2"}
                    changed=1
                fi
                joined+="${joined:+,}$item"
            done
            line="$lead$joined$rest"
        fi
        out+="$line"$'\n'
    done <"$LIMINE_DEFAULT"
    (( changed )) || return 0
    tmp="$LIMINE_DEFAULT.mainstream-kernels"
    refuse_symlinks "$tmp"
    if ! { printf '%s' "$out" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$LIMINE_DEFAULT"; }; then
        rm -f "$tmp" 2>/dev/null
        log "migrate: could not rewrite BOOT_ORDER for $2"
        return 1
    fi
    log "migrate: BOOT_ORDER names $2 instead of $1"
    BOOT_ORDER_MOVED+=("$2")
    printf 'BOOT_ORDER names %s instead of %s\n' "$2" "$1"
}

# The entry Limine preselects at the next start, as the firmware keeps it.
migrate_last_entry() {  # $1 = old name, $2 = new name
    local name
    read_last_entry || return 0
    [[ $ENTRY != */Snapshots/* ]] || return 0
    name=${ENTRY##*/}
    names_kernel "$1" "$name" || return 0
    if ! write_last_entry "${ENTRY%/*}/$2${name#"$1"}"; then
        log "migrate: could not point the firmware's boot record at $2"
        return 1
    fi
    log "migrate: the firmware's boot record names $2 instead of $1"
    printf "The firmware's boot record names %s instead of %s\n" "$2" "$1"
}

# A preset for a package that is gone fails mkinitcpio -P as a whole. Its file names
# follow the package's name, and the kernel copy it names is made if missing.
migrate_preset() {  # $1 = old name, $2 = new name
    local dir="$ROOT/etc/mkinitcpio.d" from to tmp kver rel d
    from="$dir/$1.preset"
    to="$dir/$2.preset"
    [[ -f $from && ! -L $from ]] || return 0
    refuse_symlinks "$to"
    if [[ ! -e $to ]]; then
        tmp="$to.mainstream-kernels"
        refuse_symlinks "$tmp"
        if ! { sed -E "s/(^|[^[:alnum:]])$1(-fallback)?([^[:alnum:]-]|$)/\\1$2\\2\\3/g" "$from" >"$tmp" \
               && chmod 644 "$tmp" && mv -f "$tmp" "$to"; }; then
            rm -f "$tmp" 2>/dev/null
            log "migrate: could not write $to"
            return 1
        fi
    fi
    rm -f -- "$from" || return 1
    log "migrate: ${from#"$ROOT"} is now ${to#"$ROOT"}"
    printf '%s is now %s\n' "${from#"$ROOT"}" "${to#"$ROOT"}"
    kver=$(sed -nE "s/^[[:space:]]*ALL_kver=[\"']?([^\"']*)[\"']?[[:space:]]*$/\\1/p" "$to" | tail -n1)
    [[ $kver == /boot/* && ! -e $ROOT$kver ]] || return 0
    for d in "$MODULES_DIR"/*/; do
        [[ -f "${d}vmlinuz" && -r "${d}pkgbase" && $(<"${d}pkgbase") == "$2" ]] && rel=$d
    done
    [[ -n ${rel:-} ]] || return 0
    if ! cp -- "${rel}vmlinuz" "$ROOT$kver"; then
        log "migrate: could not copy the $2 kernel to $kver"
        return 1
    fi
    chmod 644 "$ROOT$kver"
}

# Whether this system's part of the menu has an entry $2 (its fallback entry counts
# with $3). That part is the top-level entry whose comment carries this machine's ID,
# as limine-entry-tool writes it, or, with no machine ID in it, the one named after
# TARGET_OS_NAME, as the installer writes it. Another system's entries never count.
menu_has_entry() {  # $1 = limine.conf, $2 = entry name, $3 = with-fallback|""
    local machine
    machine=$(cat -- "$ROOT/etc/machine-id" 2>/dev/null) || machine=""
    [[ $machine =~ ^[0-9a-f]{32}$ ]] || machine=""
    # Through the environment: awk -v would read the backslashes in the name.
    MENU_ID=$machine MENU_OS=$(limine_setting TARGET_OS_NAME) awk -v name="$2" -v fallback="$3" '
        BEGIN { id = ENVIRON["MENU_ID"]; os = ENVIRON["MENU_OS"] }
        function done() {
            if (found && (mine || id == "" || (!other && (os == "" || title == os)))) hit = 1
            found = 0; mine = 0; other = 0
        }
        /^\/[^\/]/ {
            done()
            title = $0
            sub(/^\/\+?/, "", title)
            sub(/[ \t\r]*$/, "", title)
        }
        tolower($0) ~ /^[ \t]*comment:.*machine-id=[0-9a-f]+/ {
            if (id != "" && index(tolower($0), "machine-id=" id)) mine = 1
            else other = 1
        }
        /^[ \t]*\/\// {
            line = $0
            sub(/^[ \t]*\/\//, "", line)
            sub(/[ \t\r]*$/, "", line)
            if (line == name || (fallback != "" && line == name "-fallback")) found = 1
        }
        END { done(); exit !hit }' "$1"
}

# The old package's entries the removal hooks left, removed by the tool those hooks
# run, which keeps to this system's part of the menu and takes the entries' files.
remove_old_entries() {  # $1 = old name
    local conf before after
    find_esp || return 0
    conf="$ESP/limine.conf"
    [[ -f $conf && ! -L $conf ]] || return 0
    menu_has_entry "$conf" "$1" with-fallback || return 0
    command -v limine-entry-tool >/dev/null 2>&1 || return 0
    before=$(cksum <"$conf")
    if ! limine-entry-tool --remove-all "$1" "$1-fallback" --quiet </dev/null >>"$LOG" 2>&1; then
        log "migrate: limine-entry-tool could not remove the entries of $1"
        return 1
    fi
    after=$(cksum <"$conf")
    [[ $before != "$after" ]] || return 0
    log "migrate: removed the boot menu entries of $1"
    printf 'Removed the boot menu entries of %s\n' "$1"
}

# Whether limine.conf names the file or directory $2, and not one whose name only
# starts the same way.
conf_names_file() {  # $1 = limine.conf, $2 = the path as the menu writes it
    local re
    [[ $2 == */ ]] && { grep -qF -- "$2" "$1"; return; }
    re=$(printf '%s' "$2" | sed 's/[][\\.*^$+?(){}|]/\\&/g')
    grep -qE -- "$re([^[:alnum:]_.-]|\$)" "$1"
}

# Boot files of the old package that no entry names any more: its boot image, the
# kernel and initramfs its entries carried, and the copies a preset made in /boot.
# Only where Limine starts the system: another boot loader's menu may still name them.
remove_old_boot_files() {  # $1 = old name
    local conf prefix machine f gone=0
    local -a files=()
    find_esp || return 0
    conf="$ESP/limine.conf"
    [[ -f $conf && ! -L $conf ]] || return 0
    machine=$(cat -- "$ROOT/etc/machine-id" 2>/dev/null) || machine=""
    [[ $machine =~ ^[0-9a-f]{32}$ ]] || machine=""
    prefix=$(limine_setting CUSTOM_UKI_NAME)
    [[ $prefix =~ ^[a-z0-9]+$ ]] || prefix=$machine
    [[ -n $prefix ]] && files+=("$ESP/EFI/Linux/$(uki_file_name "$prefix" "$1")" \
                                "$ESP/EFI/Linux/$(uki_file_name "$prefix" "$1-fallback")")
    [[ -n $machine ]] && files+=("$ESP/$machine/$1/")
    files+=("$ROOT/boot/vmlinuz-$1" "$ROOT/boot/initramfs-$1.img" "$ROOT/boot/initramfs-$1-fallback.img")
    for f in "${files[@]}"; do
        [[ -e $f && ! -L ${f%/} ]] || continue
        # Named by an entry, it belongs to another system on this partition.
        conf_names_file "$conf" "${f#"$ESP"}" && continue
        pacman -Qqo -- "${f#"$ROOT"}" >/dev/null 2>&1 && continue
        if rm -rf -- "$f"; then
            gone=1
            log "migrate: removed ${f#"$ROOT"}"
        else
            log "migrate: could not remove ${f#"$ROOT"}"
            return 1
        fi
    done
    (( gone )) && printf 'Removed the boot files of %s\n' "$1"
    return 0
}

# sbctl signs the files in its list again at every package change and fails on one
# that is gone, so the old package's files leave the list. Read from sbctl's own
# database: its JSON listing leaves out every file that no longer exists.
forget_old_signed_files() {  # $1 = old name
    local db f base gone=0
    command -v sbctl >/dev/null 2>&1 || return 0
    db=$(sbctl setup --print-config 2>/dev/null \
        | sed -nE 's/^[[:space:]]*files_db:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/p' | head -n1)
    [[ $db == /* ]] || db=/var/lib/sbctl/files.json
    db=$ROOT$db
    [[ -f $db && ! -L $db ]] || return 0
    while IFS= read -r f; do
        [[ $f == /* && ! -e $ROOT$f ]] || continue
        base=${f##*/}
        case $base in
            vmlinuz-*) names_kernel "$1" "${base#vmlinuz-}" ;;
            initramfs-*.img) base=${base#initramfs-}; names_kernel "$1" "${base%.img}" ;;
            *.efi) base=${base%.efi}; names_kernel "$1" "$base" || names_kernel "$1" "${base#*_}" ;;
            *) [[ $f == */"$1"/* ]] ;;
        esac || continue
        if sbctl remove-file "$f" </dev/null >>"$LOG" 2>&1; then
            gone=1
            log "migrate: sbctl no longer signs $f"
        else
            log "migrate: sbctl could not forget $f"
            return 1
        fi
    done < <(jq -r '[.. | objects | select(has("file")) | .file | strings] | unique[]' "$db" 2>/dev/null)
    (( gone )) && printf 'Secure Boot no longer signs the removed files of %s\n' "$1"
    return 0
}

# Another boot loader's menu names the kernel's files itself. GRUB's is made again; a
# systemd-boot entry, or an entry of a loader Mainstream does not know, is named here
# for the person to change, the last kind once.
migrate_other_loaders() {  # $1 = old name, $2 = new name
    local cfg="$ROOT/boot/grub/grub.cfg" d f found=0 note
    local -a dirs=()
    if [[ -f $cfg ]] && grep -qE "vmlinuz-$1([^[:alnum:]-]|$)" "$cfg"; then
        found=1
        if command -v grub-mkconfig >/dev/null 2>&1 \
                && grub-mkconfig -o "$cfg" </dev/null >>"$LOG" 2>&1 \
                && ! grep -qE "vmlinuz-$1([^[:alnum:]-]|$)" "$cfg"; then
            log "migrate: grub-mkconfig wrote the GRUB menu for $2"
            printf 'The GRUB menu was made again, so it starts %s\n' "$2"
        else
            log "migrate: the GRUB menu still starts $1"
            printf 'The GRUB menu still starts %s; run: sudo grub-mkconfig -o /boot/grub/grub.cfg\n' "$1"
            return 1
        fi
    fi
    find_esp && dirs+=("$ESP/loader/entries")
    for d in "$ROOT/boot/loader/entries" "$ROOT/efi/loader/entries" "$ROOT/boot/efi/loader/entries"; do
        is_one_of "$d" "${dirs[@]}" || dirs+=("$d")
    done
    for d in "${dirs[@]}"; do
        for f in "$d"/*.conf; do
            [[ -f $f ]] && grep -qE "vmlinuz-$1([^[:alnum:]-]|$)" "$f" || continue
            found=1
            printf 'The boot entry %s still starts %s; point it at vmlinuz-%s and initramfs-%s.img\n' \
                "${f#"$ROOT"}" "$1" "$2" "$2"
        done
    done
    (( found )) && return 0
    # Limine, GRUB and systemd-boot are known; any other loader started the old
    # package only if pacman removed it on this system.
    [[ -f ${ESP:-}/limine.conf || -f $cfg ]] && return 0
    note="$ROOT/var/lib/mainstream/kernel-rename-noted-$1"
    [[ ! -e $note ]] || return 0
    grep -qE "\] (removed|upgraded) $1 \(" "$ROOT/var/log/pacman.log" 2>/dev/null || return 0
    printf "If this computer's boot loader starts /boot/vmlinuz-%s, point it at /boot/vmlinuz-%s and /boot/initramfs-%s.img\n" \
        "$1" "$2" "$2"
    mkdir -p -- "${note%/*}" 2>/dev/null && : >"$note"
    return 0
}

# ── Subcommands ──────────────────────────────────────────────────────────────

cmd_install() {
    (( $# == 1 )) || die 2 "usage: install <kernel>"
    local kernel pkg
    kernel=$(kernel_name "$1")
    is_one_of "$kernel" "$STANDARD_KERNEL" "${MAINSTREAM_KERNELS[@]}" || \
        die 2 "not a kernel that can be installed here"

    require_installed_system
    require_limine_tools
    if is_one_of "$kernel" "$PERFORMANCE_KERNEL" "$EAC_KERNEL" && ! cpu_runs_performance_kernel; then
        die 5 "this processor cannot run $kernel, which needs AVX2 and the rest of x86-64-v3"
    fi
    if [[ $kernel == "$EAC_KERNEL" ]] && nvidia_driver_installed; then
        die 13 "$kernel loads only drivers signed for it, so the NVIDIA driver this computer uses would not load"
    fi
    require_esp_room
    pkg=$(repo_package "$kernel") || \
        die 11 "no repository offers $kernel and $kernel-headers yet"

    # The headers always come with the kernel: they are what lets DKMS drivers build
    # for it, and a later driver install must not find them missing.
    log "install: pacman -S --needed --noconfirm $pkg $pkg-headers"
    pacman -S --needed --noconfirm "$pkg" "$pkg-headers" </dev/null >>"$LOG" 2>&1 || \
        die 4 "$kernel could not be installed; see $LOG"
    pkg_installed "$pkg" || die 4 "$kernel is not installed after the transaction; see $LOG"

    if ! nvidia_modules_for_all_kernels; then
        die 7 "$kernel is installed, but the graphics driver could not be built for it; keep using the kernel you are on (see $LOG)"
    fi
    log "install: $pkg installed"
}

cmd_remove() {
    (( $# == 1 )) || die 2 "usage: remove <kernel>"
    local kernel pkg other others=0 was_next=0 parent="" fallback
    local -a pkgs
    kernel=$(kernel_name "$1")
    is_one_of "$kernel" "$STANDARD_KERNEL" "${MAINSTREAM_KERNELS[@]}" || \
        die 2 "not a kernel that can be removed here"

    require_installed_system
    require_limine_tools
    pkg=$(installed_package "$kernel") || die 8 "$kernel is not installed"
    [[ $(kernel_name "$(running_kernel)") != "$kernel" ]] || \
        die 8 "$kernel is the kernel running now; restart with another kernel first"
    while IFS= read -r other; do
        [[ -n $other && $other != "$pkg" ]] && others=$((others + 1))
    done < <(installed_kernels)
    (( others > 0 )) || die 8 "removing $kernel would leave this system with no kernel"
    # A T2 Mac's keyboard and trackpad run only on Mainstream's kernels, which
    # carry the T2 drivers (PCI 106b:1801/1802).
    if is_mainstream_kernel "$kernel" && lspci -n 2>/dev/null | grep -qE ' 106b:180[12]( |$)'; then
        others=0
        while IFS= read -r other; do
            is_mainstream_kernel "$other" && [[ $other != "$pkg" ]] && others=$((others + 1))
        done < <(installed_kernels)
        (( others > 0 )) || die 8 "removing $kernel would leave this Mac's keyboard and trackpad without a driver"
    fi

    if read_last_entry && entry_is_installed_kernel && [[ ${ENTRY##*/} == "$pkg" ]]; then
        was_next=1
        parent=${ENTRY%/*}
    fi

    pkgs=("$pkg")
    pkg_installed "$pkg-headers" && pkgs+=("$pkg-headers")
    log "remove: pacman -Rns --noconfirm ${pkgs[*]}"
    pacman -Rns --noconfirm "${pkgs[@]}" </dev/null >>"$LOG" 2>&1 || \
        die 4 "$kernel could not be removed; see $LOG"

    fallback=$(fallback_kernel "$pkg") || fallback=""
    if [[ -z $fallback ]]; then
        log "remove: no other kernel is installed, so the boot menu is left as it is"
    elif ! repoint_default_entry "$pkg" "$fallback"; then
        log "remove: could not point the boot menu's default entry at $fallback"
        printf 'mainstream-kernels: %s was removed, but the boot menu'"'"'s default entry could not be pointed at %s\n' \
            "$kernel" "$fallback" >&2
    fi
    # The menu would otherwise preselect an entry that is gone.
    if (( was_next )) && [[ -n $fallback ]]; then
        if write_last_entry "$parent/$fallback"; then
            log "remove: the boot menu starts $fallback next"
        else
            log "remove: could not point the boot menu at $fallback"
            printf 'mainstream-kernels: %s was removed, but the boot menu could not be pointed at %s\n' \
                "$kernel" "$fallback" >&2
        fi
    fi
    log "remove: $pkg removed"
}

cmd_next() {
    (( $# == 1 )) || die 2 "usage: next <kernel>"
    local kernel pkg="" target other have_module=0
    kernel=$(kernel_name "$1")
    is_one_of "$kernel" "$STANDARD_KERNEL" "${MAINSTREAM_KERNELS[@]}" || \
        die 2 "not a kernel that can be chosen here"

    require_installed_system
    # Its boot menu entry is named after the package as installed.
    pkg=$(installed_package "$kernel") && is_one_of "$pkg" $(installed_kernels) || \
        die 9 "$kernel is not installed"
    [[ -d $EFIVARS_DIR ]] || \
        die 9 "this computer does not start through UEFI, so the choice cannot be stored; choose the kernel in the boot menu"
    read_last_entry || \
        die 9 "the boot menu has not recorded the entry it started, so the choice cannot be stored; choose the kernel in the boot menu"
    [[ $ENTRY != */Snapshots/* ]] || \
        die 9 "the boot menu remembers a snapshot; restart into the installed system first"
    entry_is_installed_kernel || \
        die 9 "the boot menu remembers an entry that is not a kernel of this system; choose the kernel in the boot menu"

    # A kernel with no NVIDIA module on a machine whose other kernels have one would
    # start without graphics.
    if ! kernel_has_nvidia_module "$pkg"; then
        while IFS= read -r other; do
            [[ -n $other ]] && kernel_has_nvidia_module "$other" && have_module=1
        done < <(installed_kernels)
        (( ! have_module )) || \
            die 12 "the graphics driver is not built for $kernel; keep using the kernel you are on"
    fi

    target="${ENTRY%/*}/$pkg"
    if [[ $target == "$ENTRY" ]]; then
        log "next: the boot menu already starts $kernel next"
        return 0
    fi
    write_last_entry "$target" || die 1 "could not store the choice in the firmware"
    log "next: the boot menu starts \"$target\" next (was \"$ENTRY\")"
}

# migrate: run as root by mainstream-system's pacman hook once a kernel package
# changes. Quiet when nothing names an old package, and never fails the transaction:
# a busy lock leaves the work to the next run, or to the update holding it, which
# runs the same step after its package step.
cmd_migrate() {
    (( $# == 0 )) || die 2 "usage: migrate"
    # The Kernel page's own pacman runs this hook with pkexec's PKEXEC_UID kept,
    # while it holds the lock below, so that run and a direct pkexec call step aside.
    if [[ -n ${PKEXEC_UID:-} ]]; then
        log "migrate: started under pkexec, so this run is left to the next one"
        return 0
    fi
    detect_root_info
    [[ $ROOT_FSTYPE == overlay || $ROOT_SUBVOL =~ (^|/)(@|@?\.)snapshots/[0-9]+/snapshot$ ]] && return 0
    if ! try_lock 9 "$LOCK_FILE" || ! try_lock 8 "$SECURITY_LOCK" || ! try_lock 7 "$UPDATE_LOCK"; then
        log "migrate: another change or an update is running, so this run is left to it"
        return 0
    fi
    migrate_renamed_kernels || \
        printf 'mainstream-kernels: some boot settings still name an old kernel package; see %s\n' "$LOG"
    (( ${#BOOT_ORDER_MOVED[@]} )) && command -v limine-mkinitcpio >/dev/null 2>&1 || return 0
    # The boot tools sort the menu by BOOT_ORDER when they write a kernel's entry.
    limine-mkinitcpio "${BOOT_ORDER_MOVED[@]}" </dev/null >>"$LOG" 2>&1 || \
        printf 'mainstream-kernels: the boot menu keeps its old order until the next kernel update\n'
    return 0
}

try_lock() {  # $1 = file descriptor, $2 = lock file; fails when it is held
    { eval "exec $1>>\"\$2\""; } 2>/dev/null || return 1
    flock -n "$1" || return 1
    { enable -f /usr/lib/bash/fdflags fdflags && fdflags -s +cloexec "$1"; } 2>/dev/null || true
}

take_lock() {  # $1 = file descriptor, $2 = lock file, $3 = what holds it
    local fd=$1 file=$2
    # In braces: a redirection on a bare exec stays for the rest of the run, and every
    # reason printed after it would be lost.
    { eval "exec $fd>>\"\$file\""; } 2>/dev/null || die 1 "could not open lock file $file"
    flock -n "$fd" || die 10 "$3 is still running; try again when it has finished"
    # Held by this shell alone: a child that outlives it must not keep the lock.
    { enable -f /usr/lib/bash/fdflags fdflags && fdflags -s +cloexec "$fd"; } 2>/dev/null || true
}

main() {
    local verb=${1:-}
    (( $# )) && shift

    if [[ -z $ROOT && $EUID -ne 0 ]]; then
        die 1 "must be run as root (via pkexec)"
    fi

    refuse_symlinks "$LOG" "$LOCK_FILE" "$SECURITY_LOCK" "$UPDATE_LOCK"
    mkdir -p -m 755 -- "$LOG_DIR" "$LOCK_DIR" 2>/dev/null || true
    log "invoked: $verb $* (uid=${PKEXEC_UID:-$EUID})"

    if [[ $verb == migrate ]]; then
        cmd_migrate "$@"
        exit 0
    fi

    is_one_of "$verb" "${VERBS[@]}" || \
        die 2 "usage: mainstream-kernels $(IFS='|'; printf '%s' "${VERBS[*]}") <kernel>"

    # A snapshot keeps the package lock of the transaction it was taken in, so this
    # reason comes before the busy ones.
    require_installed_system

    take_lock 9 "$LOCK_FILE" "another kernel change"
    take_lock 8 "$SECURITY_LOCK" "a Secure Boot change"
    take_lock 7 "$UPDATE_LOCK" "a system update"
    [[ ! -e $PACMAN_LOCK ]] || \
        die 10 "another package change is still running; try again when it has finished"

    "cmd_$verb" "$@"
    exit 0
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
