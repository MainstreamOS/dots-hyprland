#!/usr/bin/expect -f
# limine-restore-auto
# Non-interactive wrapper for limine-snapper-sync --restore.
# Drives the interactive prompts, covering both the pre-1.31 text UI and
# the 1.31+ menu UI:
#   restore menu [r/l/c]          → r
#   mismatch menu [s/r/c]         → r  (restore anyway)
#   legacy confirm "Your input:"  → y
#   snapshot/backup description   → Enter (accept default) — reads from /dev/tty, requires expect
#   snapshot ID picker            → c  (not booted from a snapshot; bail out)
#   delete unused files [y/N]     → n
#   reboot [y/N]                  → n  (caller handles reboot)
#   close terminal [y/N]          → y
# SUDO_ASKPASS must be set in the calling environment when not already root.
# Exit code is propagated from the spawned process so the QML Process.onExited
# handler can distinguish success (0) from failure reliably; 124 = timed out
# waiting for output, 125 = a prompt kept rejecting our answer. After a successful
# restore: 90 = the restored system starts only with Secure Boot off, 91 = its boot
# loader could not be prepared.

log_user 1
set timeout 300
set answers 0

proc answer {text} {
    global answers
    if {[incr answers] > 25} { exit 125 }
    send -- $text
}

spawn sudo -A /usr/lib/limine/limine-snapper-sync --restore

# With a color terminal a prompt ends in a color reset sequence, so the patterns allow
# escape sequences between the prompt and the end of the output.
expect {
    -re {Choice \[r/l/c\]:(?:[ \t]|\e\[[0-9;?]*[A-Za-z])+$} { answer "r\r"; exp_continue }
    -re {Choice \[s/r/c\]:(?:[ \t]|\e\[[0-9;?]*[A-Za-z])+$} { answer "r\r"; exp_continue }
    -re {Your input:(?:[ \t]|\e\[[0-9;?]*[A-Za-z])+$} { answer "y\r"; exp_continue }
    -re {Enter snapshot description[^\n]*$}         { answer "\r";  exp_continue }
    -re {Description for backup subvolume[^\n]*:(?:\s|\e\[[0-9;?]*[A-Za-z])*$} { answer "\r";  exp_continue }
    -re {type \[ID\][^\n]*cancel[^\n]*(?:\n[^\n]*Choice:[^\n]*)?$} { answer "c\r"; exp_continue }
    -re {unused files\? \[y/N\]:(?:[ \t]|\e\[[0-9;?]*[A-Za-z])+$} { answer "n\r"; exp_continue }
    -re {[Rr]eboot[^\n]*\[y/N\][^\n]*$}             { answer "n\r"; exp_continue }
    -re {Close the terminal[^\n]*\[y/N\]:(?:[ \t]|\e\[[0-9;?]*[A-Za-z])+$} { answer "y\r"; exp_continue }
    timeout { exit 124 }
    eof
}

# Wait for the process to fully exit and capture its exit code.
# Without this, expect exits 0 on eof regardless of the child's status.
catch wait result
set exit_code [lindex $result 3]

# The restore leaves a changed boot menu with nothing enrolled or signed for it. On a
# machine with Secure Boot signing set up the helper carries that into the restored
# system. 90: it starts only with Secure Boot off. 91: it may not start at all.
set helper /usr/lib/mainstream/system-security
if {$exit_code == 0 && [file executable $helper]} {
    set timeout 900
    spawn sudo -A $helper sb-after-restore
    expect {
        timeout { exit 91 }
        eof
    }
    catch wait result
    switch -- [lindex $result 3] {
        0 - 3   { }
        5       { exit 90 }
        default { exit 91 }
    }
}
exit $exit_code
