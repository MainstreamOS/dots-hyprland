#!/usr/bin/env bash
# mainstream-hardware-quirks: applies the module options, boot options and services some
# hardware needs. Runs on first boot and every update, and changes a file only when its content
# differs.
#
# Usage: mainstream-hardware-quirks [--packages]
#   --packages  prints the packages this machine's quirks need and changes nothing, since the
#               engine itself runs inside pacman's transaction where it cannot install any.

set -euo pipefail

SYS_VENDOR="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
PRODUCT_NAME="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
CPU_VENDOR="$(awk '$1 == "vendor_id" {print $3; exit}' /proc/cpuinfo 2>/dev/null || true)"
CPU_MODEL="$(awk '$1 == "model" && $2 == ":" {print $3; exit}' /proc/cpuinfo 2>/dev/null || true)"
[[ "$CPU_MODEL" =~ ^[0-9]+$ ]] || CPU_MODEL=0

log() {
    printf 'mainstream-hardware-quirks: %s\n' "$1"
}

# A real system battery, not a mouse's or a UPS's.
battery_present() {
    local bat
    for bat in /sys/class/power_supply/*; do
        [[ -r "$bat/type" && "$(< "$bat/type")" == Battery ]] || continue
        [[ -r "$bat/present" && "$(< "$bat/present")" == 1 ]] || continue
        [[ -r "$bat/scope" && "$(< "$bat/scope")" == Device ]] && continue
        return 0
    done
    return 1
}

pci_has() {
    local dev id
    for dev in /sys/bus/pci/devices/*; do
        [[ -r "$dev/vendor" && -r "$dev/device" ]] || continue
        id="$(< "$dev/vendor"):$(< "$dev/device")"
        id="${id//0x/}"
        [[ " $* " == *" $id "* ]] && return 0
    done
    return 1
}

# lspci wakes a sleeping discrete GPU, so it runs at most once and only on Intel machines.
is_intel_ptl() {
    [[ "$CPU_VENDOR" == GenuineIntel ]] || return 1
    if [[ -z "${INTEL_PTL:-}" ]]; then
        INTEL_PTL=0
        if command -v lspci >/dev/null 2>&1; then
            grep -qiE '(vga|3d|display).*panther lake' <<<"$(lspci 2>/dev/null)" && INTEL_PTL=1
        elif [[ "$CPU_MODEL" == 204 ]]; then
            INTEL_PTL=1
        fi
    fi
    (( INTEL_PTL ))
}

is_apple() {
    [[ "$SYS_VENDOR" =~ ^Apple || "$PRODUCT_NAME" =~ MacBook ]]
}

is_intel_laptop() {
    [[ "$CPU_VENDOR" == GenuineIntel ]] && battery_present
}

# Intel hybrid cores from Alder Lake on, where intel-lpmd keeps light work off the P-cores.
is_intel_hybrid_laptop() {
    is_intel_laptop && [[ "$CPU_MODEL" =~ ^(151|154|170|172|183|186|189|191|204)$ ]]
}

# Macs get this driver through mac-config.sh, with its own kernel handling.
needs_broadcom_wl() {
    [[ ! "$SYS_VENDOR" =~ ^Apple ]] && pci_has 14e4:43a0 14e4:4331
}

# A package the repositories do not carry yet is left out, so the install never fails on it.
available() {
    pacman -Si "$1" >/dev/null 2>&1
}

# Headers for every installed kernel, custom ones included, or the module is missing whenever
# another one boots. A kernel whose headers no repository carries is named and left out.
dkms_packages() {
    local file headers=() seen=" "
    for file in /usr/lib/modules/*/pkgbase; do
        [[ -r "$file" ]] || continue
        local name="$(< "$file")-headers"
        [[ "$seen" == *" $name "* ]] && continue
        seen+="$name "
        if available "$name"; then
            headers+=("$name")
        else
            printf 'mainstream-hardware-quirks: no %s in the repositories\n' "$name" >&2
        fi
    done
    # No kernel could be read at all, so the stock one is the likeliest.
    [[ "$seen" == " " ]] && headers=(linux-headers)
    printf '%s\n' "$1" dkms "${headers[@]}"
}

# Returns 0 when it had to write the file.
write_if_changed() {
    local file="$1" content="$2"
    [[ -f "$file" && "$(< "$file")" == "$content" ]] && return 1
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$content" > "$file"
}

# Switched on once; a service the user turns off afterwards stays off.
enable_service() {
    local stamp="/var/lib/mainstream/hardware-quirks/$1.enabled"
    command -v systemctl >/dev/null 2>&1 || return 0
    [[ -e "$stamp" ]] && return 0
    systemctl list-unit-files "$1" >/dev/null 2>&1 || return 0
    mkdir -p "${stamp%/*}" && : > "$stamp"
    systemctl is-enabled "$1" >/dev/null 2>&1 && return 0
    log "Enabling $1..."
    systemctl enable "$1" 2>/dev/null || true
    [[ -d /run/systemd/system ]] && systemctl start "$1" 2>/dev/null || true
}

print_packages() {
    local packages=()
    is_intel_laptop && (( ${CPU_MODEL:-0} >= 42 )) && packages+=(thermald)
    is_intel_hybrid_laptop && packages+=(intel-lpmd)
    needs_broadcom_wl && mapfile -t -O "${#packages[@]}" packages < <(dkms_packages broadcom-wl-dkms)
    (( ${#packages[@]} )) && printf '%s\n' "${packages[@]}"
    return 0
}

# ── Intel Panther Lake: FRED ───────────────────────────────────────────────
# Flexible Return and Event Delivery replaces the old interrupt path and is off unless asked for.
apply_intel_ptl_fred() {
    is_intel_ptl || return 0
    [[ -f /etc/default/limine || -f /etc/limine-entry-tool.conf ]] || return 0
    if write_if_changed /etc/limine-entry-tool.d/mainstream-intel-ptl-fred.conf 'KERNEL_CMDLINE[default]+=" fred=on"'; then
        log "Turned on FRED for Intel Panther Lake."
        NEED_MKINITCPIO=1
    fi
}

# ── Intel BE200 / BE211 Wi-Fi 7 ────────────────────────────────────────────
# Temporary: iwlwifi's EHT receive path drops these cards to the lowest rate on Wi-Fi 7 access
# points, so they stay on Wi-Fi 6 until the driver is fixed.
apply_intel_wifi7_eht_quirk() {
    pci_has 8086:e440 8086:272b || return 0
    if write_if_changed /etc/modprobe.d/mainstream-iwlwifi-eht.conf 'options iwlwifi disable_11be=Y'; then
        log "Kept the Intel BE200 / BE211 Wi-Fi on Wi-Fi 6."
    fi
}

# ── Apple MacBook, through the shared mac-config.sh ────────────────────────
apply_apple_quirks() {
    is_apple || return 0
    log "Apple hardware detected. Applying the Mac configuration..."
    local mac_lib="" path script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    for path in /usr/local/lib/mac-config.sh "$script_dir/../../lib/mac-config.sh"
    do
        if [[ -f "$path" ]]; then
            mac_lib="$path"
            break
        fi
    done
    if [[ -n "$mac_lib" ]]; then
        # shellcheck source=/dev/null
        source "$mac_lib"
        mac_apply_autoconfig || true
    else
        log "Warning: mac-config.sh library not found, skipping mac autoconfig."
    fi
}

# ── Intel laptop power services ────────────────────────────────────────────
# thermald from Sandy Bridge on, and intel-lpmd on hybrid cores. --packages names both.
apply_intel_power_services() {
    is_intel_laptop || return 0
    (( ${CPU_MODEL:-0} >= 42 )) && enable_service thermald.service
    is_intel_hybrid_laptop && enable_service intel_lpmd.service
    return 0
}

main() {
    if [[ "${1:-}" == --packages ]]; then
        print_packages
        return 0
    fi
    NEED_MKINITCPIO=0

    apply_intel_ptl_fred
    apply_intel_wifi7_eht_quirk
    apply_apple_quirks
    apply_intel_power_services

    # limine-mkinitcpio also renews the boot entries' hashes; a plain mkinitcpio -P leaves
    # Limine refusing the rebuilt images. The update defers it to the next kernel update.
    if (( NEED_MKINITCPIO )) && [[ ${EUID:-$(id -u)} -eq 0 && -z "${MAINSTREAM_QUIRKS_DEFER_REBUILD:-}" ]]; then
        log "Hardware quirks changed the initramfs or kernel options. Rebuilding the boot images..."
        if command -v limine-mkinitcpio >/dev/null 2>&1; then
            limine-mkinitcpio || true
        elif command -v mkinitcpio >/dev/null 2>&1; then
            mkinitcpio -P || true
        fi
    fi
}

main "$@"
