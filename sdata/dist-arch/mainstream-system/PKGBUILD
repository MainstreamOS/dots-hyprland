# Maintainer: mainstreamos <https://github.com/MainstreamOS>
groups=(mainstream)
pkgname=mainstream-system
pkgver=1.0
pkgrel=13
pkgdesc='Mainstream OS core system machinery — plugin rebuild, system scripts, mainstream-repair'
arch=(x86_64 aarch64)
license=(None)
depends=(
  git
  make
  gcc
  pkgconf
  expect
  python-gobject
  xdg-desktop-portal
  cups
  ipp-usb
  libdrm
)
options=(!debug)
install=mainstream-system.install
source=(
  hyprbars-rebuild.sh
  hyprbars-status-notify.sh
  hyprbars-rebuild.service
  hyprbars-rebuild.timer
  95-hyprbars-rebuild.hook
  scrolloverview-rebuild.sh
  scrolloverview-status-notify.sh
  scrolloverview-rebuild.service
  scrolloverview-rebuild.timer
  95-scrolloverview-rebuild.hook
  limine-restore-auto
  limine-bios-sync
  61-limine-bios.hook
  mainstream.preset
  hyprbars.conf
  scrolloverview.conf
  mainstream-repair
  wallpaper-portal
  mainstream.portal
  org.freedesktop.impl.portal.desktop.mainstream.service
  mainstream-printer-setup
  mainstream-printer-setup.service
  76-mainstream-printer-setup.rules
  10-mainstream-auto-queue.conf
  49-mainstream-printing.rules
  96-cups-testpage-pdf.hook
  luks-keyfile-fix
  mainstream-luks-keyfile.service
  mainstream-luks-keyfile.timer
  vmwgfx-close.c
  mainstream-vmwgfx.sh
  vmwgfx-greeter-setup
  mainstream-vmwgfx-greeter.service
)
sha256sums=(
  SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP
  SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP
  SKIP SKIP SKIP SKIP
)

build() {
  gcc $CFLAGS -shared -fPIC $(pkg-config --cflags libdrm) \
      -o libmainstream-vmwgfx-close.so "$srcdir/vmwgfx-close.c" $LDFLAGS $(pkg-config --libs libdrm)
}

package() {
  install -Dm755 "$srcdir/hyprbars-rebuild.sh"            "$pkgdir/usr/lib/mainstream/hyprbars/rebuild.sh"
  install -Dm755 "$srcdir/scrolloverview-rebuild.sh"      "$pkgdir/usr/lib/mainstream/scrolloverview/rebuild.sh"
  install -Dm755 "$srcdir/hyprbars-status-notify.sh"      "$pkgdir/usr/bin/hyprbars-status-notify"
  install -Dm755 "$srcdir/scrolloverview-status-notify.sh" "$pkgdir/usr/bin/scrolloverview-status-notify"
  install -Dm755 "$srcdir/limine-restore-auto"           "$pkgdir/usr/bin/limine-restore-auto"
  install -Dm755 "$srcdir/limine-bios-sync"              "$pkgdir/usr/bin/limine-bios-sync"
  install -Dm755 "$srcdir/mainstream-repair"            "$pkgdir/usr/bin/mainstream-repair"
  install -Dm644 "$srcdir/hyprbars-rebuild.service"      "$pkgdir/usr/lib/systemd/system/hyprbars-rebuild.service"
  install -Dm644 "$srcdir/hyprbars-rebuild.timer"        "$pkgdir/usr/lib/systemd/system/hyprbars-rebuild.timer"
  install -Dm644 "$srcdir/scrolloverview-rebuild.service" "$pkgdir/usr/lib/systemd/system/scrolloverview-rebuild.service"
  install -Dm644 "$srcdir/scrolloverview-rebuild.timer"  "$pkgdir/usr/lib/systemd/system/scrolloverview-rebuild.timer"
  install -Dm644 "$srcdir/95-hyprbars-rebuild.hook"      "$pkgdir/usr/share/libalpm/hooks/95-hyprbars-rebuild.hook"
  install -Dm644 "$srcdir/95-scrolloverview-rebuild.hook" "$pkgdir/usr/share/libalpm/hooks/95-scrolloverview-rebuild.hook"
  install -Dm644 "$srcdir/61-limine-bios.hook"           "$pkgdir/usr/share/libalpm/hooks/61-limine-bios.hook"
  install -Dm644 "$srcdir/mainstream.preset"             "$pkgdir/usr/lib/systemd/system-preset/80-mainstream.preset"
  install -Dm644 "$srcdir/hyprbars.conf"                 "$pkgdir/usr/share/mainstream/hyprbars.conf"
  install -Dm644 "$srcdir/scrolloverview.conf"           "$pkgdir/usr/share/mainstream/scrolloverview.conf"
  install -Dm755 "$srcdir/wallpaper-portal"              "$pkgdir/usr/lib/mainstream/wallpaper-portal"
  install -Dm644 "$srcdir/mainstream.portal"             "$pkgdir/usr/share/xdg-desktop-portal/portals/mainstream.portal"
  install -Dm644 "$srcdir/org.freedesktop.impl.portal.desktop.mainstream.service" \
      "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.mainstream.service"

  install -Dm755 "$srcdir/mainstream-printer-setup"      "$pkgdir/usr/bin/mainstream-printer-setup"
  install -Dm644 "$srcdir/mainstream-printer-setup.service" \
      "$pkgdir/usr/lib/systemd/system/mainstream-printer-setup.service"
  install -Dm644 "$srcdir/76-mainstream-printer-setup.rules" \
      "$pkgdir/usr/lib/udev/rules.d/76-mainstream-printer-setup.rules"
  install -Dm644 "$srcdir/10-mainstream-auto-queue.conf" \
      "$pkgdir/usr/lib/systemd/system/ipp-usb.service.d/10-mainstream-auto-queue.conf"
  install -Dm644 "$srcdir/49-mainstream-printing.rules" \
      "$pkgdir/usr/share/polkit-1/rules.d/49-mainstream-printing.rules"
  install -Dm644 "$srcdir/96-cups-testpage-pdf.hook" \
      "$pkgdir/usr/share/libalpm/hooks/96-cups-testpage-pdf.hook"

  install -Dm755 "$srcdir/luks-keyfile-fix"              "$pkgdir/usr/lib/mainstream/luks-keyfile-fix"
  install -Dm644 "$srcdir/mainstream-luks-keyfile.service" \
      "$pkgdir/usr/lib/systemd/system/mainstream-luks-keyfile.service"
  install -Dm644 "$srcdir/mainstream-luks-keyfile.timer" \
      "$pkgdir/usr/lib/systemd/system/mainstream-luks-keyfile.timer"

  install -Dm755 "$srcdir/libmainstream-vmwgfx-close.so" "$pkgdir/usr/lib/mainstream/libmainstream-vmwgfx-close.so"
  install -Dm644 "$srcdir/mainstream-vmwgfx.sh"          "$pkgdir/etc/profile.d/mainstream-vmwgfx.sh"
  install -Dm755 "$srcdir/vmwgfx-greeter-setup"          "$pkgdir/usr/lib/mainstream/vmwgfx/greeter-setup"
  install -Dm644 "$srcdir/mainstream-vmwgfx-greeter.service" \
      "$pkgdir/usr/lib/systemd/system/mainstream-vmwgfx-greeter.service"
}
