#!/usr/bin/env bash
# NetworkManager dispatcher hook for Settings > Sharing. Samba and wsdd are
# never enabled, only started while a network the user trusted for sharing is
# up, so this is what brings them back after a reboot or a reconnect, and
# what stops them when the last trusted network goes away. A trusted network
# is one the helper, /usr/lib/mainstream/file-sharing, recorded as trusted and
# whose profile still sits in the MainstreamHome firewall zone.
#
# NetworkManager runs it as root with the interface and the action as
# arguments, and CONNECTION_UUID in the environment. It must stay owned by
# root and writable by nobody else, or NetworkManager skips it.

PATH=/usr/bin
export LC_ALL=C
umask 022
. /usr/lib/mainstream/sharing-common.sh

action=${2:-}
conn=${CONNECTION_UUID:-}

case $action in up|down) ;; *) exit 0 ;; esac

# Samba that somebody set up with their own smb.conf, or one reached through
# a symlink, is theirs to run. Only a regular file is read, so something else
# put in its place, like a FIFO, cannot hold up NetworkManager's other hooks.
[[ $(config_kind) == managed ]] || exit 0

# Settings > Sharing holds this lock while it changes the state or a network's
# zone, so what is read below is what it left, not what it is about to change.
# A start queued here before it stops the services is replaced by that stop.
# An enable holds the lock through its download, so the wait is short, and
# past it the hook carries on as it would have without the lock.
{ open_lock && flock -w 10 9; } 2>/dev/null

# Samba listens on every interface and lets in every private address; only
# the firewall keeps it to trusted networks, so without one it stays off. At
# boot a trusted wired network can come up while firewalld is still loading:
# systemd counts it as started as soon as it runs, and until its rules are in
# place firewall-cmd says it is not running. That is waited out, briefly.
firewall_up() {
    local end=$((SECONDS + 15))
    case $(systemctl show -P ActiveState firewalld.service 2>/dev/null) in
        active|reloading) ;;
        *) return 1 ;;
    esac
    until timeout 5 firewall-cmd --state >/dev/null 2>&1; do
        (( SECONDS < end )) || return 1
        sleep 1
    done
}

# wsdd reads -i only when it starts, so a changed list restarts it.
sync_wsdd() {  # $1 = a connection to leave out, or nothing; $2 = start, or try
    local changed=1
    if ! wsdd_confined; then
        systemctl stop --no-block wsdd.service 2>/dev/null
        return 0
    fi
    write_wsdd_env "$1" && changed=0
    if [[ ! -s $WSDD_ENV ]]; then
        systemctl stop --no-block wsdd.service 2>/dev/null
    elif (( changed == 0 )); then
        if [[ $2 == start ]]; then
            systemctl restart --no-block wsdd.service 2>/dev/null
        else
            systemctl try-restart --no-block wsdd.service 2>/dev/null
        fi
    elif [[ $2 == start ]]; then
        systemctl start --no-block wsdd.service 2>/dev/null
    fi
}

case $action in
    up)
        [[ -n $conn ]] || exit 0
        [[ $(read_state) == on ]] || exit 0
        is_home "$conn" || exit 0
        firewall_up || exit 0
        # SMB that arrived through an IPsec VPN without an interface of its
        # own is dropped by this table; see guard_ipsec().
        guard_ipsec 2>/dev/null || exit 0
        # One at a time, so a wsdd removed on its own does not keep Samba
        # from starting. --no-block, because hooks run one after another and
        # the next one should not wait on smbd.
        systemctl start --no-block smb.service 2>/dev/null
        sync_wsdd "" start
        ;;
    down)
        systemctl -q is-active "${SERVICES[@]}" 2>/dev/null || exit 0
        if home_up "$conn"; then
            sync_wsdd "$conn" try
            exit 0
        fi
        systemctl stop --no-block "${SERVICES[@]}" 2>/dev/null
        rm -f "$WSDD_ENV"
        unguard_ipsec 2>/dev/null
        ;;
esac
exit 0
