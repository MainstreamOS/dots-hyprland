#!/usr/bin/env bash
# NetworkManager dispatcher hook for Settings > Sharing. Samba and wsdd are
# never enabled, only started while a network the user trusted for sharing is
# up, so this is what brings them back after a reboot or a reconnect, and
# what stops them when the last trusted network goes away. A trusted network
# is one the helper, /usr/lib/mainstream/file-sharing, recorded as trusted and
# whose profile still sits in the MainstreamHome firewall zone.
#
# NetworkManager runs it as root with the interface and the action as
# arguments, and CONNECTION_UUID in the environment. It must stay owned by
# root and writable by nobody else, or NetworkManager skips it.

PATH=/usr/bin
export LC_ALL=C
umask 022

ZONE=MainstreamHome
STATE=/var/lib/mainstream/sharing/state
TRUSTED_DIR=/var/lib/mainstream/sharing/trusted
SAMBA_ETC=/etc/samba
SMB_CONF=$SAMBA_ETC/smb.conf
MARKER='# Managed by Mainstream Settings > Sharing'
SERVICES=(smb.service wsdd.service)
LOCK=/run/lock/mainstream-file-sharing.lock
WSDD_ENV=/run/mainstream/sharing/wsdd.env
IPSEC_GUARD=/usr/lib/mainstream/sharing-ipsec.nft
IPSEC_TABLE=mainstream_sharing

action=${2:-}
conn=${CONNECTION_UUID:-}

case $action in up|down) ;; *) exit 0 ;; esac

# Samba that somebody set up with their own smb.conf, or one reached through
# a symlink, is theirs to run. Only a regular file is read, so something else
# put in its place, like a FIFO, cannot hold up NetworkManager's other hooks.
first=""
[[ ! -L $SAMBA_ETC && ! -L $SMB_CONF && -f $SMB_CONF ]] && IFS= read -r first <"$SMB_CONF"
[[ $first == "$MARKER" ]] || exit 0

# Settings > Sharing holds this lock while it changes the state or a network's
# zone, so what is read below is what it left, not what it is about to change.
# A start queued here before it stops the services is replaced by that stop.
# An enable holds the lock through its download, so the wait is short, and
# past it the hook carries on as it would have without the lock.
{ exec 9>"$LOCK" && flock -w 10 9; } 2>/dev/null

zone_of() {
    nmcli -g connection.zone connection show uuid "$1" 2>/dev/null
}

# The helper's eligible(): a system profile for a wired network or for Wi-Fi
# that takes a password, joined rather than served.
eligible() {
    local type mode key perms
    perms=$(nmcli -g connection.permissions connection show uuid "$1" 2>/dev/null) || return 1
    [[ -z $perms ]] || return 1
    type=$(nmcli -g connection.type connection show uuid "$1" 2>/dev/null) || return 1
    case $type in
        802-3-ethernet) return 0 ;;
        802-11-wireless) ;;
        *) return 1 ;;
    esac
    mode=$(nmcli -g 802-11-wireless.mode connection show uuid "$1" 2>/dev/null) || return 1
    case $mode in ''|infrastructure) ;; *) return 1 ;; esac
    key=$(nmcli -g 802-11-wireless-security.key-mgmt connection show uuid "$1" 2>/dev/null) || key=""
    case $key in ''|none|owe) return 1 ;; esac
    return 0
}

# The helper's is_home(). Any account can put a profile of its own in the
# zone without a password, so the zone alone never makes a network trusted:
# the helper's record of the trust has to be there too, and the profile has to
# still pass the checks the helper made before it trusted it.
is_home() {
    local rec
    [[ $1 =~ ^[0-9a-fA-F-]{36}$ ]] || return 1
    rec=$TRUSTED_DIR/${1,,}
    [[ -f $rec && ! -L $rec ]] || return 1
    [[ $(zone_of "$1") == "$ZONE" ]] || return 1
    eligible "$1"
}

# True while a connection other than $1 is up and trusted. The one going down
# is left out, since NetworkManager can still list it as active at this point.
other_home_up() {
    local u uuids=()
    mapfile -t uuids < <(nmcli -g UUID connection show --active 2>/dev/null)
    for u in "${uuids[@]}"; do
        [[ -n $u && $u != "$1" ]] && is_home "$u" && return 0
    done
    return 1
}

# wsdd answers on every interface unless it is given some with -i, so it runs
# only with the interfaces of the trusted networks that are up, written where
# the drop-in wsdd.service.d/mainstream-sharing.conf reads them. The helper,
# /usr/lib/mainstream/file-sharing, does the same when it changes something.
home_devices() {  # $1 = a connection to leave out, or nothing
    local u d uuids=() devs=()
    mapfile -t uuids < <(nmcli -g UUID connection show --active 2>/dev/null)
    for u in "${uuids[@]}"; do
        [[ -n $u && $u != "${1:-}" ]] && is_home "$u" || continue
        mapfile -t devs < <(nmcli -g GENERAL.DEVICES connection show uuid "$u" 2>/dev/null | tr ',' '\n')
        for d in "${devs[@]}"; do
            [[ $d =~ ^[A-Za-z0-9_.-]{1,15}$ ]] && printf '%s\n' "$d"
        done
    done | sort -u
}

# Returns 0 when the list changed. With no interface the file goes, and wsdd
# must not run.
write_wsdd_env() {  # $1 = a connection to leave out, or nothing
    local devs=() d params="" want="" have="" tmp
    mapfile -t devs < <(home_devices "${1:-}")
    for d in "${devs[@]}"; do params+="${params:+ }-i $d"; done
    [[ -n $params ]] && want="WSDD_PARAMS=\"$params\""
    [[ -f $WSDD_ENV ]] && have=$(<"$WSDD_ENV")
    [[ $want == "$have" ]] && return 1
    if [[ -z $want ]]; then
        rm -f "$WSDD_ENV"
        return 0
    fi
    mkdir -p "${WSDD_ENV%/*}" && tmp=$(mktemp "$WSDD_ENV.XXXXXX") || return 1
    if printf '%s\n' "$want" >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$WSDD_ENV"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

wsdd_confined() {
    local cmd files re='\$\{?WSDD_PARAMS([^A-Za-z0-9_]|$)'
    cmd=$(systemctl show -P ExecStart wsdd.service 2>/dev/null) || return 1
    files=$(systemctl show -P EnvironmentFiles wsdd.service 2>/dev/null) || return 1
    [[ $cmd =~ $re && $files == *"$WSDD_ENV"* ]]
}

# Samba listens on every interface and lets in every private address; only
# the firewall keeps it to trusted networks, so without one it stays off. At
# boot a trusted wired network can come up while firewalld is still loading:
# systemd counts it as started as soon as it runs, and until its rules are in
# place firewall-cmd says it is not running. That is waited out, briefly.
firewall_up() {
    local end=$((SECONDS + 15))
    case $(systemctl show -P ActiveState firewalld.service 2>/dev/null) in
        active|reloading) ;;
        *) return 1 ;;
    esac
    until timeout 5 firewall-cmd --state >/dev/null 2>&1; do
        (( SECONDS < end )) || return 1
        sleep 1
    done
}

# wsdd reads -i only when it starts, so a changed list restarts it.
sync_wsdd() {  # $1 = a connection to leave out, or nothing; $2 = start, or try
    local changed=1
    if ! wsdd_confined; then
        systemctl stop --no-block wsdd.service 2>/dev/null
        return 0
    fi
    write_wsdd_env "$1" && changed=0
    if [[ ! -s $WSDD_ENV ]]; then
        systemctl stop --no-block wsdd.service 2>/dev/null
    elif (( changed == 0 )); then
        if [[ $2 == start ]]; then
            systemctl restart --no-block wsdd.service 2>/dev/null
        else
            systemctl try-restart --no-block wsdd.service 2>/dev/null
        fi
    elif [[ $2 == start ]]; then
        systemctl start --no-block wsdd.service 2>/dev/null
    fi
}

case $action in
    up)
        [[ -n $conn ]] || exit 0
        state=""
        [[ -f $STATE ]] && IFS= read -r state <"$STATE"
        [[ $state == on ]] || exit 0
        is_home "$conn" || exit 0
        firewall_up || exit 0
        # SMB that arrived through an IPsec VPN without an interface of its
        # own is dropped by this table; see the helper's guard_ipsec().
        nft -f "$IPSEC_GUARD" 2>/dev/null || exit 0
        # One at a time, so a wsdd removed on its own does not keep Samba
        # from starting. --no-block, because hooks run one after another and
        # the next one should not wait on smbd.
        systemctl start --no-block smb.service 2>/dev/null
        sync_wsdd "" start
        ;;
    down)
        systemctl -q is-active "${SERVICES[@]}" 2>/dev/null || exit 0
        if other_home_up "$conn"; then
            sync_wsdd "$conn" try
            exit 0
        fi
        systemctl stop --no-block "${SERVICES[@]}" 2>/dev/null
        rm -f "$WSDD_ENV"
        if nft list table inet "$IPSEC_TABLE" >/dev/null 2>&1; then
            nft delete table inet "$IPSEC_TABLE" 2>/dev/null
        fi
        ;;
esac
exit 0
