_fix_plugin_configs() {
    for c in hyprbars scrolloverview; do
        etc="/etc/$c.conf"
        tmpl="/usr/share/mainstream/$c.conf"
        [ -e "$etc" ] || { [ -r "$tmpl" ] && install -Dm644 "$tmpl" "$etc"; }
        if [ -f "$etc" ]; then
            up=$(echo "$c" | tr '[:lower:]' '[:upper:]')
            sed -i "s/^\\(${up}_REF=\\)/#\\1/" "$etc" 2>/dev/null || true
        fi
    done
}

# Bump when an upstream plugin fix needs to reach machines that already build
# the plugin successfully.
#
# The rebuild scripts try their cached last-good ref FIRST and stop at the first
# ref that builds, so once a machine has a working commit it never looks at the
# branch again — a new upstream fix stays invisible until Hyprland changes
# enough to break the cached commit. Dropping the cache makes the next run fall
# through to the branch and pick the fix up.
#
# The serial is what keeps that to once. A machine records the serial it has
# acted on; only a bump refreshes, so an ordinary upgrade still uses the cache
# and finishes in seconds.
_PLUGIN_REFRESH_SERIAL=1

_refresh_plugin_refs() {
    marker=/var/lib/mainstream/plugin-refresh-serial
    cur=""
    [ -r "$marker" ] && cur=$(cat "$marker" 2>/dev/null)
    [ "$cur" = "$_PLUGIN_REFRESH_SERIAL" ] && return 0

    mkdir -p /var/lib/mainstream

    # No marker means this machine predates the mechanism, and there is no way
    # to tell whether its cached ref is behind. Record where it stands and act
    # only from the next bump — refreshing everyone the first time this ships
    # would rebuild the fleet for nothing.
    if [ -z "$cur" ]; then
        printf '%s\n' "$_PLUGIN_REFRESH_SERIAL" > "$marker"
        return 0
    fi

    dropped=0
    for p in hyprbars scrolloverview; do
        if [ -f "/var/cache/$p/last-good-ref" ]; then
            rm -f "/var/cache/$p/last-good-ref"
            dropped=1
        fi
    done
    printf '%s\n' "$_PLUGIN_REFRESH_SERIAL" > "$marker"

    # Nothing was cached, so nothing was stale — a fresh install still has the
    # plugin the ISO baked in, and rebuilding it would cost minutes to land in
    # the same place.
    [ "$dropped" = 1 ] || return 0

    if [ -d /run/systemd/system ]; then
        systemctl start --no-block hyprbars-rebuild.service scrolloverview-rebuild.service 2>/dev/null || true
    fi
}

_limine_esp() {
    esp=$(bash -c '. /usr/lib/limine/limine-common-functions >/dev/null 2>&1 \
        && load_config >/dev/null 2>&1 && printf %s "$ESP_PATH"' 2>/dev/null) || return 1
    [ -n "$esp" ] && [ -f "$esp/limine.conf" ] || return 1
    printf '%s\n' "$esp"
}

# limine-mkinitcpio builds and pins the UKI; a preset that writes it too lets a
# plain mkinitcpio -P replace the image behind its pin.
_drop_preset_uki() {
    for p in /etc/mkinitcpio.d/*.preset; do
        [ -f "$p" ] || continue
        grep -q '^default_uki=.*/EFI/Linux/mainstream_' "$p" || continue
        sed -i '\|^default_uki=.*/EFI/Linux/mainstream_|d' "$p"
    done
}

# Limine asks before starting an image that does not match its pin, instead of
# halting. An owner's own hash_mismatch_panic line is kept.
_limine_hash_prompt() {
    esp=$(_limine_esp) || return 0
    conf=$esp/limine.conf
    grep -qi '^[[:space:]]*hash_mismatch_panic:' "$conf" && return 0
    mkdir -p /run/lock
    (
        flock -w 60 9 || exit 0
        grep -qi '^[[:space:]]*hash_mismatch_panic:' "$conf" && exit 0
        # The same reset and enroll limine-entry-tool runs around its own saves.
        if ! command -v limine-reset-enroll >/dev/null 2>&1 \
            || limine-reset-enroll >/dev/null 2>&1; then
            tmp=$conf.mainstream-new
            if { echo 'hash_mismatch_panic: no'; cat "$conf"; } >"$tmp" 2>/dev/null \
                && tail -n +2 "$tmp" | cmp -s - "$conf" \
                && sync -f "$tmp" && mv -f "$tmp" "$conf"; then
                sync -f "$conf"
            else
                rm -f "$tmp"
                echo "warning: could not add hash_mismatch_panic: no to $conf; the EFI partition may be full."
            fi
        fi
        if command -v limine-enroll-config >/dev/null 2>&1; then
            limine-enroll-config >/dev/null 2>&1 \
                || echo "warning: limine-enroll-config failed; run it again before restarting."
        fi
    ) 9>/run/lock/boot-partition.lock
}

# Snapshot entries copy kernels onto the EFI partition up to LIMIT_USAGE_PERCENT;
# about 32 MiB stays free for the next boot image. Only ever lowered.
_esp_snapshot_room() {
    [ -f /etc/limine-snapper-sync.conf ] || return 0
    esp=$(_limine_esp) || return 0
    mib=$(stat -f -c '%b %S' "$esp" 2>/dev/null | awk '{ printf "%d", $1 * $2 / 1048576 }')
    case $mib in ''|*[!0-9]*) return 0 ;; esac
    [ "$mib" -gt 0 ] || return 0
    limit=$((100 - (3200 + mib - 1) / mib))
    [ "$limit" -le 90 ] || limit=90
    [ "$limit" -ge 1 ] || limit=1
    found=0 lowered=0
    for f in /etc/limine-snapper-sync.conf /etc/default/limine; do
        grep -qE '^[[:space:]]*LIMIT_USAGE_PERCENT[[:space:]]*=' "$f" 2>/dev/null || continue
        found=1
        tmp=$(mktemp) || continue
        awk -v max="$limit" '
            match($0, /^[ \t]*LIMIT_USAGE_PERCENT[ \t]*=/) {
                v = substr($0, RLENGTH + 1); gsub(/^[ \t"]+|[ \t"]+$/, "", v)
                if (v ~ /^[0-9]+([.][0-9]*)?$/ && v + 0 > max + 0) $0 = "LIMIT_USAGE_PERCENT=" max
            }
            { print }' "$f" >"$tmp" \
            && ! cmp -s "$tmp" "$f" && cat "$tmp" >"$f" && lowered=1
        rm -f "$tmp"
    done
    # Unset, limine-snapper-sync uses 85.
    if [ "$found" = 0 ] && [ "$limit" -lt 85 ]; then
        [ -z "$(tail -c 1 /etc/limine-snapper-sync.conf)" ] || echo >>/etc/limine-snapper-sync.conf
        echo "LIMIT_USAGE_PERCENT=$limit" >>/etc/limine-snapper-sync.conf && lowered=1
    fi
    [ "$lowered" = 0 ] || echo "Snapshot boot entries now stop at $limit% of the EFI partition, leaving room for the next boot image."
}

_migrate() {  # $1 = the version upgraded from, or nothing on an install
    rm -f /etc/pacman.d/hooks/95-hyprbars-rebuild.hook \
          /etc/pacman.d/hooks/95-scrolloverview-rebuild.hook
    rm -rf /usr/local/lib/hyprbars /usr/local/lib/scrolloverview
    rm -f /usr/local/bin/limine-restore-auto
    ln -sf /usr/bin/limine-restore-auto /usr/local/bin/limine-restore-auto
    for n in hyprbars scrolloverview; do
        if [ -f "/usr/local/bin/$n-status-notify" ] && [ ! -L "/usr/local/bin/$n-status-notify" ]; then
            rm -f "/usr/local/bin/$n-status-notify"
        fi
        [ -e "/usr/local/bin/$n-status-notify" ] || ln -sf "/usr/bin/$n-status-notify" "/usr/local/bin/$n-status-notify"
    done
    _fix_plugin_configs
    _refresh_plugin_refs
    _drop_preset_uki
    _limine_hash_prompt
    systemctl daemon-reload 2>/dev/null || true
    # The printer queue maker arrives as a udev rule, which only reaches a
    # running system once udev rereads its rules. Started once here as well,
    # so a printer already plugged in gets its permanent queue now rather
    # than at the next replug; with no printer attached it exits quietly.
    udevadm control --reload 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl start --no-block mainstream-printer-setup.service 2>/dev/null || true
    fi
    # Encrypted installs built the LUKS key file into the UKI on the
    # unencrypted EFI partition. Started now so the key it holds stops opening
    # anything as soon as this update lands, and its timer enabled so a run
    # that could not finish tries again after the next boot without holding
    # the boot up. Machines without a key file skip it. Only the release that
    # brings the timer enables it, so an administrator's disable sticks.
    if [ -z "$1" ] || [ "$(vercmp "$1" 1.0-12)" -lt 0 ]; then
        systemctl preset mainstream-luks-keyfile.timer 2>/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl start --no-block mainstream-luks-keyfile.service 2>/dev/null || true
    fi
    # VMware's virtual GPU needs its fix in the login screen's compositor as
    # well. The service decides at every boot; while it is enabled, running it
    # now means the next login screen already has it.
    if [ -z "$1" ] || [ "$(vercmp "$1" 1.0-13)" -lt 0 ]; then
        systemctl preset mainstream-vmwgfx-greeter.service 2>/dev/null || true
    fi
    if systemctl -q is-enabled mainstream-vmwgfx-greeter.service 2>/dev/null; then
        /usr/lib/mainstream/vmwgfx/greeter-setup 2>/dev/null || true
    fi
    # Every update leaves the old package files in pacman's cache. Its weekly
    # cleanup is enabled once, by the release that brings it, so a disable sticks.
    if [ -z "$1" ] || [ "$(vercmp "$1" 1.0-16)" -lt 0 ]; then
        systemctl preset paccache.timer 2>/dev/null || true
        if [ -d /run/systemd/system ]; then
            systemctl start --no-block paccache.timer 2>/dev/null || true
        fi
    fi
    systemctl preset hyprbars-rebuild.timer scrolloverview-rebuild.timer 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl start --no-block hyprbars-rebuild.timer scrolloverview-rebuild.timer 2>/dev/null || true
        for u in /home/*; do
            for p in hyprbars scrolloverview; do
                if [ -f "$u/.local/share/hyprland/plugins/$p.so.stale" ]; then
                    systemctl start --no-block "$p-rebuild.service" 2>/dev/null || true
                fi
            done
        done
    fi
}

# Run on the install or update that brings the mDNS drop-in, and not after it.
#
# The drop-in takes effect on a reload of resolved, which flushes its caches
# and keeps name resolution up, where a restart would drop it for a moment.
# Avahi may have renamed itself while the two fought over the host name;
# asking it for the real name again undoes that without a restart.
_mdns_arrived() {
    [ -d /run/systemd/system ] || return 0
    systemctl try-reload-or-restart systemd-resolved.service 2>/dev/null || true
    if systemctl -q is-active avahi-daemon.service 2>/dev/null; then
        timeout 5 avahi-set-host-name "$(uname -n | cut -d. -f1)" >/dev/null 2>&1 || true
    fi
}

# Run on the install or update that brings folder sharing, and not after it.
#
# Settings > Sharing starts Samba from a NetworkManager dispatcher hook, and
# NetworkManager can only start its dispatcher when that is enabled. The
# installer enables it, but an Arch install that ran ./setup may not have.
# Through the preset, so an administrator's own preset still decides, and
# only once, so a machine whose owner turns the dispatcher off later keeps it
# off. A machine that does not use NetworkManager is left as it is.
_sharing_arrived() {
    if systemctl -q is-enabled NetworkManager.service 2>/dev/null; then
        systemctl preset NetworkManager-dispatcher.service 2>/dev/null || true
    fi
}

# Sharing set up before 1.0-15 left samba or wsdd a dependency if it already
# was one. The helper marks them once this upgrade lets go of the database.
_sharing_keep_packages() {
    [ -d /run/systemd/system ] && [ -f /var/lib/mainstream/sharing/state ] || return 0
    systemctl start --no-block mainstream-file-sharing-keep.service 2>/dev/null \
        || echo "warning: samba and wsdd could not be marked as explicitly installed; \"pacman -D --asexplicit samba wsdd\" as root does it."
}

post_install() {
    _migrate
    _mdns_arrived
    _sharing_arrived
    _esp_snapshot_room
}

post_upgrade() {
    _migrate "$2"
    if [ "$(vercmp "$2" 1.0-14)" -lt 0 ]; then
        _mdns_arrived
        _sharing_arrived
    fi
    if [ "$(vercmp "$2" 1.0-15)" -lt 0 ]; then
        _esp_snapshot_room
        _sharing_keep_packages
    fi
}

# Removing the package takes away the home zone and the hook that stops Samba,
# so sharing is turned off first. PKEXEC_UID names root as the caller.
pre_remove() {
    [ -d /run/systemd/system ] && [ -f /var/lib/mainstream/sharing/state ] || return 0
    PKEXEC_UID=0 /usr/lib/mainstream/file-sharing disable >/dev/null 2>&1 \
        || echo "warning: sharing could not be turned off completely; see /var/log/mainstream/file-sharing.log."
}

post_remove() {
    # Without the fix installed, SDDM goes back to its stock login-screen command.
    rm -f /etc/sddm.conf.d/zz-mainstream-vmwgfx.conf
    # The home zone Settings > Sharing wrote names this package's ipsets, and
    # firewalld would fail to load it once they are gone.
    if grep -qF 'Written by Settings > Sharing' /etc/firewalld/zones/MainstreamHome.xml 2>/dev/null; then
        rm -f /etc/firewalld/zones/MainstreamHome.xml
    fi
    rm -rf /var/cache/mainstream/boot-backup
}
