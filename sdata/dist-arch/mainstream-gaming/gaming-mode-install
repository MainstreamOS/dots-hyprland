#!/bin/bash
# One-time installer for the heavy half of Gaming Mode, run via pkexec so the
# user authenticates once. The gamescope session stack is a dependency of
# mainstream-gaming and is already present; this pulls Steam and the 32-bit
# Vulkan stack, kept out of the base install so non-gamers carry none of it.
#
# pacman -Sy (refresh) before installing these leaf packages follows the common
# gaming-setup idiom; users who want a strict full upgrade can run their normal
# system update first.
set -e

# Refresh up front so the resolvability checks below and the install itself
# read the same, current databases.
pacman -Sy --noconfirm

pkgs=(
    steam
    mangohud lib32-mangohud
    vulkan-icd-loader lib32-vulkan-icd-loader
    lib32-mesa
)

gpu=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' || true)
case "$gpu" in
    *\[1002:*) pkgs+=(vulkan-radeon lib32-vulkan-radeon) ;;
esac
case "$gpu" in
    *\[8086:*) pkgs+=(vulkan-intel lib32-vulkan-intel) ;;
esac
case "$gpu" in
    *\[10de:*)
        # Match the 32-bit driver to whichever NVIDIA branch is already
        # installed (mainline nvidia-utils, or a legacy branch like
        # nvidia-580xx-utils for pre-Turing cards). Hardcoding
        # lib32-nvidia-utils here always pulls mainline and conflicts with
        # an installed legacy driver package, since both provide nvidia-libgl.
        nvidia_pkg=$(pacman -Qq 2>/dev/null | grep -E '^nvidia(-[0-9]+xx)?-utils$' | head -n1 || true)
        if [[ -n "$nvidia_pkg" ]]; then
            lib32_pkg="lib32-$nvidia_pkg"
            if pacman -Qq "$lib32_pkg" &>/dev/null; then
                # Already present — the legacy editions install it alongside
                # the driver. It must also stay OUT of the target list: the
                # legacy branches exist in no online repo, and pacman -S
                # resolves every named target against the sync dbs before
                # --needed can skip it, so naming an installed-but-
                # unresolvable package aborts the whole transaction.
                :
            elif pacman -Si "$lib32_pkg" &>/dev/null; then
                pkgs+=("$lib32_pkg")
            else
                echo "warning: $lib32_pkg is neither installed nor in any repo — 32-bit titles may not run on this driver branch." >&2
            fi
        fi
        # No installed proprietary branch means nouveau, whose 32-bit
        # userspace is the lib32-mesa already listed above.
        ;;
esac

exec pacman -S --needed --noconfirm "${pkgs[@]}"
