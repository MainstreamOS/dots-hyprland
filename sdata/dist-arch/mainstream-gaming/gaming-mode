#!/bin/bash
# Gaming Mode entry point, bound to Super+G in Hyprland. The gamescope session
# stack ships with this package; Steam and the 32-bit Vulkan stack are pulled on
# first use so the base install stays lean. Writes a per-GPU gamescope-session
# config the first time, then hands off to gaming-mode-switch to flip SDDM into
# Steam Big Picture.
set -u

notify() {
    local urgency="normal"
    [[ "$1" == "-c" ]] && { urgency="critical"; shift; }
    command -v notify-send >/dev/null 2>&1 && notify-send -u "$urgency" -a "Gaming Mode" "Gaming Mode" "$*"
}

# One-time markers (the setup-done gate, the first-run resolution tip) live here.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mainstream-gaming"

# Gaming Mode Setup -- the Quickshell menu that introduces the slow first launch and
# the Steam display tweaks, and writes the return-target / boot-target preferences.
setup_qml="$HOME/.config/quickshell/ii/gaming-setup.qml"
launch_setup() {  # $1 = firstrun|reconfig
    [[ -f "$setup_qml" ]] || return 1
    pgrep -f "gaming-setup.qml" >/dev/null 2>&1 && return 0   # already open
    GAMING_SETUP_MODE="$1" setsid -f qs -p "$setup_qml" >/dev/null 2>&1
}

# --tips: Hyprland-start hook. Once, after the first Gaming Mode session returns to the
# desktop, point the user at Steam's "Automatically Set Resolution" toggle -- it defaults
# on and renders soft, and there is no config/env lever to flip it for them. No-op unless
# armed (set when entering gaming below), and never shown twice.
if [[ "${1:-}" == "--tips" ]]; then
    if [[ -e "$state_dir/res-hint-armed" ]]; then
        rm -f "$state_dir/res-hint-armed"; touch "$state_dir/res-hint-done"
        command -v notify-send >/dev/null 2>&1 && notify-send -u normal -t 0 -a "Gaming Mode" \
            "Gaming Mode tip" "For a sharper picture, open Steam > Settings > Display and turn off 'Automatically Set Resolution'."
    fi
    exit 0
fi

# --setup: (re)open Gaming Mode Setup without switching sessions. Bound to Ctrl+Super+G
# so the user can revisit their choices any time.
if [[ "${1:-}" == "--setup" ]]; then
    launch_setup reconfig
    exit 0
fi

# --play: skip the setup menu and switch straight into gaming. The menu's "Enter Gaming
# Mode" / "Start Gaming" buttons call this so they bypass the gate below -- otherwise,
# under "Always open setup", the switch would bounce back into the menu in an endless loop.
if [[ "${1:-}" != "--play" ]]; then
    # Gate Super+G on the setup menu:
    #   * first ever press (no setup-done marker) -> show the intro and write the marker.
    #   * "Always open setup" preference          -> show the menu on every press; its
    #     "Start Gaming" button calls back with --play to actually switch.
    #   * otherwise ("Remember my setup")          -> fall through and switch directly.
    # A missing menu QML also falls through to a direct switch rather than blocking gaming.
    if [[ ! -e "$state_dir/setup-done" ]]; then
        if launch_setup firstrun; then
            # Mark the intro shown here, not only from the menu's QML: `setsid -f qs`
            # returns 0 before the menu paints, so if it ever fails to start, a later
            # Super+G must fall through to a direct switch instead of getting stuck
            # relaunching a menu that never appears.
            mkdir -p "$state_dir" && touch "$state_dir/setup-done"
            exit 0
        fi
    elif [[ "$(/usr/bin/gaming-mode-switch get open-setup 2>/dev/null)" == "always" ]]; then
        launch_setup reconfig && exit 0
    fi
fi

# Debounce Super+G: take a per-user non-blocking lock so a mashed hotkey fires the
# switch exactly once. If a switch is already in flight, drop this press silently --
# the display manager is already restarting into gaming. This is the first line of
# defense against the sddm StartLimit; gaming-mode-switch holds a second, system-wide
# flock, and 10-gaming.conf raises the sddm StartLimit ceiling as a backstop.
exec 8>"${XDG_RUNTIME_DIR:-/tmp}/gaming-mode.lock" 2>/dev/null || true
if ! flock -n 8 2>/dev/null; then
    exit 0
fi

# 1. Pull Steam + the 32-bit stack on first use (pkexec prompts for a password once).
if ! command -v steam >/dev/null 2>&1; then
    notify "Installing Steam and the 32-bit gaming stack (one-time setup)..."
    if ! pkexec /usr/bin/gaming-mode-install; then
        notify -c "Setup was cancelled or failed -- staying on the desktop."
        exit 1
    fi
fi

# Gamescope needs a hardware Vulkan device and refuses the llvmpipe software
# rasterizer -- in a VM without Vulkan passthrough the session switch would tear
# down the desktop only to bounce off gamescope and land on the greeter. Check
# up front and explain instead.
if command -v vulkaninfo >/dev/null 2>&1; then
    if ! vulkaninfo --summary 2>/dev/null | grep -i 'deviceName' | grep -qiv 'llvmpipe'; then
        notify -c "This system has no hardware 3D (Vulkan) support, so Gaming Mode can't start. In a virtual machine, enable 3D acceleration with Vulkan support -- or try Mainstream on real hardware."
        exit 1
    fi
fi

# 2. Generate a per-GPU session config once; the user can edit it afterwards.
#    The gamescope-session-plus runtime sources every ~/.config/environment.d/*.conf.
conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
conf="$conf_dir/50-mainstream-gaming.conf"
if [[ ! -f "$conf" ]]; then
    mkdir -p "$conf_dir"
    gpu=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' || true)
    {
        echo "# Generated by gaming-mode on first run -- edit freely."
        echo "# Keys: github.com/OpenGamingCollective/gamescope-session (README)."
        echo "# Force the DRM/KMS backend so gamescope takes over the display directly"
        echo "# instead of trying to nest in a (stale) parent Wayland socket and failing."
        echo "BACKEND=drm"
        if grep -qi '\[10de:' <<<"$gpu"; then
            echo "GBM_BACKEND=nvidia-drm"
            echo "__GLX_VENDOR_LIBRARY_NAME=nvidia"
            vk=$(grep -oiE '10de:[0-9a-f]{4}' <<<"$gpu" | head -1)
            [[ -n "$vk" ]] && echo "VULKAN_ADAPTER=${vk,,}"
            echo "# If gamescope crashes on NVIDIA driver 555+ (vkImportSemaphoreFdKHR"
            echo "# failed), uncomment the next line -- it trades HDR for stability:"
            echo "#ENABLE_GAMESCOPE_WSI=0"
        elif grep -qi '\[1002:' <<<"$gpu"; then
            vk=$(grep -oiE '1002:[0-9a-f]{4}' <<<"$gpu" | head -1)
            [[ -n "$vk" ]] && echo "VULKAN_ADAPTER=${vk,,}"
        fi
    } > "$conf"
fi

# 3. Clear any stale WAYLAND_DISPLAY/DISPLAY the outgoing Hyprland session exported
#    into the user systemd environment, so the gamescope session (which reuses the
#    same user manager) doesn't inherit it and try to nest. BACKEND=drm already forces
#    KMS, but this keeps the environment clean.
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY 2>/dev/null || true

# 4. Capture the desktop session before tearing it down so it's restored when the user
#    returns from gaming -- the same snapshot shutdown/reboot/hibernate take. Run it
#    synchronously while the windows are still up (the shutdown hook fires too late once
#    the switch is under way). snapshot.sh self-gates on the session-restore toggle, so
#    this is a no-op unless the user enabled restore in the power settings.
snap="$HOME/.config/quickshell/ii/scripts/session/snapshot.sh"
[[ -x "$snap" ]] && "$snap" >/dev/null 2>&1 || true

# 5. Arm the one-time resolution tip, shown on the next desktop return (see --tips).
[[ -e "$state_dir/res-hint-done" || -e "$state_dir/res-hint-armed" ]] || \
    { mkdir -p "$state_dir" && touch "$state_dir/res-hint-armed"; }

# 6. Flip the display manager into the Steam Big Picture session.
notify "Switching to Steam Big Picture..."
if ! sudo -n /usr/bin/gaming-mode-switch gaming; then
    notify -c "Couldn't switch sessions -- a system update may be needed. Staying on the desktop."
    exit 1
fi
