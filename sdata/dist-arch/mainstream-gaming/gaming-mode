#!/bin/bash
# Gaming Mode entry point, bound to Super+G in Hyprland. The gamescope session
# stack ships with this package; Steam and the 32-bit Vulkan stack are pulled on
# first use so the base install stays lean. Writes a per-GPU gamescope-session
# config the first time, then hands the switch to the session's own ending
# (end-session.sh), which closes the desktop's apps the way logging out does
# before gaming-mode-switch flips SDDM into Steam Big Picture.
set -u

notify() {
    local urgency="normal"
    [[ "$1" == "-c" ]] && { urgency="critical"; shift; }
    command -v notify-send >/dev/null 2>&1 && notify-send -u "$urgency" -a "Gaming Mode" "Gaming Mode" "$*"
}

# One-time markers (the setup-done gate, the first-run resolution tip) live here.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mainstream-gaming"

# Gaming Mode Setup -- the Quickshell menu that introduces the slow first launch and
# the Steam display tweaks, and writes the return-target / boot-target preferences.
setup_qml="$HOME/.config/quickshell/ii/gaming-setup.qml"
launch_setup() {  # $1 = firstrun|reconfig
    [[ -f "$setup_qml" ]] || return 1
    pgrep -f "gaming-setup.qml" >/dev/null 2>&1 && return 0   # already open
    GAMING_SETUP_MODE="$1" setsid -f qs -p "$setup_qml" >/dev/null 2>&1
}

# --tips: Hyprland-start hook. Once, after the first Gaming Mode session returns to the
# desktop, point the user at Steam's "Automatically Set Resolution" toggle -- it defaults
# on and renders soft. Armed only when step 2c below could not turn it off for them, and
# never shown twice.
if [[ "${1:-}" == "--tips" ]]; then
    if [[ -e "$state_dir/res-hint-armed" ]]; then
        rm -f "$state_dir/res-hint-armed"; touch "$state_dir/res-hint-done"
        command -v notify-send >/dev/null 2>&1 && notify-send -u normal -t 0 -a "Gaming Mode" \
            "Gaming Mode tip" "For a sharper picture, open Steam > Settings > Display and turn off 'Automatically Set Resolution'."
    fi
    exit 0
fi

# Steam powers Bluetooth off at every start until its own toggle has been set, and the desktop
# then keeps it off. An unset toggle is turned on; one switched off in Steam is left alone.
seed_steam_bluetooth() {
    local data_steam="${XDG_DATA_HOME:-$HOME/.local/share}/Steam" steam="" d
    # The folder Steam's own launcher settles on.
    for d in "$(readlink -e "$HOME/.steam/steam" 2>/dev/null)" "$data_steam" "$HOME/Steam"; do
        [[ -n "$d" && -x "$d/steam.sh" ]] && { steam=$d; break; }
    done
    # Exits 0 when the toggle is on, so a soft block left by an earlier session can lift.
    python3 - "${steam:-$data_steam}/config/config.vdf" <<'EOF' || return 0
import os, re, sys, tempfile

path = sys.argv[1]
want = ("InstallConfigStore", "System", "Bluetooth", "Enabled")
try:
    with open(path, encoding="utf-8") as f:
        text = f.read()
    mode = os.stat(path).st_mode & 0o777
except FileNotFoundError:
    text, mode = '"InstallConfigStore"\n{\n}\n', 0o644

stack, key, blocks, values = [], None, {}, {}
for m in re.finditer(r'"((?:[^"\\]|\\.)*)"|([{}])|//[^\n]*|[^\s{}"]+', text):
    if m.group(2) == "{":
        stack.append((key or "").lower())
        key = None
    elif m.group(2) == "}":
        if not stack:
            sys.exit(2)
        blocks[tuple(stack)] = m.start()
        stack.pop()
        key = None
    elif not m.group(0).startswith("//"):
        word = m.group(1) if m.group(1) is not None else m.group(0)
        if key is None:
            key = word
        else:
            values[tuple(stack) + (key.lower(),)] = word
            key = None
if stack:
    sys.exit(2)

lower = tuple(k.lower() for k in want)
if lower in values:
    sys.exit(0 if values[lower] != "0" else 1)
depth = next((n for n in (3, 2, 1) if lower[:n] in blocks), 0)
if not depth:
    sys.exit(2)

def block(keys, indent):
    tab = "\t" * indent
    if len(keys) == 1:
        return f'{tab}"{keys[0]}"\t\t"1"\n'
    return f'{tab}"{keys[0]}"\n{tab}{{\n{block(keys[1:], indent + 1)}{tab}}}\n'

close = blocks[lower[:depth]]
start = text.rfind("\n", 0, close) + 1
insert = block(want[depth:], depth)
if text[start:close].strip():
    start, insert = close, "\n" + insert
os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".config.vdf.")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write(text[:start] + insert + text[start:])
os.chmod(tmp, mode)
os.replace(tmp, path)
EOF
    rfkill unblock bluetooth 2>/dev/null
    return 0
}

# --seed-bluetooth: run by the gamescope-session-plus@steam drop-in before Steam starts.
if [[ "${1:-}" == "--seed-bluetooth" ]]; then
    seed_steam_bluetooth
    exit 0
fi

# --setup: (re)open Gaming Mode Setup without switching sessions. Bound to Ctrl+Super+G
# so the user can revisit their choices any time.
if [[ "${1:-}" == "--setup" ]]; then
    launch_setup reconfig
    exit 0
fi

# --play: skip the setup menu and switch straight into gaming. The menu's "Enter Gaming
# Mode" / "Start Gaming" buttons call this so they bypass the gate below -- otherwise,
# under "Always open setup", the switch would bounce back into the menu in an endless loop.
if [[ "${1:-}" != "--play" ]]; then
    # Gate Super+G on the setup menu:
    #   * first ever press (no setup-done marker) -> show the intro and write the marker.
    #   * "Always open setup" preference          -> show the menu on every press; its
    #     "Start Gaming" button calls back with --play to actually switch.
    #   * otherwise ("Remember my setup")          -> fall through and switch directly.
    # A missing menu QML also falls through to a direct switch rather than blocking gaming.
    if [[ ! -e "$state_dir/setup-done" ]]; then
        if launch_setup firstrun; then
            # Mark the intro shown here, not only from the menu's QML: `setsid -f qs`
            # returns 0 before the menu paints, so if it ever fails to start, a later
            # Super+G must fall through to a direct switch instead of getting stuck
            # relaunching a menu that never appears.
            mkdir -p "$state_dir" && touch "$state_dir/setup-done"
            exit 0
        fi
    elif [[ "$(/usr/bin/gaming-mode-switch get open-setup 2>/dev/null)" == "always" ]]; then
        launch_setup reconfig && exit 0
    fi
fi

# Debounce Super+G: take a per-user non-blocking lock so a mashed hotkey fires the
# switch exactly once. If a switch is already in flight, drop this press silently --
# the display manager is already restarting into gaming. This is the first line of
# defense against the sddm StartLimit; gaming-mode-switch holds a second, system-wide
# flock, and 10-gaming.conf raises the sddm StartLimit ceiling as a backstop.
exec 8>"${XDG_RUNTIME_DIR:-/tmp}/gaming-mode.lock" 2>/dev/null || true
if ! flock -n 8 2>/dev/null; then
    exit 0
fi

# 1. Pull Steam + the 32-bit stack on first use (pkexec prompts for a password once).
if ! command -v steam >/dev/null 2>&1; then
    notify "Installing Steam and the 32-bit gaming stack (one-time setup)..."
    if ! pkexec /usr/bin/gaming-mode-install; then
        notify -c "Setup was cancelled or failed -- staying on the desktop."
        exit 1
    fi
fi

# Gamescope needs a hardware Vulkan device and refuses the llvmpipe software
# rasterizer -- in a VM without Vulkan passthrough the session switch would tear
# down the desktop only to bounce off gamescope and land on the greeter. Check
# up front and explain instead.
if command -v vulkaninfo >/dev/null 2>&1; then
    if ! vulkaninfo --summary 2>/dev/null | grep -i 'deviceName' | grep -qiv 'llvmpipe'; then
        notify -c "This system has no hardware 3D (Vulkan) support, so Gaming Mode can't start. In a virtual machine, enable 3D acceleration with Vulkan support -- or try Mainstream on real hardware."
        exit 1
    fi
fi

# 2. Generate a per-GPU session config once; the user can edit it afterwards.
#    The gamescope-session-plus runtime sources every ~/.config/environment.d/*.conf.
conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
conf="$conf_dir/50-mainstream-gaming.conf"
if [[ ! -f "$conf" ]]; then
    mkdir -p "$conf_dir"
    gpu=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' || true)
    {
        echo "# Generated by gaming-mode on first run -- edit freely."
        echo "# Keys: github.com/OpenGamingCollective/gamescope-session (README)."
        echo "# Force the DRM/KMS backend so gamescope takes over the display directly"
        echo "# instead of trying to nest in a (stale) parent Wayland socket and failing."
        echo "BACKEND=drm"
        if grep -qi '\[10de:' <<<"$gpu"; then
            echo "GBM_BACKEND=nvidia-drm"
            echo "__GLX_VENDOR_LIBRARY_NAME=nvidia"
            vk=$(grep -oiE '10de:[0-9a-f]{4}' <<<"$gpu" | head -1)
            [[ -n "$vk" ]] && echo "VULKAN_ADAPTER=${vk,,}"
            echo "# If gamescope crashes on NVIDIA driver 555+ (vkImportSemaphoreFdKHR"
            echo "# failed), uncomment the next line -- it trades HDR for stability:"
            echo "#ENABLE_GAMESCOPE_WSI=0"
        elif grep -qi '\[1002:' <<<"$gpu"; then
            vk=$(grep -oiE '1002:[0-9a-f]{4}' <<<"$gpu" | head -1)
            [[ -n "$vk" ]] && echo "VULKAN_ADAPTER=${vk,,}"
        fi
    } > "$conf"
fi

# 2b. Which screen the session comes up on. Left alone, gamescope-session-plus
#     asks gamescope for "*,eDP-1", and the wildcard means whichever connector
#     the driver enumerates first, which on a machine with several screens is
#     not the one the person is looking at. Settings > Display already knows
#     which screen is the default one, so that answer is used here.
#     Written on every run, because the choice can change; a connector named by
#     hand in any other file of this directory wins and stops this being written
#     at all.
output_conf="$conf_dir/55-mainstream-gaming-output.conf"
gm_hand_set=0
for gm_f in "$conf_dir"/*.conf; do
    [[ -f "$gm_f" && "$gm_f" != "$output_conf" ]] || continue
    if grep -qE '^[[:space:]]*OUTPUT_CONNECTOR=' "$gm_f"; then gm_hand_set=1; break; fi
done
if (( gm_hand_set )); then
    # Somebody set it themselves; leave the screen to them.
    rm -f "$output_conf"
else
    # The default monitor from Settings > Display, which keeps it in the cursor
    # block of the Hyprland config it writes.
    gm_out=$(sed -n 's/.*default_monitor[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$HOME/.config/hypr/custom/general.lua" "$HOME/.config/hypr/hyprland/general.lua" 2>/dev/null \
        | grep -v '^$' | head -n1)
    # Nothing chosen yet: the screen with the keyboard focus right now is the
    # closest thing to "the one being looked at".
    if [[ -z "$gm_out" ]] && command -v hyprctl >/dev/null 2>&1; then
        gm_out=$(hyprctl monitors -j 2>/dev/null | jq -r '(map(select(.focused)) + .)[0].name // empty' 2>/dev/null)
    fi
    if [[ -n "$gm_out" ]]; then
        mkdir -p "$conf_dir"
        {
            echo "# Written by gaming-mode on every launch, from Settings > Display."
            echo "# To pin a screen yourself, put OUTPUT_CONNECTOR in another file"
            echo "# of this directory and this one stops being written."
            echo "# The trailing * keeps the session starting if that screen is gone."
            echo "OUTPUT_CONNECTOR=$gm_out,*"
        } > "$output_conf"
    else
        rm -f "$output_conf"
    fi
fi

# 2c. Steam's "Automatically Set Resolution" stays on until the screen has a saved
#     mode in gamescope's mode file, and while it is on Steam draws its own screens
#     at 1080p and stretches them across a larger display. On the first entry into
#     Gaming Mode the screen's line goes in with the mode the desktop runs it at, the
#     same line Steam writes when the toggle is turned off, so the picture is sharp
#     from the start and the toggle still works both ways. A line already there,
#     whoever wrote it, is left alone. Internal panels are skipped: Steam neither
#     caps nor offers the toggle there.
first_entry=0
[[ -e "$state_dir/res-hint-done" || -e "$state_dir/res-hint-armed" ]] || first_entry=1
res_handled=0
if (( first_entry )) && [[ -n "${gm_out:-}" ]]; then
    case "$gm_out" in
        eDP*|LVDS*|DSI*) res_handled=1 ;;
        *)
            gm_line=$(hyprctl monitors -j 2>/dev/null | jq -r --arg n "$gm_out" '
                .[] | select(.name == $n and (.make // "") != "" and (.model // "") != "")
                | "\(.make) \(.model):\(.width)x\(.height)@\(.refreshRate | round) 0"' 2>/dev/null | head -n1)
            if [[ -n "$gm_line" ]]; then
                modes_file="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/modes.cfg"
                mkdir -p "${modes_file%/*}" && touch "$modes_file"
                grep -qF -- "${gm_line%%:*}:" "$modes_file" || printf '%s\n' "$gm_line" >> "$modes_file"
                res_handled=1
            fi
            ;;
    esac
fi

# 3. The one-time resolution tip, shown on the next desktop return (see --tips), for a
#    first entry step 2c could not settle.
if (( first_entry )); then
    mkdir -p "$state_dir"
    if (( res_handled )); then touch "$state_dir/res-hint-done"; else touch "$state_dir/res-hint-armed"; fi
fi

# 4. Switch to the Steam Big Picture session. The desktop is ended the way logging
#    out ends it (end-session.sh): the windows are recorded for the return, every app
#    is asked to close so it can save its work or ask to, and the switch happens only
#    once they have gone. An app that stays open cancels it, and a notification names
#    it. The permission is checked first, so an account that may not switch at all
#    keeps its apps.
if ! sudo -n -l /usr/bin/gaming-mode-switch gaming >/dev/null 2>&1; then
    notify -c "Couldn't switch sessions -- a system update may be needed. Staying on the desktop."
    exit 1
fi
notify "Switching to Steam Big Picture..."
end_session="$HOME/.config/quickshell/ii/scripts/session/end-session.sh"
if [[ -f "$end_session" ]]; then
    bash "$end_session" gaming
    rc=$?
    # 2 means a desktop older than its gaming action; that one switches the old way.
    (( rc == 2 )) || exit "$rc"
fi
# The old way: record the windows, then switch at once. The gamescope session reuses
# this user manager, so the desktop's displays are cleared from it first.
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
snap="$HOME/.config/quickshell/ii/scripts/session/snapshot.sh"
[[ -x "$snap" ]] && "$snap" >/dev/null 2>&1 || true
if ! sudo -n /usr/bin/gaming-mode-switch gaming; then
    systemctl --user import-environment WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
    notify -c "Couldn't switch sessions -- a system update may be needed. Staying on the desktop."
    exit 1
fi
