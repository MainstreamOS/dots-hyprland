groups=(mainstream)
pkgname=mainstream-welcome-installer
pkgver=1.1
pkgrel=5
pkgdesc='Mainstream OS Welcome app installers — one-click app installs + DaVinci Resolve'
arch=(any)
license=(MIT)
depends=(
  curl
  jq
  pciutils
  polkit
  libnotify
  fakeroot
  libarchive
  patchelf
  flatpak
)
source=(
  install-davinci-resolve
  mainstream-welcome-install
  mainstream-welcome.rules
  mainstream-resolve-update-check
  mainstream-resolve-update-check.service
  mainstream-resolve-update-check.timer
  sunshine-inhibit.conf
)
sha256sums=(
  SKIP
  SKIP
  SKIP
  SKIP
  SKIP
  SKIP
  SKIP
)

package() {
  install -Dm755 "$srcdir/install-davinci-resolve"   "$pkgdir/usr/bin/install-davinci-resolve"
  install -Dm755 "$srcdir/mainstream-welcome-install" "$pkgdir/usr/bin/mainstream-welcome-install"
  install -Dm644 "$srcdir/mainstream-welcome.rules"   "$pkgdir/usr/share/polkit-1/rules.d/49-mainstream-welcome.rules"

  # User units, not system: the notifier needs the calling user's session bus to
  # reach their notification daemon.
  install -Dm755 "$srcdir/mainstream-resolve-update-check" \
                 "$pkgdir/usr/bin/mainstream-resolve-update-check"
  install -Dm644 "$srcdir/mainstream-resolve-update-check.service" \
                 "$pkgdir/usr/lib/systemd/user/mainstream-resolve-update-check.service"
  install -Dm644 "$srcdir/mainstream-resolve-update-check.timer" \
                 "$pkgdir/usr/lib/systemd/user/mainstream-resolve-update-check.timer"
  # Enabled by shipping the symlink rather than a user preset: a preset only
  # applies to accounts created after it lands, which on an OS image is every
  # account except the one that already exists.
  # Sunshine's own unit is what every launch route ends at: its desktop entry
  # starts this unit rather than the binary.
  install -Dm644 "$srcdir/sunshine-inhibit.conf" \
                 "$pkgdir/usr/lib/systemd/user/app-dev.lizardbyte.app.Sunshine.service.d/10-mainstream-inhibit.conf"

  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../mainstream-resolve-update-check.timer \
        "$pkgdir/usr/lib/systemd/user/timers.target.wants/mainstream-resolve-update-check.timer"
}
