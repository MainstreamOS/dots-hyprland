// Let the Welcome app's one-click installer run without a password prompt for the
// machine owner (a local, active session in the wheel group). It only installs
// packages from configured repos and runs the bundled installers as root.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/mainstream-welcome-install" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
