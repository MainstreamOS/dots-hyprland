#!/usr/bin/env bash
# mainstream-welcome-install — run the Welcome app's selected installs back-to-back
# in the background, popping a desktop notification as each finishes. Invoked once
# via pkexec (one auth prompt); runs as root and drops to the user where needed.
#
# Everything it does is logged (timestamps + per-step markers + exit codes) to
# /var/log/mainstream-welcome-install.log and the journal, so a failed install can be
# traced after the fact:  tail -f /var/log/mainstream-welcome-install.log
#
# Usage (as root, via pkexec):  mainstream-welcome-install gaming gamescope obs blender gimp krita libreoffice onlyoffice sunshine moonlight resolve resolve-studio
#
# 'resolve-update' is the same run as 'resolve'/'resolve-studio' but picks the
# edition from `install-davinci-resolve --check --json` instead of being told,
# and words its notifications as an update. It backs the Install button on the
# weekly update notification (mainstream-resolve-update-check).

set -uo pipefail

[[ $EUID -eq 0 ]] || { echo "must run as root (via pkexec)" >&2; exit 1; }

# Survive logout and the Welcome window closing: re-exec inside a transient
# system scope managed by systemd, detached from the login session.
if [[ -z ${MW_IN_SCOPE:-} ]] && command -v systemd-run >/dev/null 2>&1; then
  exec systemd-run --scope --quiet --collect \
    --setenv=MW_IN_SCOPE=1 --setenv=PKEXEC_UID="${PKEXEC_UID:-}" \
    -- "$0" "$@"
fi

# The unprivileged caller (pkexec exports PKEXEC_UID).
RUID=${PKEXEC_UID:-}
[[ -n $RUID ]] || { echo "PKEXEC_UID not set — launch via pkexec" >&2; exit 1; }
RUSER=$(id -un "$RUID") || { echo "cannot resolve calling user" >&2; exit 1; }
RHOME=$(getent passwd "$RUID" | cut -d: -f6)

# zz- so this NOPASSWD grant sorts AFTER 10-installer's "%wheel ... ALL" — sudoers is
# last-match-wins, so an earlier (00-) file would be overridden by the wheel password rule.
SUDOERS_TMP=/etc/sudoers.d/zz-mainstream-welcome-resolve
cleanup() { rm -f "$SUDOERS_TMP"; }
trap cleanup EXIT

LOGFILE=/var/log/mainstream-welcome-install.log
{ : >>"$LOGFILE"; } 2>/dev/null || LOGFILE="${TMPDIR:-/tmp}/mainstream-welcome-install.log"
exec > >(tee -a "$LOGFILE") 2>&1
log() { printf '%s :: %s\n' "$(date '+%F %T')" "$*"; }

as_user() {  # command...
  runuser -u "$RUSER" -- env \
    XDG_RUNTIME_DIR="/run/user/$RUID" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$RUID/bus" \
    "$@"
}

# Fire a notification in the caller's session bus.
notify() {  # title  body  [urgency]
  as_user notify-send -a "Mainstream" -u "${3:-normal}" "$1" "${2:-}" 2>/dev/null || true
}

# Locate install-davinci-resolve (system path first, then the caller's ~/.local/bin).
resolve_bin() {
  if command -v install-davinci-resolve >/dev/null 2>&1; then
    command -v install-davinci-resolve
  elif [[ -x "$RHOME/.local/bin/install-davinci-resolve" ]]; then
    echo "$RHOME/.local/bin/install-davinci-resolve"
  fi
}

# The [mainstream] repo is put in place during the first boot, and for the
# moment that takes there is no database to answer from. A package asked for
# then is simply not found, which reads as a failed install for something that
# would have worked seconds later, so wait for the repo rather than lose the
# race. Waiting is the whole behavior and there is no deadline: a machine that
# is offline now still wants these packages when it is not, and the periodic
# refresh is what lets it notice.
#
# Ask by what comes back, not by the exit status: pacman -Sl on a repo that is
# configured but has no database yet exits 0 and only warns on stderr, which is
# exactly the moment this is here to catch. An empty listing is the answer.
repo_answers() {
  [[ -n "$(pacman -Slq mainstream </dev/null 2>/dev/null)" ]]
}

wait_for_repo() {
  repo_answers && return 0
  # Nothing is coming: on a machine that never had [mainstream] configured there
  # is no first boot to wait through, so let pacman say so in its own words
  # rather than holding here forever.
  if ! pacman-conf --repo=mainstream >/dev/null 2>&1; then
    log "[mainstream] is not configured on this system; not waiting for it"
    return 0
  fi
  local waited=0
  log "[mainstream] is configured but not answering yet; holding the install until it does"
  notify "Waiting for the Mainstream repository" "The install starts as soon as it is ready."
  until repo_answers; do
    sleep 3
    waited=$((waited + 3))
    if (( waited % 30 == 0 )); then
      log "still waiting for [mainstream] after ${waited}s; refreshing databases"
      pacman -Sy --noconfirm >/dev/null 2>&1 || true
    fi
  done
  log "[mainstream] answered after ${waited}s"
}

# The repo race above is not the only one. Another of our own jobs can be holding
# the pacman lock at exactly this moment: mainstream-keyring-init runs a
# five-attempt `pacman -Sy` from a timer that first fires 20s into the boot, which
# is the same minute a new user reaches the Welcome app's install page. The fleet's
# timers answer a busy database by yielding until their next tick. Someone who just
# pressed Install has no next tick, so wait for the lock rather than fail on it.
wait_for_pacman_lock() {
  [[ -e /var/lib/pacman/db.lck ]] || return 0
  local waited=0 rc
  while [[ -e /var/lib/pacman/db.lck ]]; do
    # A lock nothing has open is debris from a killed transaction, which would
    # otherwise block every install on this machine forever. libalpm keeps it
    # open while it holds it, whichever front end that is, so a process name
    # is not the test.
    rc=0; fuser -s /var/lib/pacman/db.lck 2>/dev/null || rc=$?
    if (( rc == 1 )); then
      log "pacman database lock is stale (nothing has it open); removing it"
      rm -f /var/lib/pacman/db.lck 2>/dev/null
      return 0
    fi
    if (( waited == 0 )); then
      log "pacman database is locked by another process; waiting for it to finish"
      notify "Waiting for another update to finish" "Your install starts as soon as the package manager is free."
    fi
    sleep 3
    waited=$((waited + 3))
    if (( waited >= 600 )); then
      log "pacman database still locked after ${waited}s; giving up"
      return 1
    fi
  done
  log "pacman database lock cleared after ${waited}s"
}

readonly NEEDS_UPDATE=100

# True when every error pacman reported was a 404 download: the package list
# names a build the mirrors have since replaced.
stale_package_list() {  # pacman output
  local not_found="failed retrieving file '.*: The requested URL returned error: 404[[:space:]]*\$"
  local gave_up='failed to commit transaction \(failed to retrieve some files\)'
  local errors
  grep -qE "$not_found" <<<"$1" && grep -qE "$gave_up" <<<"$1" || return 1
  errors=$(grep 'error: ' <<<"$1")
  ! grep -qvE "$not_found|$gave_up" <<<"$errors"
}

pac() {
  # The ISO leaves a package out of its bundled repo when the live image
  # already has it installed, so until the online repo takes over, no repo lists
  # it and pacman -S would call it not found. Installed is all --needed asks.
  local t targets=()
  for t in "$@"; do
    if [[ "$(pacman -Qq "$t" 2>/dev/null)" == "$t" ]] && ! pacman -Sp "$t" </dev/null >/dev/null 2>&1; then
      log "$t is installed and no repo lists it yet; leaving it as it is"
      continue
    fi
    targets+=("$t")
  done
  (( ${#targets[@]} > 0 )) || return 0
  # Wait on [mainstream] only for targets it has to provide; the rest resolve now.
  pacman -Sp "${targets[@]}" >/dev/null 2>&1 || wait_for_repo
  wait_for_pacman_lock || { log "could not get the pacman lock"; return 1; }
  log "run: pacman -S --needed --noconfirm ${targets[*]}"
  # English messages whatever the user's language, so the check below can read them.
  local out rc=0
  out=$(LC_ALL=C.UTF-8 pacman -S --needed --noconfirm "${targets[@]}" 2>&1 | tee /dev/stderr) || rc=$?
  (( rc == 0 )) && return 0
  # Refreshing or upgrading here would be a partial upgrade, or a full one that
  # skips the Update page's snapshot, boot checks and Qt pin, so stop instead.
  if stale_package_list "$out"; then
    log "the mirrors answered 404 for: $(sed -n "s/.*failed retrieving file '\([^']*\)'.*/\1/p" <<<"$out" | sort -u | paste -sd ' ')"
    log "the package list is older than the mirrors; a system update is needed first"
    return "$NEEDS_UPDATE"
  fi
  return "$rc"
}

flat() {  # flathub ref
  command -v flatpak >/dev/null 2>&1 || { log "flatpak is not installed"; return 1; }
  flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 || true
  log "run: flatpak install --system --noninteractive -y flathub $1"
  # A second try covers the transient fetch errors flatpak does not retry itself.
  flatpak install --system --noninteractive -y flathub "$1" \
    || { log "flatpak install failed once, retrying"; flatpak install --system --noninteractive -y flathub "$1"; }
}

# Apps waiting on a system update are told about together, once, by notify_needs_update.
report_failure() {  # status  title
  (( $1 == NEEDS_UPDATE )) && return "$NEEDS_UPDATE"
  notify "$2" "See $LOGFILE." critical
  return 1
}

install_with() {  # pac|flat  label  target...
  local via=$1 label=$2; shift 2
  notify "Installing $label…" "$*"
  if "$via" "$@"; then notify "$label installed" "Find it in your apps."
  else report_failure $? "$label install failed"; fi
}

install_libreoffice() {
  # A box already on the still release keeps it; fresh conflicts with it.
  if pacman -Q libreoffice-still >/dev/null 2>&1; then
    log "libreoffice-still is installed, leaving it in place"
    notify "LibreOffice already installed" "The still release is in place."
    return 0
  fi
  install_with pac "LibreOffice" libreoffice-fresh
}

install_gaming() {
  notify "Installing Desktop Gaming…" "Steam and the 32-bit gaming stack"
  local pkgs=(steam mangohud lib32-mangohud vulkan-icd-loader lib32-vulkan-icd-loader lib32-mesa)
  local gpu; gpu=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' || true)
  case "$gpu" in *\[1002:*) pkgs+=(vulkan-radeon lib32-vulkan-radeon) ;; esac
  case "$gpu" in *\[8086:*) pkgs+=(vulkan-intel lib32-vulkan-intel) ;; esac
  case "$gpu" in
    *\[10de:*)
      # The 32-bit driver has to match whichever NVIDIA branch is installed.
      # Naming lib32-nvidia-utils always pulls mainline, which conflicts with a
      # legacy branch over nvidia-libgl and aborts the whole transaction; and a
      # legacy lib32 package exists in no online repo, so naming one that is
      # already installed aborts it too, before --needed can skip it.
      nvidia_pkg=$(pacman -Qq 2>/dev/null | grep -E '^nvidia(-[0-9]+xx)?-utils$' | head -n1 || true)
      if [[ -n "$nvidia_pkg" ]]; then
        lib32_pkg="lib32-$nvidia_pkg"
        if pacman -Qq "$lib32_pkg" &>/dev/null; then
          :
        elif pacman -Si "$lib32_pkg" &>/dev/null; then
          pkgs+=("$lib32_pkg")
        else
          log "$lib32_pkg is neither installed nor in any repo; 32-bit titles may not run on this driver branch."
        fi
      fi
      ;;
  esac
  log "detected GPU line: ${gpu:-<none>}"
  log "packages: ${pkgs[*]}"
  if pac "${pkgs[@]}"; then notify "Desktop Gaming installed" "Steam and the gaming stack are ready."
  else report_failure $? "Desktop Gaming install failed"; fi
}

# WiVRn is the one OpenXR runtime we ship, and streaming to a standalone
# headset is what it does. wayvr comes along because WiVRn has no dashboard of
# its own, so without it a headset shows nothing the user can act on.
#
# wivrn.service is deliberately NOT enabled here. Upstream ships it for headless
# setups; the normal path is the dashboard, which starts the server and runs a
# first-time wizard. Enabling it would leave a streaming server listening at
# every login for somebody who tried VR once. Nor is an active OpenXR runtime
# written: wivrn-server takes that over itself while a headset is connected and
# puts back what was there before, so a pointer of ours would only fight it.
install_vr_stack() {
  local what="VR headset support"
  local pkgs=(wivrn-server wivrn-dashboard xrizer lib32-xrizer xr-hardware wayvr openxr openvr)
  notify "Installing $what…" "${pkgs[*]}"
  if pac "${pkgs[@]}"; then
    notify "$what installed" "Open WiVRn to pair your headset, then start it before your VR app."
  else
    report_failure $? "$what install failed"
  fi
}

install_gamescope() {
  notify "Setting up Steam Big Picture…" "gamescope session (Super + G)"
  pac mainstream-gaming || {
    local rc=$?
    log "pac mainstream-gaming FAILED"
    report_failure "$rc" "Steam Big Picture setup failed"
    return
  }
  # This runs after every other pacman install, so the notice can go now
  # rather than wait on the Steam downloads below.
  notify_needs_update
  if [[ -x /usr/bin/gaming-mode-install ]]; then
    log "running gaming-mode-install (pulls Steam + the 32-bit stack)"
    if gaming-mode-install; then
      if [[ -x /usr/bin/mainstream-steam-gamescope-preload ]]; then
        log "preseeding the Steam Deck client for a fast first Super + G"
        notify "Steam Big Picture — prefetching…" "Fetching the Steam Deck client so the first Super + G is instant."
        local prc=0
        mainstream-steam-gamescope-preload || prc=$?
        log "mainstream-steam-gamescope-preload exited: $prc"
      else
        log "mainstream-steam-gamescope-preload NOT FOUND — first Super + G will be slower"
      fi
      notify "Steam Big Picture ready" "Press Super + G to launch."
    else
      log "gaming-mode-install FAILED"
      notify "Steam Big Picture setup failed" "See $LOGFILE." critical
      return 1
    fi
  else
    log "gaming-mode-install MISSING — did 'pac mainstream-gaming' fail? is [mainstream] configured?"
    notify "Steam Big Picture setup failed" "gaming-mode-install not found." critical
    return 1
  fi
}

install_resolve() {  # "" | --studio   [install|update]
  local flag=$1 mode=${2:-install} name="DaVinci Resolve"
  [[ $flag == --studio ]] && name="DaVinci Resolve Studio"
  # Same run either way — the installer is the update path — but a user who
  # pressed "Install now" on an update notification should not be told their
  # existing install is being installed.
  local ing="Installing" done_="installed" failed="install failed"
  if [[ $mode == update ]]; then ing="Updating"; done_="updated"; failed="update failed"; fi
  local bin; bin=$(resolve_bin)
  if [[ -z $bin ]]; then
    log "install-davinci-resolve NOT FOUND (checked PATH and $RHOME/.local/bin)"
    notify "$name unavailable" "install-davinci-resolve not found." critical; return
  fi
  log "installer: $bin   args: ${flag:-<none>} -y --anon   (running as $RUSER, mode=$mode)"
  notify "$ing $name…" "Large download — it keeps running in the background."
  printf '%s ALL=(root) NOPASSWD: ALL\n' "$RUSER" > "$SUDOERS_TMP"
  chmod 0440 "$SUDOERS_TMP"
  log "granted temporary NOPASSWD sudo to $RUSER for the build"
  local rc=0
  runuser -l "$RUSER" -- "$bin" $flag -y --anon || rc=$?
  rm -f "$SUDOERS_TMP"
  log "$name installer exited: $rc"
  if (( rc == 0 )); then notify "$name $done_" "Launch it from your apps."
  else notify "$name $failed" "See the log: $LOGFILE" critical; return 1; fi
}

# Update whichever edition is actually installed. The edition is read from
# `--check --json` rather than guessed, so the notification's button cannot
# start a 50 GB build of the wrong one — and so a beta install, which --check
# deliberately refuses to compare against stable, is left alone.
update_resolve() {
  local bin; bin=$(resolve_bin)
  if [[ -z $bin ]]; then
    log "install-davinci-resolve NOT FOUND (checked PATH and $RHOME/.local/bin)"
    notify "DaVinci Resolve unavailable" "install-davinci-resolve not found." critical; return
  fi
  local out pkg=""
  out=$(runuser -l "$RUSER" -- "$bin" --check --json 2>/dev/null) || true
  [[ -n $out ]] && pkg=$(jq -r '.package // empty' <<<"$out" 2>/dev/null) || pkg=""
  log "resolve-update: --check reports package='${pkg:-<none>}'"
  case $pkg in
    davinci-resolve-studio) install_resolve --studio update ;;
    davinci-resolve)        install_resolve ""        update ;;
    "") log "no Resolve package installed — nothing to update"
        notify "Nothing to update" "DaVinci Resolve is not installed." ;;
    *)  log "refusing to update '$pkg' — betas are not compared against stable"
        notify "Nothing to update" "A beta build of DaVinci Resolve is installed; update it yourself." ;;
  esac
}

failed_items=(); needs_update_items=(); needs_update_told=0

run_item() {  # label  fn...
  local label=$1; shift
  log "════════ START: $label ════════"
  local t0=$SECONDS rc=0
  "$@" || rc=$?
  log "════════ END: $label — exit $rc, $((SECONDS - t0))s ════════"
  if (( rc == NEEDS_UPDATE )); then needs_update_items+=("$label")
  elif (( rc )); then failed_items+=("$label"); fi
}

join_names() {  # name...  ->  "A", "A and B", "A, B and C"
  local out=$1; shift
  while (( $# > 1 )); do out+=", $1"; shift; done
  (( $# )) && out+=" and $1"
  printf '%s' "$out"
}

# These two run as the user, detached: notify-send -A returns only once the
# notification is answered, and the button reaches only a sender still running.
await_update_click() {  # title  body
  local action
  action=$(timeout 1d notify-send -a Mainstream -u critical -i mainstream-update \
    -A "update=Open updates" -- "$1" "$2" 2>/dev/null) || return 0
  [[ $action == update ]] && open_update_page
}

# Through Settings' own opener, run by the compositor so it has the session's environment.
open_update_page() {
  local qs_dir="$HOME/.config/quickshell/ii" pid
  if [[ -f $qs_dir/scripts/settings/open-settings.sh ]]; then
    hyprctl -i 0 eval 'hl.exec_cmd("bash \"$HOME/.config/quickshell/ii/scripts/settings/open-settings.sh\" UpdateConfig.qml")' >/dev/null 2>&1
    return
  fi
  # Dots from before that opener (3.0.0): an open window takes the page and comes forward.
  # Without the session's WAYLAND_DISPLAY, qs lists nothing unless told any display will do.
  pid=$(qs list --any-display -p "$qs_dir/settings.qml" -j 2>/dev/null | jq -r 'max_by(.launch_time) | .pid // empty' 2>/dev/null)
  if [[ -n $pid ]] && qs ipc --pid "$pid" call settings showPage UpdateConfig.qml >/dev/null 2>&1; then
    hyprctl -i 0 dispatch "hl.dsp.focus({ window = \"pid:$pid\" })" >/dev/null 2>&1
    return 0
  fi
  hyprctl -i 0 eval 'hl.exec_cmd("QS_SETTINGS_PAGE=UpdateConfig.qml qs -p \"$HOME/.config/quickshell/ii/settings.qml\"")' >/dev/null 2>&1
}

# Names only the apps no earlier notice named.
notify_needs_update() {
  local items=("${needs_update_items[@]:needs_update_told}") n names title body
  local prefix="" what="versions it asked for are" them=them
  n=${#items[@]}
  (( n )) || return 0
  needs_update_told=${#needs_update_items[@]}
  names=$(join_names "${items[@]}")
  case $n in
    1) title="$names needs a system update first"; what="version it asked for is"; them=it ;;
    2) title="$names need a system update first" ;;
    *) title="$n apps need a system update first"; prefix="Not installed: $names. " ;;
  esac
  body="${prefix}This system's package list is out of date, so the $what no longer on the download servers. Update the system, then install $them again."
  log "needs a system update first: $names; sending the notice with an Open updates button"
  as_user setsid -f bash -c "$(declare -f await_update_click open_update_page); await_update_click \"\$1\" \"\$2\"" \
    bash "$title" "$body" </dev/null >/dev/null 2>&1 || log "could not send the system update notice"
}

run_app() {  # label  pac|flat  target...
  run_item "$1" install_with "$2" "$1" "${@:3}"
}

(( $# )) || { log "nothing selected — exiting"; exit 0; }

log "=================================================================="
log "mainstream-welcome-install starting"
log "  user=$RUSER (uid $RUID)  home=$RHOME"
log "  requested: $*"
log "  log file: $LOGFILE"

notify "Setting up your apps" "Installing your selections in the background — you'll get a notification as each one finishes."

tasks=(); last=(); resolve_tasks=()
for opt in "$@"; do
  case $opt in
    resolve|resolve-studio|resolve-update) resolve_tasks+=("$opt") ;;
    # gaming-mode-install refreshes the package databases, so the other pacman installs go first.
    gamescope)                             last=(gamescope) ;;
    *)                                     tasks+=("$opt") ;;
  esac
done

run_opt() {
  case $1 in
    gaming)          run_item "Desktop Gaming"          install_gaming ;;
    gamescope)       run_item "Steam Big Picture"       install_gamescope ;;
    vr)              run_item "VR headset support"      install_vr_stack ;;
    obs)             run_app "OBS Studio"    pac  mainstream-obs ;;
    blender)         run_app "Blender"       pac  blender ;;
    gimp)            run_app "GIMP"          pac  gimp ;;
    krita)           run_app "Krita"         pac  krita ;;
    libreoffice)     run_item "LibreOffice"  install_libreoffice ;;
    onlyoffice)      run_app "OnlyOffice"    flat org.onlyoffice.desktopeditors ;;
    sunshine)        run_app "Sunshine"      pac  sunshine ;;
    moonlight)       run_app "Moonlight"     pac  moonlight-qt ;;
    resolve)         run_item "DaVinci Resolve"         install_resolve "" ;;
    resolve-studio)  run_item "DaVinci Resolve Studio"  install_resolve --studio ;;
    resolve-update)  run_item "DaVinci Resolve update"  update_resolve ;;
    *) log "unknown option: $1" ;;
  esac
}

for opt in "${tasks[@]}" "${last[@]}"; do run_opt "$opt"; done
# Before Resolve's long build, so the notice is not held behind it.
notify_needs_update
for opt in "${resolve_tasks[@]}"; do run_opt "$opt"; done

log "all install tasks finished"

(( ${#needs_update_items[@]} )) && log "NEEDS A SYSTEM UPDATE: $(join_names "${needs_update_items[@]}")"
if (( ${#failed_items[@]} )); then
  log "FAILED: ${failed_items[*]}"
  notify "Some installs did not finish" "Not finished: ${failed_items[*]}. See $LOGFILE." critical
  exit 1
fi
(( ${#needs_update_items[@]} )) && exit 1

notify "Installs finished" "All selected items are done."
