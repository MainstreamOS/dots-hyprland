#!/usr/bin/env bash
# mainstream-resolve-update-check — tell the user when a newer DaVinci Resolve is
# out. Resolve is built into a local pacman package, so 'pacman -Syu' never sees
# it and nothing else would ever mention a new release.
#
# Nothing is installed unless the user presses the notification's Install button.
# Pressing it hands off to 'mainstream-welcome-install resolve-update' through
# pkexec, which is the same path the Welcome app already uses and is already
# covered by 49-mainstream-welcome.rules — so this adds no new privileged code
# and no new polkit rule.
#
# All version logic lives in 'install-davinci-resolve --check --json' — this is a
# wrapper around that one call, so the two can never disagree about what "out of
# date" means.

set -euo pipefail

readonly PROG=${0##*/}

QUIET=0
FORCE=0
NO_ACTION=0
AWAIT_ACTION=0

# ---------------------------------------------------------------- output helpers
if [[ -t 1 ]]; then
  c_b=$'\e[1m'; c_g=$'\e[32m'; c_y=$'\e[33m'; c_r=$'\e[31m'; c_0=$'\e[0m'
else
  c_b=""; c_g=""; c_y=""; c_r=""; c_0=""
fi
info() { printf '%s==>%s %s\n' "$c_g$c_b" "$c_0" "$*"; }
step() { printf '%s  ->%s %s\n' "$c_b" "$c_0" "$*"; }
die()  { printf '%serror:%s %s\n' "$c_r$c_b" "$c_0" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
${c_b}$PROG${c_0} — notify when a newer DaVinci Resolve release is available.

Usage: $PROG [options]

  --quiet             Exit status only; never notify.
  --force             Notify again even if this version was already announced.
  --no-action         Plain notification with no Install button.
  -h, --help          This help.

Exit codes:
  0   up to date, nothing installed, a beta is installed, or the check could
      not run (offline / API down — deliberately silent)
  10  an update is available
  1   $PROG itself could not run the check

The notification carries an ${c_b}Install now${c_0} button when the notification daemon
supports actions. Pressing it updates whichever edition is installed —
free or Studio, read from --check, not guessed — downloading and building in
the background, with a notification when it starts and another when it
finishes. Nothing happens unless you press it; --no-action removes the button.

A user timer runs this weekly. To turn it off:
  ${c_b}systemctl --user mask --now mainstream-resolve-update-check.timer${c_0}

and to turn it back on:
  ${c_b}systemctl --user unmask mainstream-resolve-update-check.timer${c_0}
  ${c_b}systemctl --user start mainstream-resolve-update-check.timer${c_0}

'mask', not 'disable': the package enables the timer by shipping a symlink in
/usr/lib/systemd/user/timers.target.wants/, and 'disable' only ever removes
symlinks from the user's own config, so against a packaged one it exits 0 and
changes nothing. Masking is also what the Resolve section of Settings ->
Updates toggles, so the two agree.
EOF
}

# ------------------------------------------------------------------- parse args
while (( $# )); do
  case $1 in
    -q|--quiet) QUIET=1; shift ;;
    --force) FORCE=1; shift ;;
    --no-action) NO_ACTION=1; shift ;;
    # Internal: the detached half of the action notification. Not in --help.
    --await-action) AWAIT_ACTION=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done

# Same lookup order as mainstream-welcome-install: the packaged path first, then
# a user's own copy.
resolve_bin() {
  if command -v install-davinci-resolve >/dev/null 2>&1; then
    command -v install-davinci-resolve
  elif [[ -x "$HOME/.local/bin/install-davinci-resolve" ]]; then
    printf '%s\n' "$HOME/.local/bin/install-davinci-resolve"
  fi
}

INSTALLER=$(resolve_bin)
[[ -n $INSTALLER ]] || die "install-davinci-resolve not found."

# The privileged half of the Install button. Looked up rather than hardcoded, for
# the same reason install-davinci-resolve is.
WELCOME_INSTALL=$(command -v mainstream-welcome-install 2>/dev/null) || WELCOME_INSTALL=""

# 10 = update available, 0 = nothing to do, anything else = the check failed.
# A failed check is silent and exits 0 on purpose: this runs on a timer, and a
# laptop that wakes up on a train with no network must not produce an error
# notification about it.
rc=0
OUT=$("$INSTALLER" --check --json 2>/dev/null) || rc=$?
case $rc in
  10) ;;
  0)  exit 0 ;;
  *)  exit 0 ;;
esac

PKG=$(jq -r '.package // empty' <<<"$OUT" 2>/dev/null) || PKG=""
LATEST=$(jq -r '.latest // empty' <<<"$OUT" 2>/dev/null) || LATEST=""
# Exit 10 said there is an update, so a response we cannot read is a real fault
# in the pair of scripts rather than a network problem — surface it.
[[ -n $LATEST ]] || die "could not read the version check output."

NAME="DaVinci Resolve"
CMD="install-davinci-resolve"
if [[ $PKG == davinci-resolve-studio ]]; then
  NAME="DaVinci Resolve Studio"
  CMD="install-davinci-resolve --studio"
fi

if (( QUIET )); then
  exit 10
fi

# ------------------------------------------------- the Install button (detached)
# Reached only via `setsid --fork "$0" --await-action` below. Blocks on the
# notification for as long as it is on screen, then acts on the button.
if (( AWAIT_ACTION )); then
  chosen=$(notify-send -a "Mainstream" -u normal \
    -A "install=Install now" \
    "$NAME $LATEST is available" \
    "Press Install now to update in the background, or run: $CMD" 2>/dev/null) || chosen=""
  # Dismissed, timed out, or closed — that is a no, and a no is silent.
  [[ $chosen == install ]] || exit 0

  # Hand off to the Welcome app's installer. It picks the edition from --check,
  # runs install-davinci-resolve -y --anon inside a transient systemd scope so
  # the build survives logout, and fires its own "Updating…" and "updated"
  # notifications. pkexec is passwordless here via 49-mainstream-welcome.rules.
  if pkexec "$WELCOME_INSTALL" resolve-update; then
    exit 0
  fi
  # pkexec refuses when the caller has no active local session, which is a real
  # possibility for a process launched from a systemd *user* unit. Say so and
  # hand back the command rather than failing silently.
  notify-send -a "Mainstream" -u critical \
    "Could not start the DaVinci Resolve update" \
    "Authorisation was refused. Run this in a terminal instead: $CMD" 2>/dev/null || true
  exit 1
fi

# Announce a given version once. The timer fires weekly and Blackmagic can go
# months between releases, so without this the same notification arrives every
# week until the user acts on it.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mainstream-resolve"
STATE_FILE="$STATE_DIR/last-notified"
if ! (( FORCE )) && [[ -r $STATE_FILE ]] && [[ "$(<"$STATE_FILE")" == "$LATEST" ]]; then
  exit 10
fi

# Does this notify-send understand actions, and will anything render them? The
# button is pointless without both, and an unsupported -A makes older builds
# fail outright rather than degrade.
action_supported() {
  (( NO_ACTION )) && return 1
  command -v notify-send >/dev/null 2>&1 || return 1
  command -v setsid      >/dev/null 2>&1 || return 1
  [[ -n $WELCOME_INSTALL ]] || return 1
  notify-send --help 2>&1 | grep -q -- '--action' || return 1
  return 0
}

if action_supported; then
  # notify-send -A blocks until the notification is actioned or dismissed, and
  # the action is delivered to the *sender* — a dead sender means a dead button.
  # This script is a Type=oneshot unit, so waiting inline would hold the systemd
  # job open for as long as the popup sits on screen. Detach the waiter instead:
  # the unit completes immediately and the button keeps working. The service sets
  # KillMode=process so systemd does not reap the waiter along with the unit.
  # Re-entered through the running interpreter rather than as "$0" alone: the
  # script is only mode 755 once packaged, and this has to work from a checkout
  # too.
  setsid --fork "${BASH:-/usr/bin/env bash}" "$0" --await-action >/dev/null 2>&1 || true
elif command -v notify-send >/dev/null 2>&1; then
  notify-send -a "Mainstream" -u normal \
    "$NAME $LATEST is available" \
    "Run: $CMD" 2>/dev/null || true
fi

# Written even if notify-send was missing or the bus rejected it — retrying
# weekly would not find a notification daemon that is not there, and the exit
# code already reports the update to whatever is watching.
mkdir -p "$STATE_DIR" && printf '%s\n' "$LATEST" > "$STATE_FILE"

if [[ -t 1 ]]; then
  info "${c_y}${c_b}${NAME} ${LATEST} is available.${c_0}"
  step "Install it with: ${c_b}${CMD}${c_0}"
fi

exit 10
