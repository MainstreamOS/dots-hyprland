# Maintainer: mainstreamos <https://github.com/MainstreamOS>
groups=(mainstream)
pkgname=mainstream-audio
pkgver=1.0
pkgrel=11
pkgdesc='Mainstream OS Audio Dependencies'
provides=('illogical-impulse-audio')
replaces=('illogical-impulse-audio')
arch=(any)
license=(None)
depends=(
  cava
  pavucontrol-qt
  wireplumber
  pipewire-pulse
  libdbusmenu-gtk3
  playerctl
  alsa-utils
  rtkit
)
source=(
  '51-disable-hdmi-default.conf'
  '52-soft-mixer-devices.conf'
  'mainstream-soft-mixer-levels.conf'
  'audio-soft-mixer-levels'
  'mainstream-audio-firstboot.service'
  'mainstream-audio-card-init@.service'
  'audio-firstboot'
  'audio-card-init'
  '89-mainstream-audio.rules'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/51-disable-hdmi-default.conf" \
    "$pkgdir/etc/wireplumber/wireplumber.conf.d/51-disable-hdmi-default.conf"
  install -Dm644 "$srcdir/52-soft-mixer-devices.conf" \
    "$pkgdir/etc/wireplumber/wireplumber.conf.d/52-soft-mixer-devices.conf"
  install -Dm644 "$srcdir/mainstream-soft-mixer-levels.conf" \
    "$pkgdir/usr/lib/systemd/user/wireplumber.service.d/mainstream-soft-mixer-levels.conf"
  install -Dm644 "$srcdir/mainstream-audio-firstboot.service" \
    "$pkgdir/usr/lib/systemd/system/mainstream-audio-firstboot.service"
  install -Dm644 "$srcdir/mainstream-audio-card-init@.service" \
    "$pkgdir/usr/lib/systemd/system/mainstream-audio-card-init@.service"
  install -Dm644 "$srcdir/89-mainstream-audio.rules" \
    "$pkgdir/usr/lib/udev/rules.d/89-mainstream-audio.rules"
  install -Dm755 "$srcdir/audio-firstboot" \
    "$pkgdir/usr/lib/mainstream/audio-firstboot"
  install -Dm755 "$srcdir/audio-card-init" \
    "$pkgdir/usr/lib/mainstream/audio-card-init"
  install -Dm755 "$srcdir/audio-soft-mixer-levels" \
    "$pkgdir/usr/lib/mainstream/audio-soft-mixer-levels"
}
