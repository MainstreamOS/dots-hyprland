#!/usr/bin/env bash
# Mainstream OS — first-boot audio initialization
#
# Driven by mainstream-audio-firstboot.service. Runs exactly once: the
# service unit is gated by ConditionPathExists=!/var/lib/mainstream/audio-firstboot.done
# and this script touches that marker on success.
#
# What this script does:
#   1. Enumerates every ALSA card present at boot via `aplay -l`.
#   2. For each card, delegates the per-card unmute + level pass to
#      /usr/lib/mainstream/audio-card-init — the same helper that's
#      invoked by udev (89-mainstream-audio.rules) for cards that
#      arrive later (USB hot-plug, dock undock, Bluetooth A2DP, etc.).
#
# Why the split:
#   Before the split, this script duplicated all the per-card logic
#   inline and ran once at first boot. USB devices plugged in after
#   first boot never got the same treatment — many USB headsets
#   (Fifine, HyperX, Logitech, etc.) ship with PCM or Master muted,
#   so plugging one in after install produced total silence even
#   with PipeWire stream volume at 100%. The udev-triggered
#   card-init service now handles the hot-plug case using the SAME
#   script as firstboot, so the two paths can't drift.

set -u

mkdir -p /var/lib/mainstream

for card in $(aplay -l 2>/dev/null | awk -F'[ :]' '/^card/ {print $2}' | sort -u); do
    /usr/lib/mainstream/audio-card-init "$card" || true
done

# Mark complete — flips ConditionPathExists for the service unit so
# this script never runs again unless an admin removes the marker.
touch /var/lib/mainstream/audio-firstboot.done
