#!/usr/bin/env bash
# Mainstream OS privileged system-update helper.
#
# Invoked via:  sudo -S /usr/local/bin/mainstream-update-helper [args]
# Driven by:    ~/.config/quickshell/ii/modules/settings/UpdateConfig.qml
#
# Runs pacman, AUR, flatpak, snap and the dotfiles update directly, then
# optionally topgrade for developer tools (cargo, pipx, npm, ...).
#
# Flags (any combination):
#   --skip-system              skip pacman -Syu
#   --skip-aur                 skip the yay/paru AUR update
#   --skip-flatpak             skip flatpak update (system + user)
#   --skip-snap                skip snap refresh
#   --skip-dotfiles            skip the updatems dotfiles refresh
#   --skip-extras              skip the topgrade pass
#   --skip-firmware            pass --disable firmware to topgrade (polkit prompts time out)
#   --edge                     updatems takes the branch instead of the newest release
#   --auto-rebuild-quickshell  after all steps, rebuild Quickshell on an ABI mismatch
#
# Exit codes:
#   0    everything succeeded or was skipped
#   101  the dotfiles did not update; the machine is still on its old release
#   102  the dotfiles updated, but updatems-system did not finish
#   100  completed with errors: snap or extras failed, or [mainstream] was switched off
#   105  held: the EFI partition is too full to rebuild the boot image safely; no package changed
#   106  the boot menu would not start the system and could not be repaired; do not restart
#   4    pacman refused: Arch's Qt moved past the desktop's pin; no package changed
#   N    pacman, AUR or flatpak exit code on a primary failure

set -u
# sudo -S reads the password line only when it asks for one, so no step may
# inherit a line it left unread.
[[ -t 0 ]] || exec </dev/null

# ── Resolve calling user ────────────────────────────────────────────────────
ORIG_USER="${SUDO_USER:-}"
if [[ -z "$ORIG_USER" && -n "${PKEXEC_UID:-}" ]]; then
    ORIG_USER=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
fi
if [[ -z "$ORIG_USER" || "$ORIG_USER" == "root" ]]; then
    echo "mainstream-update-helper: refusing to run without a non-root caller" >&2
    echo "  hint: invoke via sudo -S, not directly as root." >&2
    exit 1
fi
ORIG_HOME=$(getent passwd "$ORIG_USER" | cut -d: -f6)
if [[ -z "$ORIG_HOME" || ! -d "$ORIG_HOME" ]]; then
    echo "mainstream-update-helper: could not resolve home directory for $ORIG_USER" >&2
    exit 1
fi
# Lets the page tell a run that got this far from one sudo refused, in any locale.
echo "@@MAINSTREAM-UPDATE-HELPER-START"

# The caller's language, picked before LC_ALL is forced below for pacman.
if [[ -r /usr/local/lib/mainstream-tr.sh ]]; then
    # shellcheck source=/dev/null
    source /usr/local/lib/mainstream-tr.sh
    tr_init "$ORIG_USER"
    # Child scripts inherit the forced LC_ALL; this carries the user's language past it.
    export MAINSTREAM_UI_LANG="$MAINSTREAM_TR_LANG"
else
    t()  { printf '%s' "$1"; }
    tf() { local fmt="$1"; shift; printf -- "$fmt" "$@"; }
fi

# One run at a time: a second helper would remove the sudoers rule the first
# relies on, and two package managers would contend for the database.
exec 9>/run/lock/mainstream-update.lock
if ! flock -n 9; then
    echo ">>> $(t "Another update is already running. Let it finish, then try again.")"
    exit 3
fi
# Held by this shell alone: a child that outlives it, such as a git gc that
# detached, would otherwise keep every later update out.
{ enable -f /usr/lib/bash/fdflags fdflags && fdflags -s +cloexec 9; } 2>/dev/null

# ── Temp NOPASSWD + cleanup trap ────────────────────────────────────────────
# The name has no dots (sudoers.d skips files containing ".") and sorts after
# g_wheel: sudoers is last-match-wins, and its password rule must not win.
TEMP_SUDOERS="/etc/sudoers.d/99-mainstream-update-active"
LEGACY_SUDOERS="/etc/sudoers.d/00-mainstream-update-active"
rm -f "$TEMP_SUDOERS" "$LEGACY_SUDOERS"

cleanup() {
    rm -f "$TEMP_SUDOERS" "$LEGACY_SUDOERS" "${REBOOT_SESSION_LIST:-}"
    [[ -n "${TOPGRADE_SHIM:-}" ]] && rm -rf "$TOPGRADE_SHIM"
    # A stopped update can leave pacman's lock behind. Clear it only when nothing
    # holds it open, since libalpm keeps it open while a transaction owns it.
    local rc=0
    fuser -s /var/lib/pacman/db.lck 2>/dev/null || rc=$?
    if (( rc == 1 )); then
        rm -f /var/lib/pacman/db.lck 2>/dev/null
    fi
}
trap cleanup EXIT
# The controlling terminal, not stdin, which can be redirected while one is attached.
ON_TTY=0
{ : </dev/tty; } 2>/dev/null && ON_TTY=1
UNATTENDED=0
(( ON_TTY )) || ! command -v timeout >/dev/null 2>&1 || UNATTENDED=1
STEP_KILL_GRACE_SECS=10
STEP_PACMAN_WAIT_SECS=1800
STEP_PID=""
STEP_TIMER=""
STEP_LEAD=""
STEP_TIMED_OUT=0
STOPPING=0

# Unattended, a user step waits in the background so a stop trap fires at once.
# $1 is a time limit in seconds, 0 for none; reaching it stops the step like Stop.
user_step() {
    local limit="$1" rc done_pid="" stop_asked=0; shift
    STEP_TIMED_OUT=0
    STEP_LEAD=""
    if (( ! UNATTENDED )); then
        runuser -u "$ORIG_USER" -- "$@" 9>&-
        return
    fi
    # A stop is held until both pids are known.
    trap 'stop_asked=1' INT TERM HUP
    # timeout sets no limit here; it gives the step a process group of its own.
    runuser -u "$ORIG_USER" -- timeout 0 "$@" 9>&- &
    STEP_PID=$!
    if (( limit > 0 )); then
        sleep "$limit" 9>&- &
        STEP_TIMER=$!
    fi
    trap on_stop INT TERM HUP
    (( stop_asked )) && on_stop
    wait -n -p done_pid "$STEP_PID" ${STEP_TIMER:+"$STEP_TIMER"}
    rc=$?
    if [[ -n "$STEP_TIMER" && "$done_pid" == "$STEP_TIMER" ]]; then
        STEP_TIMER=""
        STEP_TIMED_OUT=1
        stop_user_step "$STEP_PID"
        wait "$STEP_PID"
        rc=124
    elif [[ -n "$STEP_TIMER" ]]; then
        kill "$STEP_TIMER" 2>/dev/null
    fi
    STEP_PID=""
    STEP_TIMER=""
    STEP_LEAD=""
    return "$rc"
}

# TERMs the processes in group $1 that match the pgrep filters after it, and
# KILLs whatever of them is left after the grace.
end_group() {
    local lead="$1" pids n; shift
    for (( n = 0; n <= STEP_KILL_GRACE_SECS; n++ )); do
        pids=$(pgrep -g "$lead" "$@" | grep -vx "$lead") || return 0
        if (( n == 0 )); then
            kill -TERM $pids 2>/dev/null
        elif (( n == STEP_KILL_GRACE_SECS )); then
            kill -KILL $pids 2>/dev/null
        fi
        sleep 1
    done
}

# The user's processes go first. sudo relays any signal to its command, so a
# root pacman is left to finish before the remaining root commands are ended.
stop_user_step() {
    local lead="$STEP_LEAD" n
    while [[ -z "$lead" ]] && kill -0 "$1" 2>/dev/null; do
        # timeout takes its own group before it forks the step.
        lead=$(pgrep -P "$1" -x timeout) && pgrep -P "$lead" >/dev/null || { lead=""; sleep 0.1; }
    done
    [[ -n "$lead" ]] || return 0
    STEP_LEAD=$lead
    end_group "$lead" -u "$ORIG_USER"
    for (( n = 0; n < STEP_PACMAN_WAIT_SECS; n++ )); do
        pgrep -g "$lead" -u root -x pacman >/dev/null || break
        sleep 1
    done
    pgrep -g "$lead" -u root -x pacman >/dev/null || end_group "$lead" -u root
}

# Stops instead of returning into the remaining steps with the sudoers rule
# gone. 143 is what the page reads as stopped.
on_stop() {
    trap '' INT TERM HUP
    [[ -n "$STEP_TIMER" ]] && kill "$STEP_TIMER" 2>/dev/null
    if [[ -n "$STEP_PID" ]]; then
        stop_user_step "$STEP_PID"
        wait "$STEP_PID" 2>/dev/null
    fi
    # A step that ran may have rebuilt the boot image, and the page has to
    # hear when the boot menu would not start it.
    STOPPING=1
    if (( ${BOOT_TOUCHED:-0} )) && [[ -z "${BOOT_RC:-}" ]]; then
        boot_postcheck
    fi
    # A stopped run may already have installed what needs a reboot.
    [[ -n "${REBOOT_SESSION_LIST:-}" ]] \
        && reboot_marker "" "$(reboot_check verdict "$HELPER_STARTED_AT" "$REBOOT_SESSION_LIST")"
    exit 143
}
trap on_stop INT TERM HUP
# The trap cannot run after SIGKILL or an OOM kill, so a separate unit sweeps
# the NOPASSWD rule once this process is gone.
if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --quiet --collect --unit="mainstream-update-sudoers-sweep-$$" \
        /bin/bash -c "while kill -0 $$ 2>/dev/null; do sleep 2; done; rm -f '$TEMP_SUDOERS' '$LEGACY_SUDOERS'" \
        2>/dev/null || true
fi

# pacman's messages are parsed below, and they are only stable in one language.
export LC_ALL=C.UTF-8

# A transaction cut short by shutdown or suspend can leave the kernel, modules
# and boot image from different releases, so both are blocked while pacman runs.
PACMAN_INHIBIT=()
if command -v systemd-inhibit >/dev/null 2>&1 && systemd-inhibit --list >/dev/null 2>&1; then
    PACMAN_INHIBIT=(systemd-inhibit --what=shutdown:sleep --mode=block --who="Mainstream OS" --why="Installing updates")
fi
pacman_tx() { "${PACMAN_INHIBIT[@]}" pacman "$@"; }

# A read-only root fails every step below in its own words, so say why once:
# a snapshot booted from the boot menu, or the kernel remounted it after an error.
root_mount="$(findmnt -no OPTIONS,SOURCE / 2>/dev/null || true)"
if [[ ",${root_mount%% *}," == *,ro,* ]]; then
    echo ">>> $(t "The system is mounted read-only, so nothing can be updated.")"
    if [[ "${root_mount#* }" == *"/.snapshots/"* || "${root_mount#* }" == *"@snapshots"* ]]; then
        echo ">>> $(t "It was started from a snapshot in the boot menu, which is always read-only. To get back to your normal system, reboot and in the boot menu choose the entry named \"linux\", the one sitting right underneath the Mainstream OS list. If you booted the snapshot to recover from a bad update, make it permanent first: Settings > Recovery > Restore Snapshot, then reboot into that \"linux\" entry and run the update again.")"
    else
        echo ">>> $(t "The filesystem took itself read-only, which it does after an error. Reboot, then run the update again. If it happens again, the disk needs checking: Settings > Recovery, or from a terminal \"sudo dmesg | grep -i btrfs\" shows what went wrong.")"
    fi
    exit 1
fi

# Every pacman step would fail against another package manager's lock, and the
# exit trap must never clear a lock a live process owns.
if [[ -e /var/lib/pacman/db.lck ]] && pgrep -x pacman >/dev/null 2>&1; then
    echo ">>> $(t "Another package manager is running (pacman database is locked). Let it finish or stop it, then run the update again.")"
    exit 1
fi

# NOPASSWD: ALL, not just pacman and makepkg: topgrade's extras sudo many tools,
# and a prompt with no TTY hangs. The rule exists only while the helper runs.
# verifypw=any: yay's `sudo -v` skips the prompt when any matching rule is NOPASSWD.
cat > "$TEMP_SUDOERS" << EOF
Defaults:$ORIG_USER verifypw = any
$ORIG_USER ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 "$TEMP_SUDOERS"

# In pacman.log's format, so the verdict can pick out what this run installed.
# The check runs as the caller: it reads that user's own processes.
HELPER_STARTED_AT="$(date '+%Y-%m-%dT%H:%M:%S%z')"
REBOOT_CHECK="$ORIG_HOME/.config/quickshell/ii/scripts/update/reboot-check.sh"
_reboot_check_run() {  # stdin passes through
    runuser -u "$ORIG_USER" -- env HOME="$ORIG_HOME" bash "$REBOOT_CHECK" "$@" 2>/dev/null 9>&-
}
reboot_check() {  # $1 = mode, rest = args
    [[ -r "$REBOOT_CHECK" ]] || { echo 0; return 0; }
    _reboot_check_run "$@" || echo 0
}
# The two markers the Settings page reads: PLAN before anything is replaced,
# then the verdict at the end.
reboot_marker() {  # $1 = PLAN|""  $2 = the check's output
    local flag="${2%%$'\n'*}" reasons
    reasons="$(printf '%s\n' "$2" | tail -n +2 | tr '\n' ' ')"
    reasons="${reasons% }"
    printf '@@MAINSTREAM-UPDATE-REBOOT%s %s%s\n' "${1:+-$1}" "${flag:-0}" "${reasons:+ $reasons}"
}
# Recorded before anything is replaced: afterwards the files the session still
# holds are gone from disk and from the package database.
REBOOT_SESSION_LIST="$(mktemp)"
if [[ -r "$REBOOT_CHECK" ]]; then
    _reboot_check_run session > "$REBOOT_SESSION_LIST" || true
    chmod 0644 "$REBOOT_SESSION_LIST" 2>/dev/null || true
fi

# ── Parse flags ─────────────────────────────────────────────────────────────
SKIP_SYSTEM=0
SKIP_AUR=0
SKIP_FLATPAK=0
SKIP_SNAP=0
SKIP_DOTFILES=0
EDGE=0
SKIP_EXTRAS=0
SKIP_FIRMWARE=0
AUTO_REBUILD_QS=0
TOPGRADE_EXTRA_ARGS=()
# Everything after a bare -- goes to topgrade as is: the page sends the Advanced
# field's words there, and topgrade's own options start with -- too.
_topgrade_rest=0
for arg in "$@"; do
    if (( _topgrade_rest )); then
        TOPGRADE_EXTRA_ARGS+=("$arg")
        continue
    fi
    case "$arg" in
        --)                         _topgrade_rest=1 ;;
        --skip-system)              SKIP_SYSTEM=1 ;;
        --skip-aur)                 SKIP_AUR=1 ;;
        --skip-flatpak)             SKIP_FLATPAK=1 ;;
        --skip-snap)                SKIP_SNAP=1 ;;
        --skip-dotfiles)            SKIP_DOTFILES=1 ;;
        --skip-extras)              SKIP_EXTRAS=1 ;;
        --skip-firmware)            SKIP_FIRMWARE=1 ;;
        --edge)                     EDGE=1 ;;
        --auto-rebuild-quickshell)  AUTO_REBUILD_QS=1 ;;
        --*)
            # Usually a newer Settings page and an older helper: the ISO's copy only
            # catches up when updatems-system runs during the first update. Never
            # forward it to topgrade, which would hide the skew.
            echo "$(t "Unknown option:") $arg" >&2
            echo "$(t "This build of the update helper does not support it. Run an update without it once to refresh the helper, then try again.")" >&2
            exit 2
            ;;
        *)                          TOPGRADE_EXTRA_ARGS+=("$arg") ;;
    esac
done

# A graphical askpass fails fast instead of hanging. An empty SUDO_PROMPT drops
# sudo's password header, which amid yay's output looks like a blocking prompt.
export SUDO_ASKPASS=/bin/false
export SUDO_PROMPT=""

PACMAN_RC=0
AUR_RC=0
FLATPAK_RC=0
SNAP_RC=0
DOTFILES_RC=0
DOTFILES_SYS_RC=0
QT_PIN_HELD=0
TOPGRADE_RC=0
AUR_NOTE=""
FLATPAK_NOTE=""
SNAP_NOTE=""
DOTFILES_NOTE=""
TOPGRADE_NOTE=""
MAINSTREAM_REPO_OFFLINE=0
BOOT_HELD=0
# Set once a step that can rebuild the boot image has started.
BOOT_TOUCHED=0
# Empty until the boot menu has been checked after the update.
BOOT_RC=""

# limine-mkinitcpio reports success even when limine.conf could not be saved,
# so the hashes the menu pins decide.
boot_postcheck() {
    local stop_asked=0
    command -v mainstream-boot-verify >/dev/null 2>&1 || return 0
    echo ""
    echo "── $(t "Checking that the boot menu can start the system...")"
    # A Stop waits for the answer. An ignored signal would pass to the rebuild it may start.
    trap 'stop_asked=1' INT TERM HUP
    mainstream-boot-verify --repair
    BOOT_RC=$?
    # The page blocks its reboot prompt on either marker.
    if [[ "$BOOT_RC" -eq 1 ]]; then
        echo "@@MAINSTREAM-UPDATE-BOOT-BROKEN 1"
        echo ">>> $(t "Do not restart yet. The boot menu does not match the system's boot image, so the computer would not start. Free some space on the EFI partition, then run the update again: it repairs the boot menu first.")"
    elif [[ "$BOOT_RC" -eq 3 ]]; then
        echo "@@MAINSTREAM-UPDATE-BOOT-BROKEN 3"
        echo ">>> $(tf "Do not restart yet. The boot menu still starts a kernel that is no longer installed, so the computer would start without its drivers. Run \"%s\" in a terminal to build the boot image for the installed kernel. If it says the EFI partition is full, free some space on it and run it again." "sudo limine-mkinitcpio")"
    fi
    if (( STOPPING )); then
        trap '' INT TERM HUP
    else
        trap on_stop INT TERM HUP
        (( stop_asked )) && on_stop
    fi
    return 0
}

# ── 0. Boot menu, before anything can rebuild the boot image ────────────────
# Mends an entry Limine would refuse and keeps a copy of the working image. It
# holds the package step when the EFI partition is too full and no copy exists.
if [[ "$SKIP_SYSTEM" -eq 0 || "$SKIP_AUR" -eq 0 || "$SKIP_DOTFILES" -eq 0 ]] \
   && command -v mainstream-boot-verify >/dev/null 2>&1; then
    echo ""
    echo "── $(t "Checking the boot menu before updating...")"
    mainstream-boot-verify --preflight
    [[ $? -eq 2 ]] && BOOT_HELD=1
fi

# ── 1. System + [mainstream] packages (pacman) ──────────────────────────────
if [[ "$SKIP_SYSTEM" -eq 0 && "$BOOT_HELD" -eq 0 ]]; then
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  $(t "System & [mainstream] packages — pacman -Syu")"
    echo "═══════════════════════════════════════════════════════════"
    PACMAN_LOG=$(mktemp)
    # Says up front whether arriving packages replace parts of the running desktop.
    # --noconfirm: stdin is /dev/null, so a provider prompt would read EOF and empty
    # the plan. The repeated database refresh is deliberate.
    PLAN_OUT="$(pacman -Syu --print --print-format '%n' --noconfirm </dev/null 2>/dev/null | reboot_check plan "$REBOOT_SESSION_LIST")"
    reboot_marker PLAN "$PLAN_OUT"
    if [[ "${PLAN_OUT%%$'\n'*}" == 1 ]]; then
        echo ">>> $(t "This update replaces parts of the running desktop. A reboot will be needed when it finishes.")"
    fi
    BOOT_TOUCHED=1
    pacman_tx -Syu --noconfirm 2>&1 | tee "$PACMAN_LOG"
    PACMAN_RC=${PIPESTATUS[0]}
    if [[ "$PACMAN_RC" -ne 0 ]]; then
        # An untrusted [mainstream] key aborts the whole transaction, core and extra
        # included. The key is already on disk, so repair it in place and retry.
        if grep -qE 'key "[^"]*" is unknown|missing required signature|could not be looked up remotely|GPGME error|invalid or corrupted database \(PGP signature\)|signature from .* is (unknown|marginal) trust' "$PACMAN_LOG"; then
            echo ""
            echo "── $(t "The [mainstream] signing key is not trusted here, which blocks every repository. Repairing the keyring and retrying...")"
            if [[ -x /usr/local/bin/mainstream-keyring-repair ]]; then
                /usr/local/bin/mainstream-keyring-repair
            elif [[ -x /usr/local/bin/mainstream-keyring-init ]]; then
                /usr/local/bin/mainstream-keyring-init
            else
                echo "   $(t "No repair tool on this machine, importing the key directly.")"
                pacman-key --add /usr/local/share/mainstream.pub \
                    && pacman-key --lsign-key D644BEB9C1B7668E3A6C16DA8D567345B265848E \
                    && pacman-key --updatedb
                rm -f /var/lib/pacman/sync/mainstream.db*
            fi
            pacman_tx -Syu --noconfirm 2>&1 | tee "$PACMAN_LOG"
            PACMAN_RC=${PIPESTATUS[0]}
            if [[ "$PACMAN_RC" -ne 0 ]] \
               && grep -qE 'key "[^"]*" is unknown|missing required signature|invalid or corrupted database \(PGP signature\)' "$PACMAN_LOG"; then
                # Never fall back to SigLevel = Never. Switching the repo off until
                # mainstream-keyring-repair keeps the rest of the system updating.
                echo ""
                echo "── $(t "Still unverified. Taking [mainstream] out of this run so the rest of the system can still update.")"
                if [[ -x /usr/local/bin/mainstream-keyring-init ]]; then
                    /usr/local/bin/mainstream-keyring-init --disable-mainstream
                else
                    awk -v tag='#MSKEY#' '
                        /^\[mainstream\]/ { inblock = 1; print tag $0; next }
                        /^\[/             { inblock = 0 }
                        inblock && NF     { print tag $0; next }
                        { print }
                    ' /etc/pacman.conf > /etc/pacman.conf.mskey-tmp \
                        && cat /etc/pacman.conf.mskey-tmp > /etc/pacman.conf
                    rm -f /etc/pacman.conf.mskey-tmp
                fi
                MAINSTREAM_REPO_OFFLINE=1
                pacman_tx -Syu --noconfirm
                PACMAN_RC=$?
            fi
        fi
    fi
    # The desktop is pinned to one Qt minor release. Once Arch moves past it, pacman
    # refuses the whole transaction, changing nothing, until the rebuilt desktop is
    # published, so a retry would only repeat that.
    if [[ "$PACMAN_RC" -ne 0 && "$MAINSTREAM_REPO_OFFLINE" -eq 0 ]] \
       && grep -qE "(breaks dependency|unable to satisfy dependency) 'qt6-base<[^']*' required by mainstream-quickshell-git" "$PACMAN_LOG"; then
        echo ""
        echo ">>> $(t "Nothing was changed. Arch has moved to a newer Qt than this desktop is built for, and taking it now would break the desktop. The update will go through once the matching desktop update is published.")"
        # Flatpak, Snap and the system half do not depend on Qt, so they
        # still run; what builds on the package set waits with it.
        QT_PIN_HELD=1
    elif [[ "$PACMAN_RC" -ne 0 ]]; then
        # When one of our packages starts shipping a file an older install wrote directly,
        # pacman refuses before any scriptlet runs. If every conflict is a mainstream
        # package on an unowned path, retry overwriting exactly those.
        mapfile -t _conflicts < <(grep -E '^[[:alnum:]@._+-]+: /.+ exists in filesystem$' "$PACMAN_LOG")
        _ow_args=()
        if [[ ${#_conflicts[@]} -gt 0 ]]; then
            _adoptable=1
            for _line in "${_conflicts[@]}"; do
                _pkg="${_line%%:*}"
                _path="${_line#*: }"
                _path="${_path% exists in filesystem}"
                if [[ "$_pkg" != mainstream-* ]] || pacman -Qo -- "$_path" >/dev/null 2>&1; then
                    _adoptable=0
                    break
                fi
                _ow_args+=(--overwrite "$_path")
            done
            if [[ "$_adoptable" -eq 1 ]]; then
                echo ""
                echo "── $(t "A mainstream package now owns files an older install placed directly on disk. Adopting them and retrying...")"
                pacman_tx -Syu --noconfirm "${_ow_args[@]}"
                PACMAN_RC=$?
            else
                # Someone else's package wants an unowned path, often left by a vendor
                # installer. Overwriting could lose what is there, so the choice stays
                # with the person: name the paths and the command.
                echo ""
                echo "── $(t "Update stopped: a package wants files that are already on disk and belong to no package. That usually means the software was installed by its own installer before it was packaged here.")"
                echo ""
                for _line in "${_conflicts[@]}"; do
                    _pkg="${_line%%:*}"
                    _path="${_line#*: }"
                    _path="${_path% exists in filesystem}"
                    echo "   $(tf "%s belongs to no package; %s wants it." "$_path" "$_pkg")"
                done
                echo ""
                echo "   $(t "Look at what is there before deciding. If it is empty, or you do not need it, let the package take it over:")"
                echo ""
                printf "     sudo pacman -Syu"
                for _line in "${_conflicts[@]}"; do
                    _path="${_line#*: }"
                    printf " --overwrite '%s'" "${_path% exists in filesystem}"
                done
                echo ""
            fi
        fi
        if [[ "$PACMAN_RC" -ne 0 ]]; then
            echo ""
            echo "── $(t "pacman failed (corrupted cache or busy database are the usual transient causes) — retrying once...")"
            sleep 5
            pacman_tx -Syu --noconfirm
            PACMAN_RC=$?
        fi
    fi
    rm -f "$PACMAN_LOG"
elif [[ "$BOOT_HELD" -eq 1 && "$SKIP_SYSTEM" -eq 0 ]]; then
    echo ""
    echo ">>> $(t "System packages were held back. The EFI partition, which holds the boot menu and the system's boot image, is nearly full, and no copy of the working boot image could be kept, so this update could leave the computer unable to start. Free some space on it, then run the update again.")"
    # What builds on the package set waits with it, as after a failed pacman.
    PACMAN_RC=105
else
    echo ""
    echo "── $(t "System packages: skipped (per --skip-system)")"
fi

# ── 2. AUR (yay or paru) ────────────────────────────────────────────────────
# Anything built on the package set waits for it: a failed -Syu already refreshed
# the databases, so building now would be a partial upgrade.
PKG_STEP_FAILED=0
[[ "$SKIP_SYSTEM" -eq 0 && "${PACMAN_RC:-0}" -ne 0 ]] && PKG_STEP_FAILED=1
if [[ "$SKIP_AUR" -eq 0 && "$BOOT_HELD" -eq 1 ]]; then
    echo ""
    echo "── $(t "AUR: waiting for the system packages, which were held back.")"
    AUR_NOTE=held
elif [[ "$SKIP_AUR" -eq 0 && "$PKG_STEP_FAILED" -eq 1 ]]; then
    echo ""
    echo "── $(t "AUR: deferred — the system package update failed.")"
    AUR_NOTE=deferred
elif [[ "$SKIP_AUR" -eq 0 ]]; then
    BOOT_TOUCHED=1
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    if command -v yay >/dev/null 2>&1; then
        echo "  $(t "AUR packages — yay -Sua")"
        echo "═══════════════════════════════════════════════════════════"
        user_step 0 env HOME="$ORIG_HOME" yay -Sua --noconfirm
        AUR_RC=$?
    elif command -v paru >/dev/null 2>&1; then
        echo "  $(t "AUR packages — paru -Sua")"
        echo "═══════════════════════════════════════════════════════════"
        user_step 0 env HOME="$ORIG_HOME" paru -Sua --noconfirm
        AUR_RC=$?
    else
        echo "  $(t "AUR: no helper (yay/paru) installed — skipping")"
        echo "═══════════════════════════════════════════════════════════"
        AUR_NOTE=absent
    fi
else
    echo ""
    echo "── $(t "AUR: skipped (per --skip-aur)")"
fi

# ── 3. Flatpak (system + user) ──────────────────────────────────────────────
if [[ "$SKIP_FLATPAK" -eq 0 ]] && command -v flatpak >/dev/null 2>&1; then
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  $(t "Flatpak — flatpak update (system + user)")"
    echo "═══════════════════════════════════════════════════════════"
    # flatpak does not retry a reset download, so one dropped transfer ends the run;
    # retry once here. Connect and resolve failures are excluded: flatpak already
    # tries those five times.
    FLATPAK_LOG=$(mktemp)
    FP_NO_RETRY='While fetching .*: \[(5|6|7)\]|Could not resolve host|Could not connect to server'

    # The output only decides whether to retry. The code returned is the update's
    # own, so a fetch warning can never turn a failure into a success.
    flatpak_leg() {
        local scope="$1" rc
        : > "$FLATPAK_LOG"
        if [[ "$scope" == system ]]; then
            flatpak update --noninteractive --system 2>&1 | tee "$FLATPAK_LOG"
            rc=${PIPESTATUS[0]}
        else
            runuser -u "$ORIG_USER" -- env HOME="$ORIG_HOME" \
                flatpak update --noninteractive --user 9>&- 2>&1 | tee "$FLATPAK_LOG"
            rc=${PIPESTATUS[0]}
        fi
        if [[ "$rc" -ne 0 ]] && ! grep -qE "$FP_NO_RETRY" "$FLATPAK_LOG"; then
            echo ""
            echo "── $(t "Flatpak did not finish (a dropped download is the usual cause), retrying once...")"
            sleep 5
            if [[ "$scope" == system ]]; then
                flatpak update --noninteractive --system
                rc=$?
            else
                runuser -u "$ORIG_USER" -- env HOME="$ORIG_HOME" \
                    flatpak update --noninteractive --user 9>&-
                rc=$?
            fi
        fi
        return "$rc"
    }

    # Each half is labeled: their outputs run together, and an error beside the
    # other's "Nothing to update." reads as one run contradicting itself.
    echo ""
    echo "── $(t "Flatpak: apps installed for everyone")"
    flatpak_leg system
    FP_SYS_RC=$?
    echo ""
    echo "── $(t "Flatpak: apps installed for you only")"
    flatpak_leg user
    FP_USR_RC=$?
    rm -f "$FLATPAK_LOG"
    if [[ "$FP_SYS_RC" -ne 0 ]]; then
        FLATPAK_RC="$FP_SYS_RC"
    elif [[ "$FP_USR_RC" -ne 0 ]]; then
        FLATPAK_RC="$FP_USR_RC"
    fi
elif [[ "$SKIP_FLATPAK" -ne 0 ]]; then
    echo ""
    echo "── $(t "Flatpak: skipped (per --skip-flatpak)")"
else
    FLATPAK_NOTE=absent
fi

# ── 4. Snap (refresh as root, bypasses polkit) ──────────────────────────────
# Run here as root: snapd gates refresh behind polkit, which the sudoers rule does
# not cover, so a user-level refresh would hang on a prompt. topgrade gets
# --disable snap below.
if [[ "$SKIP_SNAP" -eq 0 ]] && command -v snap >/dev/null 2>&1; then
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  $(t "Snap packages — snap refresh")"
    echo "═══════════════════════════════════════════════════════════"
    snap refresh
    SNAP_RC=$?
elif [[ "$SKIP_SNAP" -ne 0 ]]; then
    echo ""
    echo "── $(t "Snap: skipped (per --skip-snap)")"
else
    SNAP_NOTE=absent
fi

# ── 5. Mainstream dotfiles (updatems) ───────────────────────────────────────
if [[ "$SKIP_DOTFILES" -eq 0 && "$QT_PIN_HELD" -eq 1 ]]; then
    # The root files the clone already holds match the desktop in place, so
    # installing them still finishes an update whose system half did not run.
    echo ""
    echo "── $(t "Dotfiles: waiting for the desktop update that matches the new Qt.")"
    if command -v updatems-system >/dev/null 2>&1 && [[ -d "$ORIG_HOME/.cache/dots-hyprland/.git" ]]; then
        BOOT_TOUCHED=1
        echo ""
        echo "── $(t "Mainstream system bits — updatems-system")"
        updatems-system "$ORIG_HOME/.cache/dots-hyprland"
        DOTFILES_SYS_RC=$?
    fi
elif [[ "$SKIP_DOTFILES" -eq 0 && "$BOOT_HELD" -eq 1 ]]; then
    # Its root half can rebuild the boot image, which the hold is there to prevent.
    echo ""
    echo "── $(t "Dotfiles: waiting for the system packages, which were held back.")"
    DOTFILES_NOTE=held
elif [[ "$SKIP_DOTFILES" -eq 0 && "$SKIP_SYSTEM" -eq 0 && "${PACMAN_RC:-0}" -ne 0 ]]; then
    echo ""
    echo "── $(t "Dotfiles: deferred — the system package update failed, and dotfile releases can depend on packages it would have installed. Re-run the update once the package step succeeds.")"
    DOTFILES_NOTE=deferred
elif [[ "$SKIP_DOTFILES" -eq 0 ]] && command -v updatems >/dev/null 2>&1; then
    BOOT_TOUCHED=1
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  $(t "Mainstream dotfiles — updatems")"
    echo "═══════════════════════════════════════════════════════════"
    _ums_args=()
    [[ "$EDGE" -eq 1 ]] && _ums_args+=(--edge)
    runuser -u "$ORIG_USER" -- env HOME="$ORIG_HOME" updatems "${_ums_args[@]}" 9>&-
    DOTFILES_RC=$?

    # ── 5b. System-level dotfiles bits (updatems-system) ───────────────────
    if [[ "$DOTFILES_RC" -ne 0 ]]; then
        echo ""
        echo "── $(t "Mainstream system bits: skipped — updatems did not finish, so the release's root-owned files stay at the version that matches the desktop.")"
        DOTFILES_SYS_RC=$DOTFILES_RC
    elif command -v updatems-system >/dev/null 2>&1; then
        echo ""
        echo "── $(t "Mainstream system bits — updatems-system")"
        updatems-system "$ORIG_HOME/.cache/dots-hyprland"
        DOTFILES_SYS_RC=$?
    fi
elif [[ "$SKIP_DOTFILES" -ne 0 ]]; then
    echo ""
    echo "── $(t "Dotfiles: skipped (per --skip-dotfiles)")"
fi

# ── 5c. Boot menu, after the last step that can rebuild the boot image ─────
# Before the extras, which can run for hours, so the answer is not held back.
boot_postcheck

# ── 6. Extras (topgrade for developer ecosystems) ───────────────────────────
# Room for large Proton downloads without holding the sudo rule open all day.
# Flatpak sandboxes (ProtonPlus) are outside its reach and finish on their own.
TOPGRADE_TIMEOUT_SECS=7200

# ProtonPlus refuses Proton updates unless flatpak-spawn --host reaches the
# session bus, which runuser does not set up.
topgrade_session_env() {
    TOPGRADE_USER_ENV=("HOME=$ORIG_HOME" "SUDO_ASKPASS=/bin/false")
    local uid rtd
    uid=$(id -u "$ORIG_USER" 2>/dev/null) || return 0
    rtd="/run/user/$uid"
    runuser -u "$ORIG_USER" -- test -S "$rtd/bus" 2>/dev/null 9>&- || return 0
    TOPGRADE_USER_ENV+=("XDG_RUNTIME_DIR=$rtd" "DBUS_SESSION_BUS_ADDRESS=unix:path=$rtd/bus")
}

# topgrade's shipped config names pkexec, which asks polkit on the desktop for
# each root step; this stand-in sends them through the update's sudo rule.
TOPGRADE_SHIM=""
topgrade_pkexec_shim() {
    TOPGRADE_SHIM=$(mktemp -d /run/mainstream-update-shim.XXXXXX) || return 0
    chmod 755 "$TOPGRADE_SHIM"
    cat > "$TOPGRADE_SHIM/pkexec" <<'EOF'
#!/bin/sh
# pacman is the helper's own step, so a pkexec call to it still asks.
case "${1##*/}" in pacman) exec /usr/bin/pkexec "$@" ;; esac
if [ "$1" = --user ]; then u=$2; shift 2; exec sudo -n -u "$u" -- "$@"; fi
exec sudo -n -- "$@"
EOF
    chmod 755 "$TOPGRADE_SHIM/pkexec"
    TOPGRADE_USER_ENV+=("PATH=$TOPGRADE_SHIM:$PATH")
}

if [[ "$SKIP_EXTRAS" -eq 0 && "$BOOT_HELD" -eq 1 ]]; then
    echo ""
    echo "── $(t "Developer extras: waiting for the system packages, which were held back.")"
    TOPGRADE_NOTE=held
elif [[ "$SKIP_EXTRAS" -eq 0 && "$PKG_STEP_FAILED" -eq 1 ]]; then
    echo ""
    echo "── $(t "Developer extras: deferred — the system package update failed.")"
    TOPGRADE_NOTE=deferred
elif [[ "$SKIP_EXTRAS" -eq 0 ]] && command -v topgrade >/dev/null 2>&1; then
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  $(t "Developer extras — topgrade (cargo, pipx, npm, nix, …)")"
    echo "═══════════════════════════════════════════════════════════"
    # Sections 1 to 4 cover system, flatpak and snap. lensfun can hang for an hour
    # on a slow mirror; `topgrade --only lensfun` runs it by hand.
    TG_DISABLED=(system flatpak snap lensfun)
    if [[ "$SKIP_FIRMWARE" -eq 1 ]]; then
        TG_DISABLED+=(firmware)
    fi
    # With its system step off, topgrade runs needrestart itself, which pacman's
    # hook already did in section 1.
    if [[ "$SKIP_SYSTEM" -eq 0 ]] && [[ -e /usr/share/libalpm/hooks/needrestart.hook || -e /etc/pacman.d/hooks/needrestart.hook ]]; then
        TG_DISABLED+=(restarts)
    fi
    # The Advanced field's words go first: a bare word after --disable would join its list.
    TG_ARGS=("${TOPGRADE_EXTRA_ARGS[@]}" --cleanup --yes)
    for _step in "${TG_DISABLED[@]}"; do
        TG_ARGS+=(--disable "$_step")
    done
    topgrade_session_env
    topgrade_pkexec_shim
    user_step "$TOPGRADE_TIMEOUT_SECS" \
        env -u XDG_RUNTIME_DIR -u DBUS_SESSION_BUS_ADDRESS \
        "${TOPGRADE_USER_ENV[@]}" \
        topgrade "${TG_ARGS[@]}"
    TOPGRADE_RC=$?
    if (( STEP_TIMED_OUT )); then
        # An argument, so a translation cannot alter the command.
        printf -v TG_BY_HAND '%q ' topgrade "${TOPGRADE_EXTRA_ARGS[@]}" --cleanup --disable "${TG_DISABLED[@]}"
        echo ""
        echo ">>> $(tf "Developer extras: stopped after %s minutes without finishing. Everything before this step is already installed. Run \"%s\" in a terminal to see what it was waiting on." "$(( TOPGRADE_TIMEOUT_SECS / 60 ))" "${TG_BY_HAND% }")"
    fi
elif [[ "$SKIP_EXTRAS" -ne 0 ]]; then
    echo ""
    echo "── $(t "Developer extras: skipped (per --skip-extras)")"
else
    TOPGRADE_NOTE=absent
fi

# ── 7. Quickshell ABI mismatch follow-up ────────────────────────────────────
# Same ABI test pacman's quickshell-check.hook runs; non-zero means Quickshell
# needs a rebuild against the new Qt.
if [[ "$AUTO_REBUILD_QS" -eq 1 && "$PKG_STEP_FAILED" -eq 0 ]] && [[ -x /usr/bin/quickshell ]]; then
    if ! runuser -u "$ORIG_USER" -- env HOME="$ORIG_HOME" \
            /usr/bin/quickshell --private-check-compat >/dev/null 2>&1 9>&-; then
        QS_PKG=$(pacman -Qoq /usr/bin/quickshell 2>/dev/null | head -1)
        QS_PKGBUILD_DIR="$ORIG_HOME/.cache/dots-hyprland/sdata/dist-arch/mainstream-quickshell-git"
        if [[ -n "$QS_PKG" ]] && [[ -f "$QS_PKGBUILD_DIR/PKGBUILD" ]]; then
            echo ""
            echo "═══════════════════════════════════════════════════════════"
            echo "  $(tf "Quickshell ABI mismatch — rebuilding %s (%s)" "$QS_PKG" makepkg)"
            echo "═══════════════════════════════════════════════════════════"
            if user_step 0 env HOME="$ORIG_HOME" \
                bash -c "cd '$QS_PKGBUILD_DIR' && makepkg -Afsi --noconfirm"; then
                echo ">>> $(t "Restart Quickshell to pick up the new binary.")"
            else
                echo ">>> $(t "Quickshell rebuild failed; the running binary is unchanged. Re-run the update after fixing the build.")"
            fi
        elif [[ -n "$QS_PKG" ]] && command -v yay >/dev/null 2>&1; then
            echo ""
            echo "═══════════════════════════════════════════════════════════"
            echo "  $(tf "Quickshell ABI mismatch — rebuilding %s (%s)" "$QS_PKG" yay)"
            echo "═══════════════════════════════════════════════════════════"
            if user_step 0 env HOME="$ORIG_HOME" \
                yay -S --rebuildtree --noconfirm "$QS_PKG"; then
                echo ">>> $(t "Restart Quickshell to pick up the new binary.")"
            else
                echo ">>> $(t "Quickshell rebuild failed; the running binary is unchanged. Re-run the update after fixing the build.")"
            fi
        elif [[ -n "$QS_PKG" ]] && command -v paru >/dev/null 2>&1; then
            echo ""
            echo "═══════════════════════════════════════════════════════════"
            echo "  $(tf "Quickshell ABI mismatch — rebuilding %s (%s)" "$QS_PKG" paru)"
            echo "═══════════════════════════════════════════════════════════"
            if user_step 0 env HOME="$ORIG_HOME" \
                paru -S --rebuildtree --noconfirm "$QS_PKG"; then
                echo ">>> $(t "Restart Quickshell to pick up the new binary.")"
            else
                echo ">>> $(t "Quickshell rebuild failed; the running binary is unchanged. Re-run the update after fixing the build.")"
            fi
        elif [[ -n "$QS_PKG" ]]; then
            echo ""
            echo ">>> $(tf "Quickshell ABI mismatch detected. Run a full update (or pacman -Syu) once the [mainstream] repo ships a rebuilt %s." "$QS_PKG")"
        fi
    fi
fi

# ── 8. Summary + exit code ──────────────────────────────────────────────────
# The summary is for reading; the page relies on the exit code and markers.
# $3 marks a step that did not run: "absent" (its tool is not installed), "deferred" or "held".
status_for() {
    local skip="$1" rc="$2" note="${3:-}"
    if [[ "$skip" -eq 1 ]]; then
        echo "$(t "skipped")"
    elif [[ "$note" == absent ]]; then
        echo "$(t "not installed")"
    elif [[ "$note" == deferred ]]; then
        echo "$(t "deferred (system update failed)")"
    elif [[ "$note" == held ]]; then
        echo "$(t "waiting for the system packages")"
    elif [[ "$rc" -eq 0 ]]; then
        echo "$(t "ok")"
    else
        echo "$(tf "FAILED (rc=%s)" "$rc")"
    fi
}
# Judged from what this run actually installed and from what is already
# replaced beneath the session, whichever step did it.
VERDICT_OUT="$(reboot_check verdict "$HELPER_STARTED_AT" "$REBOOT_SESSION_LIST")"
reboot_marker "" "$VERDICT_OUT"
REBOOT_NEEDED=0; [[ "${VERDICT_OUT%%$'\n'*}" == 1 ]] && REBOOT_NEEDED=1

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  $(t "Summary")"
echo "═══════════════════════════════════════════════════════════"
if [[ "$BOOT_HELD" -eq 1 && "$SKIP_SYSTEM" -eq 0 ]]; then
    printf "  %-30s %s\n" "$(t "System packages (pacman):")" "$(t "held (EFI partition nearly full)")"
else
    printf "  %-30s %s\n" "$(t "System packages (pacman):")" "$(status_for "$SKIP_SYSTEM" "$PACMAN_RC")"
fi
printf "  %-30s %s\n" "$(t "AUR (yay/paru):")"               "$(status_for "$SKIP_AUR"      "$AUR_RC" "$AUR_NOTE")"
printf "  %-30s %s\n" "$(t "Flatpak:")"                      "$(status_for "$SKIP_FLATPAK"  "$FLATPAK_RC" "$FLATPAK_NOTE")"
printf "  %-30s %s\n" "$(t "Snap:")"                         "$(status_for "$SKIP_SNAP"     "$SNAP_RC" "$SNAP_NOTE")"
if [[ "$QT_PIN_HELD" -eq 1 ]]; then
    printf "  %-30s %s\n" "$(t "Dotfiles (updatems):")"          "$(t "waiting for the desktop update")"
    printf "  %-30s %s\n" "$(t "System bits (updatems-system):")" "$(status_for "$SKIP_DOTFILES" "$DOTFILES_SYS_RC")"
else
    printf "  %-30s %s\n" "$(t "Dotfiles (updatems):")"          "$(status_for "$SKIP_DOTFILES" "$DOTFILES_RC" "$DOTFILES_NOTE")"
    printf "  %-30s %s\n" "$(t "System bits (updatems-system):")" "$(status_for "$SKIP_DOTFILES" "$DOTFILES_SYS_RC" "$DOTFILES_NOTE")"
fi
printf "  %-30s %s\n" "$(t "Developer extras (topgrade):")"  "$(status_for "$SKIP_EXTRAS"   "$TOPGRADE_RC" "$TOPGRADE_NOTE")"
if [[ -n "$BOOT_RC" ]]; then
    case "$BOOT_RC" in
        0) BOOT_STATUS="$(t "ok")"
           [[ "$BOOT_HELD" -eq 1 ]] && BOOT_STATUS="$(t "EFI partition nearly full")" ;;
        1) BOOT_STATUS="$(t "WOULD NOT START, do not restart")" ;;
        3) BOOT_STATUS="$(t "starts a kernel that is no longer installed, do not restart")" ;;
        4) BOOT_STATUS="$(t "not checked, the EFI partition was busy or unreadable")" ;;
        *) BOOT_STATUS="$(tf "FAILED (rc=%s)" "$BOOT_RC")" ;;
    esac
    printf "  %-30s %s\n" "$(t "Boot menu:")" "$BOOT_STATUS"
fi
if [[ "$BOOT_RC" == 1 || "$BOOT_RC" == 3 ]]; then
    printf "  %-30s %s\n" "$(t "Reboot:")" "$(t "not until the boot menu is repaired")"
elif [[ "$REBOOT_NEEDED" -eq 1 ]]; then
    printf "  %-30s %s\n" "$(t "Reboot:")" "$(t "required")"
else
    printf "  %-30s %s\n" "$(t "Reboot:")" "$(t "not needed")"
fi
if [[ "$MAINSTREAM_REPO_OFFLINE" -eq 1 ]]; then
    printf "  %-30s %s\n" "$(t "[mainstream] repo:")" "$(t "off (untrusted key)")"
    echo ""
    echo ">>> $(t "[mainstream] is switched off because its signing key could not be verified. Everything else updated. To bring it back, run:")"
    echo ">>>     sudo mainstream-keyring-repair"
fi

# Primary failures (pacman, AUR, flatpak) return their own code. Snap and extras
# are soft: 100, which the page shows as success while the summary marks the step.
# The Qt pin hold comes first so the page can say why the desktop did not update.
# Only a boot menu that would not start the system outranks it.
if [[ "$BOOT_RC" == 1 ]]; then exit 106; fi
if [[ "$QT_PIN_HELD" -eq 1 ]]; then exit 4; fi
if [[ "$BOOT_HELD" -eq 1 ]]; then exit 105; fi
if [[ "$SKIP_SYSTEM"   -ne 1 ]] && [[ "$PACMAN_RC"       -ne 0 ]]; then exit "$PACMAN_RC";   fi
if [[ "$SKIP_AUR"      -ne 1 ]] && [[ "$AUR_RC"          -ne 0 ]]; then exit "$AUR_RC";      fi
if [[ "$SKIP_FLATPAK"  -ne 1 ]] && [[ "$FLATPAK_RC"      -ne 0 ]]; then exit "$FLATPAK_RC";  fi
if [[ "$SKIP_SNAP"     -ne 1 ]] && [[ "$SNAP_RC"         -ne 0 ]]; then exit 100;            fi
if [[ "$SKIP_DOTFILES" -ne 1 ]] && [[ "$DOTFILES_RC"     -ne 0 ]]; then exit 101;            fi
if [[ "$SKIP_DOTFILES" -ne 1 ]] && [[ "$DOTFILES_SYS_RC" -ne 0 ]]; then exit 102;            fi
if [[ "$SKIP_EXTRAS"   -ne 1 ]] && [[ "$TOPGRADE_RC"     -ne 0 ]]; then exit 100;            fi
if [[ "$MAINSTREAM_REPO_OFFLINE" -eq 1 ]]; then exit 100; fi
exit 0
