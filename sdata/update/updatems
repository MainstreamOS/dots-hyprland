#!/usr/bin/env bash
# updatems — update Mainstream OS dotfiles when a remote-tag bump appears.
#
# Standalone-usable; also invoked as the "Dotfiles" step from
# /usr/local/bin/mainstream-update-helper (section 5 of the panel
# update flow). Refuses to run as root — must be the calling user so
# the clone lives under the user's $HOME and exp-update applies files
# into the user's $HOME/.config etc.
#
# Behaviour:
#   1. If ~/.cache/dots-hyprland is missing, auto-clone
#      https://github.com/MainstreamOS/dots-hyprland.git (branch
#      mainstream) into that path.
#   2. Fetch tags from origin and pick the latest release tag. Releases
#      are plain major.minor.patch version numbers (1.0.0 and up); the
#      pre-1.0.0 mainstream-* tag series is retired — 1.0.0 carries a
#      mainstream-1.0.0 twin tag so installs still on the old pattern
#      pick up this switch, then track number tags from there.
#   3. Compare against the last-applied marker
#      (~/.cache/dots-hyprland/.updatems-applied-tag). No bump => no-op.
#   4. On bump: auto-stash any dirty state (left on the stack for the
#      user to restore later), point the mainstream branch at the new
#      tag via `git reset --hard`, then run:
#         ./setup exp-update --skip-notice --non-interactive \
#                            --default-choice backup -p
#      so per-file conflicts go to .update-backups/<file>.<ts>.bak
#      rather than blocking on a prompt, AND any mainstream-* PKGBUILDs
#      that bumped between the last-applied tag and the new tag get
#      rebuilt + installed via `makepkg -sCi --noconfirm`. exp-update's
#      non-interactive default for -p is "build only packages with
#      changed PKGBUILDs" — no-op when no PKGBUILD has changed, which
#      is the common case. Required because the mainstream-* PKGBUILD
#      packages (metas + the quickshell/microtex -git builds) are not
#      served by the [mainstream] binary repo; rebuilding them from
#      the clone is their only update path.
#   5. Write the new tag to the marker on success.
#
# Exit codes:
#   0   no bump (or update applied successfully)
#   N   exp-update's exit code on failure (marker not updated → retry next run)
#
# Options:
#   -f, --force      re-apply even when already at the latest tag
#   -e, --edge       follow the branch instead of the newest tag, so work that
#                    is pushed but not yet released is applied. Two uses: a fix
#                    can reach the people who hit the bug before it is tagged,
#                    and a release can be watched landing on a real machine
#                    without tagging one to find out what it does.
#   -n, --dry-run    print what would happen, make no changes
#   -h, --help       show usage
#
# Environment overrides (mostly useful for testing):
#   MAINSTREAM_DOTFILES_REPO         git URL (default: upstream MainstreamOS)
#   MAINSTREAM_DOTFILES_BRANCH       branch to track (default: mainstream)
#   MAINSTREAM_DOTFILES_TAG_PATTERN  glob for tag matching (default: strict
#                                    major.minor.patch release tags)
#   MAINSTREAM_DOTFILES_DIR          clone path (default: ~/.cache/dots-hyprland)
set -u

REPO_URL="${MAINSTREAM_DOTFILES_REPO:-https://github.com/MainstreamOS/dots-hyprland.git}"
REPO_BRANCH="${MAINSTREAM_DOTFILES_BRANCH:-mainstream}"
# Release tags are plain semver (1.0.0, 1.2.10, ...). The major is capped at
# two digits so upstream date tags (2026.05.11) that reach the fork through a
# merge can never outrank a release; a custom glob via
# MAINSTREAM_DOTFILES_TAG_PATTERN overrides the default.
if [[ -n "${MAINSTREAM_DOTFILES_TAG_PATTERN:-}" ]]; then
    TAG_REGEX="^${MAINSTREAM_DOTFILES_TAG_PATTERN//\*/.+}$"
else
    TAG_REGEX='^[0-9]{1,2}\.[0-9]+\.[0-9]+$'
fi
CLONE_DIR="${MAINSTREAM_DOTFILES_DIR:-$HOME/.cache/dots-hyprland}"
MARKER="${CLONE_DIR}/.updatems-applied-tag"

c_blue=$'\e[38;5;80m'; c_green=$'\e[38;5;79m'; c_red=$'\e[38;5;203m'
c_yellow=$'\e[38;5;221m'; c_rst=$'\e[0m'
say()  { printf '%s==>%s %s\n' "$c_blue"   "$c_rst" "$*"; }
ok()   { printf '%s OK%s  %s\n' "$c_green"  "$c_rst" "$*"; }
warn() { printf '%s ! %s  %s\n' "$c_yellow" "$c_rst" "$*" >&2; }
die()  { printf '%s X %s  %s\n' "$c_red"    "$c_rst" "$*" >&2; exit 1; }

# Guarantee the mainstream-system core package (the plugin-rebuild machinery)
# is installed. --overwrite covers the one-time file handoff for machines that
# still own those paths via the old mainstream-extras. No-op once installed.
ensure_mainstream_system() {
    command -v pacman >/dev/null 2>&1 || return 0
    pacman -Qq mainstream-system >/dev/null 2>&1 && return 0
    local d="$CLONE_DIR/sdata/dist-arch/mainstream-system"
    [[ -f "$d/PKGBUILD" ]] || return 0
    say "Ensuring mainstream-system (core machinery) is installed..."
    ( cd "$d" && makepkg -f --noconfirm ) || { warn "mainstream-system build failed (continuing)"; return 0; }
    local pkg; pkg=$(ls -1t "$d"/mainstream-system-*.pkg.tar.zst 2>/dev/null | head -1)
    [[ -n "$pkg" ]] || { warn "mainstream-system: no built package found"; return 0; }
    if sudo pacman -U --noconfirm \
            --overwrite '/usr/*' \
            "$pkg"; then
        ok "mainstream-system installed"
    else
        warn "mainstream-system install failed (continuing)"
    fi
}

# Refuse root — the dotfiles install is per-user.
[[ $EUID -ne 0 ]] || die "updatems must not run as root; run as your user account."

# Parse args
FORCE=0; DRY_RUN=0; EDGE=0
for arg in "$@"; do
    case "$arg" in
        -f|--force)   FORCE=1 ;;
        -e|--edge)    EDGE=1 ;;
        -n|--dry-run) DRY_RUN=1 ;;
        -h|--help)
            cat <<EOF
Usage: updatems [OPTIONS]

Update Mainstream OS dotfiles when a remote-tag bump is detected.

Options:
  -f, --force      Force re-apply even when already at latest tag
  -e, --edge       Follow the branch instead of the newest tag
  -n, --dry-run    Show what would happen, make no changes
  -h, --help       Show this help

Environment overrides:
  MAINSTREAM_DOTFILES_REPO         (default: $REPO_URL)
  MAINSTREAM_DOTFILES_BRANCH       (default: $REPO_BRANCH)
  MAINSTREAM_DOTFILES_TAG_PATTERN  (default: $TAG_PATTERN)
  MAINSTREAM_DOTFILES_DIR          (default: $CLONE_DIR)
EOF
            exit 0
            ;;
        *) die "unknown argument: $arg (try --help)" ;;
    esac
done

# ── 1. Bootstrap if missing ─────────────────────────────────────────────────
if [[ ! -d "$CLONE_DIR/.git" ]]; then
    say "No dotfiles clone at $CLONE_DIR — bootstrapping from $REPO_URL"
    if [[ $DRY_RUN -eq 1 ]]; then
        ok "[DRY-RUN] Would clone $REPO_URL ($REPO_BRANCH) to $CLONE_DIR"
        exit 0
    fi
    mkdir -p "$(dirname "$CLONE_DIR")" || die "could not create $(dirname "$CLONE_DIR")"
    git clone --branch "$REPO_BRANCH" "$REPO_URL" "$CLONE_DIR" || die "git clone failed"
    git -C "$CLONE_DIR" submodule update --init --recursive 2>/dev/null \
        || warn "submodule init had non-zero exit (continuing)"
    ok "Cloned dotfiles to $CLONE_DIR"
fi

cd "$CLONE_DIR" || die "cannot cd to $CLONE_DIR"

# ── 2. Fetch tags from origin ───────────────────────────────────────────────
say "Fetching tags from origin/$REPO_BRANCH..."
git fetch --tags --force --prune origin "$REPO_BRANCH" 2>&1 | sed 's/^/    /' || die "git fetch failed"

# ── 3. Pick the latest release tag ─────────────────────────────────────────
# Strip peeled-tag suffixes (^{}), keep release tags (excludes the retired
# mainstream-* series and any upstream date tags), version-sort, take the
# highest. sort -V orders semver correctly.
LATEST_TAG=$(git ls-remote --tags origin 2>/dev/null \
    | awk '{print $2}' \
    | grep -vE '\^\{\}$' \
    | sed -E 's|refs/tags/||' \
    | grep -E "$TAG_REGEX" \
    | sort -V | tail -n1 || true)

if [[ -z "$LATEST_TAG" ]]; then
    warn "No remote tags match '$TAG_REGEX' — nothing to update."
    exit 0
fi
# What the release path applies: the tag itself.
TARGET_REF="$LATEST_TAG"

# Edge follows the branch instead. The label carries the commit so a machine
# knows which edge it is on and a later push reads as newer, the way a new tag
# would. Anything already released stays reachable: turning edge off puts the
# machine back on the newest tag, which is the same comparison as always.
if [[ $EDGE -eq 1 ]]; then
    _edge_sha=$(git rev-parse --short "origin/$REPO_BRANCH" 2>/dev/null)
    if [[ -z "$_edge_sha" ]]; then
        die "Edge asked for, but origin/$REPO_BRANCH could not be resolved."
    fi
    TARGET_REF="origin/$REPO_BRANCH"
    LATEST_TAG="edge-$_edge_sha"
    say "Edge: following origin/$REPO_BRANCH at $_edge_sha"
else
    say "Latest remote tag: $LATEST_TAG"
fi

# ── 4. Compare against marker ──────────────────────────────────────────────
APPLIED_TAG=""
[[ -f "$MARKER" ]] && APPLIED_TAG=$(<"$MARKER")
# Fresh installs have no marker yet: the ISO build stamps its baked release
# into /etc/mainstream-dotfiles-tag. Adopt it so the first update only
# applies when a genuinely newer release exists, instead of re-applying the
# whole just-installed tree over the user's configs.
[[ -z "$APPLIED_TAG" && -r /etc/mainstream-dotfiles-tag ]] && APPLIED_TAG=$(</etc/mainstream-dotfiles-tag)
say "Last-applied:      ${APPLIED_TAG:-<none>}"

if [[ "$LATEST_TAG" == "$APPLIED_TAG" && $FORCE -eq 0 ]]; then
    ok "Already at $LATEST_TAG (use --force to re-apply)."
    exit 0
fi

if [[ $DRY_RUN -eq 1 ]]; then
    ok "[DRY-RUN] Would update '${APPLIED_TAG:-<none>}' -> '$LATEST_TAG'"
    exit 0
fi

# ── 5. Auto-stash if dirty (uncommitted + untracked) ───────────────────────
DIRTY=0
if ! git diff --quiet || ! git diff --cached --quiet \
        || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
    DIRTY=1
    STASH_MSG="updatems auto-stash $(date -Iseconds)"
    say "Local edits/untracked present — auto-stashing as: $STASH_MSG"
    git stash push --include-untracked -m "$STASH_MSG" || die "git stash failed"
fi

# ── 6. Move the tracking branch to the target tag, then exp-update ─────────
# Keep on a branch (not detached HEAD) so exp-update's `git pull --ff-only`
# is a no-op rather than failing — exp-update's branch-detection block
# tries to bounce a detached HEAD back to main/master, neither of which
# exist in our clone.
say "Pointing $REPO_BRANCH at $LATEST_TAG..."
git checkout "$REPO_BRANCH" 2>/dev/null || git checkout -B "$REPO_BRANCH" "origin/$REPO_BRANCH"
# exp-update decides which files to re-apply from the LAST reflog hop
# (HEAD@{1}..HEAD), so that hop must span last-applied -> target. Park
# HEAD on the applied base first, then jump to the target in one move.
# 1.0.3 was applied with a truncated hop on some installs (tag-then-pull
# split the range), and those installs still run the pre-fix updatems when
# they apply the tag after it.
BASE_REF="$APPLIED_TAG"
case "$APPLIED_TAG" in 1.0.3|1.0.4) BASE_REF="1.0.2" ;; esac
EXTRA_ARGS=()
if [[ -n "$BASE_REF" ]] && git rev-parse --verify "refs/tags/$BASE_REF" >/dev/null 2>&1; then
    git reset --hard "refs/tags/$BASE_REF" >/dev/null || true
else
    # With no base to park on, the jump below can land exactly where the
    # clone already sits, leaving exp-update an empty hop to read: it
    # applies nothing, exits clean, and the marker below records the
    # release as delivered. Comparing the whole tree costs a slower pass
    # and cannot quietly deliver nothing.
    warn "No usable base ref (${BASE_REF:-<none>}) — comparing the whole tree instead of the last hop."
    EXTRA_ARGS+=(--force)
fi
git reset --hard "$TARGET_REF" || die "git reset --hard $TARGET_REF failed"

say "Running ./setup exp-update (non-interactive, backup-on-conflict, -p)..."
# The clone is pinned to $LATEST_TAG above; a pull inside exp-update would
# overshoot the tag to the branch tip and shrink the reflog hop.
DOTS_SKIP_PULL=1 ./setup exp-update --skip-notice --non-interactive --default-choice backup -p \
    ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}
RC=$?

# Make sure the core machinery package landed, whatever exp-update's -p pass did.
ensure_mainstream_system

# ── 7. Update marker on success ────────────────────────────────────────────
if [[ $RC -eq 0 ]]; then
    echo "$LATEST_TAG" > "$MARKER"
    ok "Applied $LATEST_TAG. Marker written: $MARKER"
    [[ $DIRTY -eq 1 ]] && warn "Local edits stashed — restore with: cd '$CLONE_DIR' && git stash list"
    exit 0
else
    warn "exp-update exited with rc=$RC; marker NOT updated so next run will retry."
    [[ $DIRTY -eq 1 ]] && warn "Local edits stashed — restore with: cd '$CLONE_DIR' && git stash list"
    exit "$RC"
fi
