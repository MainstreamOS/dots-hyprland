#!/usr/bin/env bash
# updatems-system — refresh Mainstream OS system-level files after a
# dotfiles tag bump. Invoked from the privileged mainstream-update-helper
# (section 5b) right after the user-level updatems step, so it runs as
# root and writes to /usr/share, /usr/share/polkit-1, and /usr/local/bin.
#
# Scope: every root-owned file in ROOT_FILES below, installed byte for byte
# from the clone, the Plymouth theme and /etc/skel, plus the repairs further
# down that bring a machine installed from an older image to what a new
# install of this release gets.
#
# Deliberately NOT done here:
#   - mkinitcpio rebuild (1–2 min per kernel × N kernels). Plymouth
#     reads its theme dir at boot, so a refreshed theme becomes active
#     on the next mkinitcpio run that the user triggers anyway. The one
#     exception is a boot image that would hibernate memory, disk key
#     included, onto an unencrypted swap; see that step below.
#   - plymouth-set-default-theme (one-time install-time concern; already
#     pointing at "mainstream").
#   - /etc/kernel/cmdline rewrites for splash/quiet flags (set once at
#     install).
#
# For those install-time concerns, the user can still run:
#   cd ~/.cache/dots-hyprland && ./setup install-setups
#
# Usage: updatems-system [REPO_DIR]
#   REPO_DIR defaults to ~$ORIG_USER/.cache/dots-hyprland — the path
#   updatems uses for its clone. The helper passes this explicitly so
#   we don't have to resolve it ourselves.
#        updatems-system --list-root-files
#   prints ROOT_FILES as "mode source destination" lines and changes nothing.
set -u

# The root helpers, their polkit actions and rules, and the libraries and
# units the rest of the system calls, as mode|path in the clone|destination.
# One list, so a helper the image ships cannot be missed by the update and
# leave installed machines on the copy they were installed with; the ISO
# build checks what it ships against it. The update tooling comes first, so
# the Update page stops finding the system half pending as soon as possible,
# even when a later step here stalls. install replaces a file rather than
# writing into it, so the helper running this keeps reading the copy it
# started with.
ROOT_FILES=(
    "0755|sdata/update/mainstream-update-helper|/usr/local/bin/mainstream-update-helper"
    "0755|sdata/update/updatems|/usr/local/bin/updatems"
    "0755|sdata/update/updatems-system|/usr/local/bin/updatems-system"
    "0644|sdata/lib/tr.sh|/usr/local/lib/mainstream-tr.sh"
    "0644|sdata/lib/provision-user.sh|/usr/local/lib/mainstream-provision-user.sh"
    "0644|sdata/lib/venv-common.sh|/usr/local/lib/mainstream-venv-common.sh"
    "0755|sdata/provision/dotfiles-first-login|/usr/local/bin/dotfiles-first-login"
    "0755|sdata/polkit/user-manager|/usr/local/bin/user-manager"
    "0644|sdata/polkit/org.mainstreamos.user-manager.policy|/usr/share/polkit-1/actions/org.mainstreamos.user-manager.policy"
    "0644|sdata/polkit/50-user-manager.rules|/usr/share/polkit-1/rules.d/50-user-manager.rules"
    "0755|sdata/polkit/app-remover|/usr/local/bin/app-remover"
    "0644|sdata/polkit/org.mainstreamos.app-remover.policy|/usr/share/polkit-1/actions/org.mainstreamos.app-remover.policy"
    "0644|sdata/polkit/50-app-remover.rules|/usr/share/polkit-1/rules.d/50-app-remover.rules"
    "0755|sdata/polkit/disk-mounter|/usr/local/bin/disk-mounter"
    "0644|sdata/polkit/org.mainstreamos.disk-mounter.policy|/usr/share/polkit-1/actions/org.mainstreamos.disk-mounter.policy"
    "0755|sdata/polkit/power-key-helper.sh|/usr/local/bin/power-key-helper"
    "0644|sdata/polkit/org.illogicalimpulse.power-key.policy|/usr/share/polkit-1/actions/org.illogicalimpulse.power-key.policy"
    "0644|sdata/polkit/50-power-key.rules|/usr/share/polkit-1/rules.d/50-power-key.rules"
    "0755|sdata/polkit/gaming-tuning|/usr/local/bin/gaming-tuning"
    "0644|sdata/polkit/org.mainstreamos.gaming-tuning.policy|/usr/share/polkit-1/actions/org.mainstreamos.gaming-tuning.policy"
    "0755|sdata/polkit/ollama-setup|/usr/local/bin/ollama-setup"
    "0644|sdata/polkit/org.mainstreamos.ollama-setup.policy|/usr/share/polkit-1/actions/org.mainstreamos.ollama-setup.policy"
    "0755|sdata/polkit/ai-cli-install|/usr/local/bin/ai-cli-install"
    "0644|sdata/polkit/org.mainstreamos.ai-cli-install.policy|/usr/share/polkit-1/actions/org.mainstreamos.ai-cli-install.policy"
    "0755|dots/.config/quickshell/ii/scripts/colors/sddm-bg-helper.sh|/usr/local/bin/sddm-bg-helper"
    "0644|sdata/polkit/org.illogicalimpulse.sddm-bg.policy|/usr/share/polkit-1/actions/org.illogicalimpulse.sddm-bg.policy"
    "0644|sdata/polkit/50-sddm-bg.rules|/usr/share/polkit-1/rules.d/50-sddm-bg.rules"
    "0644|sdata/polkit/50-keyboard-layout.rules|/usr/share/polkit-1/rules.d/50-keyboard-layout.rules"
    "0644|sdata/dist-arch/mainstream.pub|/usr/local/share/mainstream.pub"
    "0755|sdata/keyring/mainstream-keyring-init|/usr/local/bin/mainstream-keyring-init"
    "0755|sdata/keyring/mainstream-keyring-repair|/usr/local/bin/mainstream-keyring-repair"
    "0644|sdata/keyring/pacman-keyring-init.service|/etc/systemd/system/pacman-keyring-init.service"
    "0644|sdata/keyring/pacman-keyring-init.timer|/etc/systemd/system/pacman-keyring-init.timer"
    "0755|sdata/boot/mainstream-limine-windows|/usr/local/bin/mainstream-limine-windows"
)

if [[ "${1:-}" == --list-root-files ]]; then
    for _entry in "${ROOT_FILES[@]}"; do
        IFS='|' read -r _mode _src _dst <<<"$_entry"
        printf '%s %s %s\n' "$_mode" "$_src" "$_dst"
    done
    exit 0
fi

[[ $EUID -eq 0 ]] || { echo "updatems-system: must run as root" >&2; exit 1; }

# Resolve REPO_DIR. Argument > $SUDO_USER's clone > $HOME's clone.
if [[ -n "${1:-}" ]]; then
    REPO_DIR="$1"
elif [[ -n "${SUDO_USER:-}" ]]; then
    REPO_DIR="$(getent passwd "$SUDO_USER" | cut -d: -f6)/.cache/dots-hyprland"
else
    REPO_DIR="$HOME/.cache/dots-hyprland"
fi

if [[ ! -d "$REPO_DIR/.git" ]]; then
    echo "updatems-system: no dots-hyprland clone at $REPO_DIR" >&2
    echo "  hint: run updatems as your user first to bootstrap the clone." >&2
    exit 1
fi

c_blue=$'\e[38;5;80m'; c_green=$'\e[38;5;79m'
c_yellow=$'\e[38;5;221m'; c_rst=$'\e[0m'
say()  { printf '%s==>%s %s\n' "$c_blue"   "$c_rst" "$*"; }
ok()   { printf '%s OK%s  %s\n' "$c_green"  "$c_rst" "$*"; }
warn() { printf '%s ! %s  %s\n' "$c_yellow" "$c_rst" "$*" >&2; }

# Messages in the caller's language, through the same files the shell reads:
# the installed library, or the clone's copy on the hop that first brings it.
if [[ -r /usr/local/lib/mainstream-tr.sh ]]; then
    # shellcheck source=/dev/null
    source /usr/local/lib/mainstream-tr.sh
elif [[ -r "$REPO_DIR/sdata/lib/tr.sh" ]]; then
    # shellcheck source=/dev/null
    source "$REPO_DIR/sdata/lib/tr.sh"
fi
if declare -F tr_init >/dev/null; then
    # The clone belongs to the person this runs for, whether they came
    # through sudo or pkexec, so its owner names the language.
    tr_init "${SUDO_USER:-$(stat -c %U "$REPO_DIR" 2>/dev/null || true)}"
else
    t()  { printf '%s' "$1"; }
    tf() { local fmt="$1"; shift; printf -- "$fmt" "$@"; }
fi

cd "$REPO_DIR" || { echo "cannot cd to $REPO_DIR" >&2; exit 1; }

# Hand over to the copy the release being applied ships, rather than running
# the one the previous release installed. The update helper calls this script
# by name, so without this every step added here waits a whole release to
# take effect, and it refreshes itself at the end — one release too late to
# do the work it was added for. The guard variable keeps the handover from
# looping if the install fails to change anything.
if [[ -z "${UPDATEMS_SYSTEM_REEXEC:-}" && -f "$REPO_DIR/sdata/update/updatems-system" \
      && ! -L "$REPO_DIR/sdata/update/updatems-system" ]] \
   && [[ $(( 8#$(stat -c %a "$REPO_DIR/sdata/update/updatems-system" 2>/dev/null || echo 777) & 8#022 )) -eq 0 ]] \
   && ! cmp -s "$REPO_DIR/sdata/update/updatems-system" "$0"; then
    if install -m755 -o root -g root "$REPO_DIR/sdata/update/updatems-system" \
            /usr/local/bin/updatems-system 2>/dev/null; then
        export UPDATEMS_SYSTEM_REEXEC=1
        exec /usr/local/bin/updatems-system "$@"
    fi
fi

# Per-component rc tracking; any non-zero rolls up to a single soft fail
# (return 1). We DON'T abort on the first failure — best effort, refresh
# what we can.
RC=0
# Everything installed here runs as root later, and it comes out of a tree the
# user owns. A symlink or a file others can write is how a checkout that looks
# like a release turns into something else on the way in.
_src_ok() {
    local src="$1" mode
    [[ -f "$src" && ! -L "$src" ]] || return 1
    mode=$(stat -c %a "$src" 2>/dev/null) || return 1
    [[ $(( 8#$mode & 8#022 )) -eq 0 ]]
}
_install_file() {
    # $1 mode  $2 src  $3 dst  $4 label
    local mode="$1" src="$2" dst="$3" label="$4"
    if [[ ! -e "$src" ]]; then
        warn "$(tf "%s source missing at %s — skipping" "$label" "$src")"
        return 0
    fi
    if ! _src_ok "$src"; then
        warn "$(tf "%s source is a symlink or writable by others (%s) — refusing to install it as root" "$label" "$src")"
        RC=1
        return 0
    fi
    # Already the release's copy with the mode and owner it should have, which
    # is most files on most runs: rewriting it would only bury the files that
    # did change among lines that say nothing.
    if [[ -f "$dst" && ! -L "$dst" ]] && cmp -s "$src" "$dst" \
       && [[ "$(stat -c '%a %u %g' "$dst" 2>/dev/null)" == "$(printf '%o' "$((8#$mode))") 0 0" ]]; then
        return 0
    fi
    if install -D -m "$mode" -o root -g root "$src" "$dst"; then
        ok "$(tf "%s refreshed -> %s" "$label" "$dst")"
    else
        warn "$(tf "%s install failed (src=%s dst=%s)" "$label" "$src" "$dst")"
        RC=1
    fi
}
# Without pipefail a pipeline's status is sed's, which succeeds on any input,
# so a pacman that could not install anything would read as a success.
_pacman_needed() {
    pacman -S --noconfirm --needed "$@" 2>&1 | sed 's/^/    /'
    return "${PIPESTATUS[0]}"
}

for _entry in "${ROOT_FILES[@]}"; do
    IFS='|' read -r _mode _src _dst <<<"$_entry"
    _install_file "$_mode" "$REPO_DIR/$_src" "$_dst" "$(basename "$_dst")"
done
[[ $RC -eq 0 ]] && ok "$(t "The system helpers and their polkit files match this release.")"

# The Update page asks for a new login while this file lists a reason, and
# the session removes it as it starts. Written as the person it is for, since
# it lives in their home.
_relogin_note() {  # $1 = user  $2 = reason, in English
    local home
    home="$(getent passwd "$1" | cut -d: -f6)"
    [[ -n "$home" && -d "$home" ]] || return 0
    runuser -u "$1" -- sh -c 'mkdir -p "$1" && { grep -qxF "$2" "$1/relogin-needed" 2>/dev/null || printf "%s\n" "$2" >> "$1/relogin-needed"; }' \
        sh "$home/.local/state/mainstream" "$2" </dev/null 2>/dev/null || true
}

# ── Plymouth theme files (no rebuild — see header) ─────────────────────────
PLY_SRC="$REPO_DIR/sdata/plymouth/mainstream"
PLY_DST="/usr/share/plymouth/themes/mainstream"
if [[ -d "$PLY_SRC" ]]; then
    say "$(tf "Refreshing Plymouth theme -> %s" "$PLY_DST")"
    if rm -rf "$PLY_DST" && cp -r "$PLY_SRC" "$PLY_DST"; then
        chown -R root:root "$PLY_DST"
        find "$PLY_DST" -type d -exec chmod 755 {} +
        find "$PLY_DST" -type f -exec chmod 644 {} +
        ok "$(t "Plymouth theme refreshed (initramfs NOT rebuilt; takes effect on the next mkinitcpio pass)")"
    else
        warn "$(t "Plymouth theme refresh failed")"
        RC=1
    fi
else
    warn "$(tf "No Plymouth source at %s — skipping" "$PLY_SRC")"
fi

# ── /etc/skel, so a new account is not stuck on install day ───────────────
# skel is written once, when the machine is installed, and nothing has been
# updating it since. On a machine that has taken a few months of updates that
# means a newly created user gets the desktop as it was the day the machine was
# installed: an older bar layout, plugins built for a compositor that has since
# moved on, and none of the fixes in between.
#
# The same tree build.sh uses when it seeds skel for the image, and the one
# exclusion list, shared with provisioning so the two cannot drift.
if [[ ! -d "$REPO_DIR/dots" ]] || ! command -v rsync >/dev/null 2>&1; then
    warn "$(t "Cannot refresh /etc/skel; a new account would be set up from an older desktop.")"
    RC=1
elif ! _src_ok "$REPO_DIR/sdata/lib/provision-user.sh"; then
    # Read as root out of a tree the user owns, so it gets the same symlink and
    # writability test every file installed from here already gets.
    warn "$(t "The provisioning library is missing or writable by others; leaving /etc/skel alone.")"
    RC=1
else
    say "$(t "Refreshing /etc/skel from the dotfiles...")"
    # shellcheck source=/dev/null
    source "$REPO_DIR/sdata/lib/provision-user.sh"
    if provision_refresh_skel "$REPO_DIR/dots"; then
        ok "$(t "/etc/skel now matches this release.")"
    elif [[ $? -eq 2 ]]; then
        warn "$(t "The provisioning library carries no exclusion list; leaving /etc/skel alone.")"
        RC=1
    else
        warn "$(t "Could not refresh /etc/skel; a new account would be set up from an older desktop.")"
        RC=1
    fi
fi

# ── SDDM greeter config: .conf → .lua ──────────────────────────────────────
# Hyprland 0.56.1 puts a notice on screen for any .conf config and drops the
# format in 0.57. The greeter runs its own compositor, and its config is
# written by the installer — which an update never re-runs — so a machine
# installed before the switch would keep showing that notice at every login
# with nothing to clear it.
#
# Only touched when the directory already exists, so this never sets up a
# greeter on a machine that has not asked for one. Hyprland finds lua before
# conf, so writing the new file is what resolves it; the old one is moved
# aside afterwards, and only if the write succeeded.

GREETER_DIR=/var/lib/sddm/.config/hypr
GREETER_SRC="$REPO_DIR/sdata/sddm/hyprland.lua"
if [[ -d "$GREETER_DIR" ]]; then
    if [[ ! -f "$GREETER_SRC" ]]; then
        warn "$(tf "SDDM greeter config source missing at %s — skipping" "$GREETER_SRC")"
    elif install -m 600 -o sddm -g sddm "$GREETER_SRC" "$GREETER_DIR/hyprland.lua"; then
        if [[ -f "$GREETER_DIR/hyprland.conf" ]]; then
            mv "$GREETER_DIR/hyprland.conf" "$GREETER_DIR/hyprland.conf.old"
            ok "$(t "SDDM greeter config moved to Lua (old kept as hyprland.conf.old)")"
        else
            ok "$(tf "SDDM greeter config refreshed -> %s" "$GREETER_DIR/hyprland.lua")"
        fi
    else
        warn "$(t "SDDM greeter config install failed — leaving the existing one alone")"
        RC=1
    fi
fi

# ── Keyboard layout: login screen and Settings agree ──────────────────────
# Settings → Keyboard hands its list to systemd-localed, which is what the
# greeter reads at start, so the two type in the same layouts. The rule in
# ROOT_FILES lets an active local user do that without a password.

# The rest belongs to the login screen, so it is only for a machine that has
# one: the tmpfiles line names the sddm account, and without that account the
# setup unit would fail at every boot.
if getent passwd sddm >/dev/null 2>&1; then
    # The greeter's own layout picker: its QML cannot run hyprctl, so this
    # script runs beside it and does the switching. The greeter config above
    # starts it.
    _install_file 0755 \
        "$REPO_DIR/sdata/sddm/pixie-sddm-keyboard-bridge.sh" \
        /usr/local/bin/pixie-sddm-keyboard-bridge.sh \
        "$(t "SDDM keyboard bridge")"

    # The bridge and the greeter meet in a directory under /run that root
    # creates at boot; created now as well so the next login does not wait
    # for a reboot.
    _install_file 0644 \
        "$REPO_DIR/sdata/sddm/mainstream-greeter.conf" \
        /usr/lib/tmpfiles.d/mainstream-greeter.conf \
        "$(t "Greeter runtime directory (tmpfiles)")"
    if [[ -f /usr/lib/tmpfiles.d/mainstream-greeter.conf ]] && ! systemd-tmpfiles --create mainstream-greeter.conf 2>/dev/null; then
        warn "$(t "Greeter runtime directory not created now; it will exist after a reboot")"
    fi

    # The greeter's SDDM drop-in ships as a file, the same one ./setup and the
    # image install. Once on a machine it is the user's to edit, so it is only
    # put in place when missing; the switch below reaches the ones already there.
    if [[ ! -f /etc/sddm.conf.d/10-wayland.conf ]]; then
        _install_file 0644 \
            "$REPO_DIR/sdata/sddm/10-wayland.conf" \
            /etc/sddm.conf.d/10-wayland.conf \
            "$(t "SDDM greeter session config")"
    fi

    # The picker reads its state through file:// in QML, which Qt refuses
    # unless the greeter is told to allow it. Every file that sets the
    # greeter's environment gets the switch, since the last one SDDM reads
    # wins, and a machine installed from an older image carries sddm.conf too.
    for conf in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
        [[ -f "$conf" ]] || continue
        grep -q '^GreeterEnvironment=' "$conf" || continue
        grep -q 'QML_XHR_ALLOW_FILE_READ' "$conf" && continue
        if sed -i -e 's/^GreeterEnvironment=$/GreeterEnvironment=QML_XHR_ALLOW_FILE_READ=1/' -e 't' \
                  -e 's/^\(GreeterEnvironment=.\+\)$/\1,QML_XHR_ALLOW_FILE_READ=1/' "$conf"; then
            ok "$(tf "Greeter environment updated in %s" "$conf")"
        else
            warn "$(tf "Could not update the greeter environment in %s" "$conf")"
            RC=1
        fi
    done

    # The theme itself: an install clones it from GitHub once and nothing
    # refreshed it since, so a machine kept the login screen it was installed
    # with, picker and all. Best effort: no network means the old theme stays.
    # The wallpaper copy the desktop keeps under assets/backgrounds is merged
    # over, not removed.
    PIXIE_DIR=/usr/share/sddm/themes/pixie
    if [[ -d "$PIXIE_DIR" ]]; then
        if [[ -d "$PIXIE_DIR/.git" ]]; then
            if git -C "$PIXIE_DIR" pull --ff-only -q 2>/dev/null; then
                ok "$(t "SDDM theme refreshed")"
            else
                warn "$(t "SDDM theme not refreshed (no network, or local changes in it)")"
            fi
        else
            PIXIE_TMP=$(mktemp -d)
            if git clone --depth=1 -q https://github.com/MainstreamOS/pixie-sddm.git "$PIXIE_TMP" 2>/dev/null; then
                for item in components Main.qml VideoBackground.qml metadata.desktop theme.conf LICENSE; do
                    [[ -e "$PIXIE_TMP/$item" ]] && cp -r "$PIXIE_TMP/$item" "$PIXIE_DIR/"
                done
                [[ -d "$PIXIE_TMP/assets" ]] && cp -r "$PIXIE_TMP/assets/." "$PIXIE_DIR/assets/"
                chmod -R a+rX "$PIXIE_DIR"
                ok "$(t "SDDM theme refreshed")"
            else
                warn "$(t "SDDM theme not refreshed (no network)")"
            fi
            rm -rf "$PIXIE_TMP"
        fi
    fi
fi

# ── Printing ──────────────────────────────────────────────────────────────
# The spooler is reached through its socket rather than its service, and
# systemd starts it on the first print job. Arch ships no preset for cups and
# its default policy is `disable *`, so a machine nobody told to enable it
# simply cannot print. The installer tells a fresh install; one made before it
# learned to arrives here instead, which is the only route an existing machine
# has to the same fix.
#
# Skipped where cups is not installed at all: enabling a unit that is not there
# is not a failure worth reporting, and pulling in a package on an update is a
# bigger decision than this script gets to make.
if systemctl cat cups.socket &>/dev/null; then
    if systemctl is-enabled cups.socket &>/dev/null; then
        : # already on, nothing to say
    elif systemctl enable cups.socket &>/dev/null; then
        ok "$(t "Printing enabled (cups.socket)")"
    else
        warn "$(t "Could not enable cups.socket")"
        RC=1
    fi
fi

# Most home printers are found over mDNS and answer to a .local name, which
# nothing resolves until nss-mdns is named in nsswitch. The package installs the
# resolver and stops there, so a printer the machine can see advertised is still
# one it cannot reach. Inserted before `dns` so ordinary lookups are unchanged,
# and only when the entry is absent.
if [[ -f /etc/nsswitch.conf ]] && ! grep -q 'mdns_minimal' /etc/nsswitch.conf; then
    if sed -i -E 's/^(hosts:.*[[:space:]])(dns)([[:space:]]|$)/\1mdns_minimal [NOTFOUND=return] \2\3/' /etc/nsswitch.conf \
       && grep -q 'mdns_minimal' /etc/nsswitch.conf; then
        ok "$(t "Network printers resolvable (nss-mdns)")"
    else
        warn "$(t "Could not add mdns_minimal to /etc/nsswitch.conf")"
        RC=1
    fi
fi

# The rest of the printing experience, matching what a fresh install gets:
# the queue maker that gives an IPP-over-USB printer a permanent queue (the
# entry print dialogs list up front), the polkit rule that spares the
# printer app its unlock prompt, the test page that survives libcupsfilters
# 2.2, and queues that retry a failed job instead of stopping. The queue
# maker stays inert until ipp-usb arrives, which the mainstream-basic
# upgrade brings along on the same run.
# The queue maker, the printer-app unlock and the test-page hook now ship in
# mainstream-system, so they land with the package instead of from here. That
# matters most on the hop that first brings ipp-usb along: a machine that
# gained the daemon without the queue maker would have had its old USB queue
# claimed out from under it and nothing put in its place.
if [[ -f /usr/share/cups/data/default-testpage.pdf ]]; then
    cp /usr/share/cups/data/default-testpage.pdf /usr/share/cups/data/testprint || true
fi
if [[ -f /etc/cups/cupsd.conf ]] && ! grep -q '^ErrorPolicy' /etc/cups/cupsd.conf; then
    if cat >> /etc/cups/cupsd.conf <<'CUPSPOLICYEOF'

ErrorPolicy retry-job
JobRetryInterval 60
JobRetryLimit 5
CUPSPOLICYEOF
    then
        ok "$(t "CUPS queues retry rather than stop on a backend error")"
    else
        warn "$(t "Could not set the CUPS error policy")"
        RC=1
    fi
fi
# An earlier unreleased revision leaned on cups-browsed for the queue; its
# config gives way to the packaged queue maker. Only the config that revision
# wrote is removed: one a user authored themselves stays theirs.
if [[ -f /etc/cups/cups-browsed.conf ]] \
   && [[ "$(md5sum /etc/cups/cups-browsed.conf | cut -d' ' -f1)" == "aacb6fd7ddcab1c2e8a3f726abf1d9bf" ]]; then
    rm -f /etc/cups/cups-browsed.conf
fi
udevadm control --reload 2>/dev/null || true
systemctl daemon-reload 2>/dev/null || true
# A printer already plugged in gets its permanent queue on this run rather
# than at the next replug; with no printer this is a quiet no-op.
systemctl start mainstream-printer-setup.service 2>/dev/null || true

# ── pacman keyring + [mainstream] repo self-healing ───────────────────────
# This lands over git rather than over pacman, which is the only delivery path
# left on a machine whose [mainstream] signing key never got trusted: there
# pacman -Syu fails for every repo, core and extra included, so a fix shipped
# as a package could never arrive. The key, the tools and the units themselves
# are in ROOT_FILES.
systemctl daemon-reload 2>/dev/null || true
# Installs made while the unit disabled its own timer after one success have
# no watchdog left, so enabling here is what puts a stranded machine back
# under one.
if systemctl enable --now pacman-keyring-init.timer 2>/dev/null; then
    ok "$(t "Keyring check timer enabled")"
else
    warn "$(t "Could not enable pacman-keyring-init.timer")"
    RC=1
fi

if [[ -x /usr/local/bin/mainstream-keyring-init ]] \
   && ! /usr/local/bin/mainstream-keyring-init --check >/dev/null 2>&1; then
    say "$(t "Repairing the pacman keyring and [mainstream] repo...")"
    /usr/local/bin/mainstream-keyring-init 2>&1 | sed 's/^/    /'
    if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
        ok "$(t "Keyring and [mainstream] repo verified")"
    else
        warn "$(t "Keyring repair did not complete; the timer retries on its own")"
        RC=1
    fi
fi

# ── GameMode ───────────────────────────────────────────────────────────────
# GameMode's polkit rules let only the gamemode group change the CPU governor
# and game priorities, and nothing put anyone in it, so a game run through it
# got little more than a screen kept awake. New accounts join as they are set
# up; the people already here join from this, once each, so someone who
# leaves the group afterwards stays out. Local accounts with a login shell
# only: a directory service's users are not /etc/group's to hold.
GAMEMODE_LEDGER=/var/lib/mainstream/gamemode-group-offered
UMS_PERSON="${SUDO_USER:-$(stat -c %U "$REPO_DIR" 2>/dev/null || true)}"
if getent group gamemode >/dev/null 2>&1; then
    while IFS=: read -r _u _ _uid _ _ _ _shell; do
        [[ "$_uid" =~ ^[0-9]+$ ]] && (( _uid >= 1000 && _uid < 60000 )) || continue
        grep -qxF -- "$_shell" /etc/shells 2>/dev/null || continue
        grep -qxF -- "$_u" "$GAMEMODE_LEDGER" 2>/dev/null && continue
        if ! id -nG "$_u" 2>/dev/null | tr ' ' '\n' | grep -qxF gamemode; then
            if ! usermod -aG gamemode "$_u" 2>/dev/null; then
                warn "$(tf "Could not add %s to the gamemode group" "$_u")"
                RC=1
                continue
            fi
            ok "$(tf "Added %s to the gamemode group, which takes effect at the next login" "$_u")"
            [[ "$_u" == "$UMS_PERSON" ]] \
                && _relogin_note "$_u" "Your account joined the gamemode group"
        fi
        mkdir -p "${GAMEMODE_LEDGER%/*}" && printf '%s\n' "$_u" >> "$GAMEMODE_LEDGER"
    done < /etc/passwd
fi

# ── Firewall zone ──────────────────────────────────────────────────────────
# Installs from before 2.0.0 carry the zone without the printer discovery
# services, so adding a printer still stops at a firewall prompt. Only the
# zone exactly as those installs wrote it is replaced; one someone changed is
# theirs.
FW_ZONE=/etc/firewalld/zones/MainstreamWorkstation.xml
FW_ZONE_SRC="$REPO_DIR/sdata/firewalld/MainstreamWorkstation.xml"
if [[ -f "$FW_ZONE" && ! -L "$FW_ZONE" ]] \
   && [[ "$(md5sum < "$FW_ZONE" | cut -d' ' -f1)" == 9b0f529fa04f9dca6d3008f009326e77 ]] \
   && ! pacman -Qqo "$FW_ZONE" >/dev/null 2>&1; then
    _install_file 0644 "$FW_ZONE_SRC" "$FW_ZONE" "$(basename "$FW_ZONE")"
    # The running firewall is handed the two services directly, since a reload
    # would also drop an interface a Sharing session has moved for now.
    if cmp -s "$FW_ZONE_SRC" "$FW_ZONE" && systemctl is-active --quiet firewalld.service 2>/dev/null; then
        firewall-cmd --zone=MainstreamWorkstation --add-service=mdns --add-service=ipp-client >/dev/null 2>&1 || true
    fi
fi

# ── Sleep hook ─────────────────────────────────────────────────────────────
# The image's hook turns the screens off before suspend and back on after,
# through a dispatcher form the Lua config refuses, so it has done nothing on
# any install. No package owns it, so the fixed copy comes from here, and only
# over a copy an image shipped: when the hook changes again, the checksum of
# the copy it replaces joins this list.
SLEEP_HOOK=/usr/lib/systemd/system-sleep/hyprland-dpms.sh
if [[ -f "$SLEEP_HOOK" && ! -L "$SLEEP_HOOK" ]]; then
    case "$(md5sum < "$SLEEP_HOOK" | cut -d' ' -f1)" in
        36525ed3cd430d788aee18849bfbb07b|eb2ed1c353509828a28e379ed0fdcffd)
            pacman -Qqo "$SLEEP_HOOK" >/dev/null 2>&1 \
                || _install_file 0755 "$REPO_DIR/sdata/system-sleep/hyprland-dpms.sh" "$SLEEP_HOOK" "$(basename "$SLEEP_HOOK")"
            ;;
    esac
fi

# ── Apple hardware ─────────────────────────────────────────────────────────
# The Mac quirks ran at install time only, so a Mac installed before one
# existed never gained it: the firmware fetch for the T2 chips, the wl driver
# for the 2012-2015 Broadcom parts, the SPI and NVMe fixes. Applied here from
# the same library the installer uses; a no-op on anything that is not a Mac.
# The initramfs is not rebuilt here, in keeping with the rest of this script:
# a module added to its list lands on the next kernel update.
MAC_LIB_SRC="$REPO_DIR/sdata/lib/mac-config.sh"
GPU_LIB_SRC="$REPO_DIR/sdata/lib/gpu-config.sh"
if [[ -r "$MAC_LIB_SRC" && -r "$GPU_LIB_SRC" ]] && [[ "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" == Apple* ]]; then
    # shellcheck source=/dev/null
    source "$GPU_LIB_SRC"
    # shellcheck source=/dev/null
    source "$MAC_LIB_SRC"
    say "$(t "Apple hardware: applying the Mac quirks...")"
    mac_report 2>/dev/null | sed 's/^/    /' || true
    if mac_needs_wl_driver; then
        # shellcheck disable=SC2046
        pacman -S --noconfirm --needed $(mac_wl_packages) 2>&1 | sed 's/^/    /'
        # Without pipefail the status here would be sed's, which succeeds on
        # any input, so a pacman that could not install anything would be
        # reported as a driver that is now present.
        if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
            ok "$(t "Broadcom wl driver installed")"
        else
            warn "$(t "Could not install the Broadcom wl driver")"
            RC=1
        fi
    fi
    if mac_needs_apple_firmware; then
        _install_file 0755 "$REPO_DIR/sdata/mac/mainstream-mac-firmware" /usr/local/bin/mainstream-mac-firmware "$(t "Mac firmware fetch")"
        _install_file 0644 "$REPO_DIR/sdata/mac/macrecovery.py" /usr/local/lib/mainstream-mac/macrecovery.py "$(t "macrecovery")"
        _install_file 0644 "$REPO_DIR/sdata/mac/NOTICE" /usr/local/lib/mainstream-mac/NOTICE "$(t "Mac firmware notice")"
        for f in "$REPO_DIR"/sdata/mac/asahi_firmware/*.py; do
            _install_file 0644 "$f" "/usr/local/lib/mainstream-mac/asahi_firmware/$(basename "$f")" "asahi_firmware/$(basename "$f")"
        done
        pacman -S --noconfirm --needed 7zip 2>&1 | sed 's/^/    /'
        [[ ${PIPESTATUS[0]} -eq 0 ]] || { warn "$(t "Could not install 7zip")"; RC=1; }
    fi
    if mac_apply_autoconfig; then
        ok "$(t "Mac quirks applied")"
    else
        warn "$(t "Mac quirks did not fully apply")"
        RC=1
    fi
    systemctl daemon-reload 2>/dev/null || true
    mac_fetch_firmware_now 2>&1 | sed 's/^/    /' || true
fi

# NVML bindings for GPU monitors such as TRCC, on NVIDIA machines. Seeded once per
# machine, so a user who removes the package keeps it removed.
NVML_STAMP=/var/lib/mainstream/nvml-seeded
if [[ -r "$GPU_LIB_SRC" && ! -e "$NVML_STAMP" ]]; then
    # shellcheck source=/dev/null
    source "$GPU_LIB_SRC"
    gpu_detect >/dev/null 2>&1 || true
    mapfile -t _nv_extra < <(nvidia_extra_pkgs)
    if (( ${#_nv_extra[@]} )); then
        if _pacman_needed "${_nv_extra[@]}"; then
            mkdir -p "${NVML_STAMP%/*}" && : > "$NVML_STAMP"
            ok "$(t "NVIDIA monitoring library installed")"
        else
            warn "$(t "Could not install the NVIDIA monitoring library")"
        fi
    fi
fi

# A machine that gained a Windows install after the first boot never had
# anything look for it again, and the installers only ever checked the one ESP
# they mounted. Refreshed with ROOT_FILES and re-run on every update so the
# menu catches up.
if [[ -x /usr/local/bin/mainstream-limine-windows ]]; then
    /usr/local/bin/mainstream-limine-windows || true
fi

# ── Hibernation beside an encrypted root ──────────────────────────────────
# Installs before 3.0.0 could name a plain swap partition in resume= beside an
# encrypted root, so hibernating wrote all of memory, the disk key included,
# to that partition unencrypted. A new install turns hibernation off in that
# layout; this does the same, once, and only when every probe agrees: the root
# is on dm-crypt and the command line unlocks it, resume= names exactly one
# device and it is a plain swap partition, and /etc/kernel/cmdline is the only
# command line the boot entries are built from. The drop-in is what stops
# hibernation, the EFI HibernateLocation route included, so it goes first.
HIB_DROPIN=/etc/systemd/sleep.conf.d/50-mainstream-no-hibernate.conf
HIB_STAMP=/var/lib/mainstream/hibernation-plain-swap-off
_hib_plain_resume_dev() {  # prints the swap device and the resume= token
    local line tok spec="" n=0 dev root f
    # cmdline_remove writes the file back as a single line, so a file it could
    # not carry over word for word, one with a comment or a second line, is
    # left alone.
    [[ "$(grep -c '[^[:space:]]' /etc/kernel/cmdline)" -eq 1 ]] \
        && ! grep -q '#' /etc/kernel/cmdline || return 1
    line="$(cat /etc/kernel/cmdline)"
    for tok in $line; do
        case "$tok" in
            resume=*) spec="${tok#resume=}"; n=$((n + 1)) ;;
            resume_offset=*) return 1 ;;
        esac
    done
    [[ $n -eq 1 && -n "$spec" ]] || return 1
    grep -Eq '(^|[[:space:]])(rd\.luks\.(name|uuid)|luks\.(name|uuid)|cryptdevice)=' <<<"$line" || return 1
    root="$(_gpu_root_source)"
    [[ -n "$root" && "$(_gpu_dev_class "$root")" == encrypted ]] || return 1
    for f in /etc/default/limine /etc/limine-entry-tool.conf \
             /etc/limine-entry-tool.d/*.conf /usr/share/limine-entry-tool.d/*.conf; do
        [[ -f "$f" ]] || continue
        grep -Eq '^[[:space:]]*KERNEL_CMDLINE' "$f" && return 1
    done
    case "$spec" in
        /dev/*) dev="$spec" ;;
        PARTUUID=*|UUID=*|PARTLABEL=*|LABEL=*) dev="$(findfs "$spec" 2>/dev/null)" || return 1 ;;
        *) return 1 ;;
    esac
    [[ -n "$dev" ]] && _gpu_is_block "$dev" || return 1
    [[ "$(_gpu_dev_class "$dev")" == part ]] || return 1
    [[ "$(lsblk -d -n -o FSTYPE "$dev" 2>/dev/null)" == swap ]] || return 1
    printf '%s resume=%s\n' "$dev" "$spec"
}
if [[ ! -e "$HIB_STAMP" && ! -e "$HIB_DROPIN" && -f /etc/kernel/cmdline ]] \
   && grep -Eq '(^|[[:space:]])resume=' /etc/kernel/cmdline \
   && _src_ok "$GPU_LIB_SRC"; then
    # shellcheck source=/dev/null
    source "$GPU_LIB_SRC"
    if _hib_found="$(_hib_plain_resume_dev)"; then
        read -r _hib_dev _hib_tok <<<"$_hib_found"
        say "$(tf "The root is encrypted and its hibernation swap %s is not; turning hibernation off." "$_hib_dev")"
        if mkdir -p "${HIB_DROPIN%/*}" \
           && printf '%s\n' '[Sleep]' AllowHibernation=no AllowSuspendThenHibernate=no AllowHybridSleep=no \
                > "$HIB_DROPIN"; then
            ok "$(t "Hibernation is off, so memory is no longer written to that swap unencrypted.")"
            mkdir -p "${HIB_STAMP%/*}" && : > "$HIB_STAMP"
            GPU_SUDO='' KERNEL_CMDLINE=/etc/kernel/cmdline cmdline_remove resume
            if grep -Eq '(^|[[:space:]])resume=' /etc/kernel/cmdline; then
                warn "$(t "Could not take resume= out of /etc/kernel/cmdline.")"
                RC=1
            elif [[ " $(cat /proc/cmdline 2>/dev/null) " == *" $_hib_tok "* ]] \
                 && command -v limine-mkinitcpio >/dev/null 2>&1; then
                # The boot images carry their command line, so they would keep
                # looking for an image on that swap until the next kernel update.
                say "$(t "Rebuilding the boot images without resume=...")"
                _inhibit=()
                command -v systemd-inhibit >/dev/null 2>&1 \
                    && _inhibit=(systemd-inhibit --what=shutdown:sleep --mode=block --who="Mainstream OS" --why="Rebuilding the boot image")
                # Into a file, and shown once it is done: straight into the
                # page's pipe, a Settings window closed partway through would
                # end the build halfway through writing a boot image.
                _hib_log="$(mktemp)" || _hib_log=/dev/null
                "${_inhibit[@]}" limine-mkinitcpio </dev/null >"$_hib_log" 2>&1
                _hib_rc=$?
                [[ "$_hib_log" == /dev/null ]] || { sed 's/^/    /' "$_hib_log"; rm -f "$_hib_log"; }
                if [[ $_hib_rc -eq 0 ]]; then
                    ok "$(t "Boot images rebuilt without resume=.")"
                else
                    warn "$(t "The boot images were not rebuilt; the next kernel update rebuilds them without resume=.")"
                    RC=1
                fi
            fi
        else
            warn "$(tf "Could not write %s; hibernation stays on." "$HIB_DROPIN")"
            RC=1
        fi
    fi
fi

# ── Install leftovers ──────────────────────────────────────────────────────
# The finalize step that sweeps these runs at install time only, so a machine
# installed before it covered them is still carrying the dotfiles archive the
# image ships and archiso's build-date stamp. Nothing reads either once the
# install is done: updatems keeps its own clone under the user's cache.
# /tmp/dotfiles-setup is listed too for the installs whose /tmp is real
# storage. Where /tmp is a tmpfs the unpacked copy underneath it cannot be
# reached from a running system, and it is inert there.
if [[ -f /run/archiso/bootmnt/arch/version ]] || mountpoint -q /run/archiso 2>/dev/null; then
    :
else
    for _leftover in /usr/local/share/dots-hyprland.tar.zst /tmp/dotfiles-setup /version; do
        [[ -e "$_leftover" ]] || continue
        if rm -rf -- "$_leftover"; then
            ok "$(tf "Removed the install leftover %s" "$_leftover")"
        else
            warn "$(tf "Could not remove %s" "$_leftover")"
            RC=1
        fi
    done

    # The live image lets root sign in over SSH with a password, and installs
    # from before the finalize step removed that drop-in still carry it: the
    # moment someone turns sshd on, it would take root's password. Only the
    # untouched copy goes; a file someone changed is theirs.
    _ssh_dropin=/etc/ssh/sshd_config.d/10-archiso.conf
    if [[ -f "$_ssh_dropin" && ! -L "$_ssh_dropin" ]] \
        && ! pacman -Qqo "$_ssh_dropin" >/dev/null 2>&1 \
        && [[ "$(cat "$_ssh_dropin")" == $'# Allow root login using password authentication\nPasswordAuthentication yes\nPermitRootLogin yes' ]]; then
        if rm -f -- "$_ssh_dropin"; then
            ok "$(t "Removed the installer's setting that let root sign in over SSH with a password")"
            systemctl try-reload-or-restart sshd.service 2>/dev/null || true
        else
            warn "$(tf "Could not remove %s" "$_ssh_dropin")"
            RC=1
        fi
    fi

    # The rest of what the live session leaves in /etc that the finalize step
    # now sweeps: a lid and suspend key that do nothing, a journal that
    # forgets every boot, a console trying to sign in an account that is gone,
    # the live resolver and NVIDIA options. The same test as above: unowned,
    # not a link, and exactly as an image shipped it.
    _nvidia_live_redundant() {
        # The live options carry modeset=1, which some of these machines ask
        # for nowhere else; they go once the machine's own options do, or
        # where no NVIDIA display is there to need them.
        grep -qs 'nvidia-drm modeset=1' /etc/modprobe.d/nvidia.conf && return 0
        local d
        for d in /sys/bus/pci/devices/*; do
            [[ "$(cat "$d/vendor" 2>/dev/null)" == 0x10de && "$(cat "$d/class" 2>/dev/null)" == 0x03* ]] && return 1
        done
        return 0
    }
    # g_wheel gave every administrator root without a password so the live
    # session could run the installer. It goes only where another rule still
    # lets administrators use sudo with theirs, which the installer wrote.
    _wheel_keeps_sudo() {
        local f
        for f in /etc/sudoers /etc/sudoers.d/*; do
            [[ -f "$f" && "$f" != /etc/sudoers.d/g_wheel ]] || continue
            grep -qE '^[[:space:]]*%wheel[[:space:]]+ALL[[:space:]]*=[[:space:]]*\(ALL(:ALL)?\)[[:space:]]+ALL[[:space:]]*$' "$f" && return 0
        done
        return 1
    }
    # A hook the live image's boot used; mkinitcpio fails outright if a
    # configuration still names one that is gone.
    _gsp_hook_unused() {
        ! grep -rqs 'nvidia-gsp-strip' /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/
    }
    _reload_logind=0 _reload_units=0 _reload_resolved=0 _journal_dir=0
    while read -r _leftover _sums; do
        [[ -f "$_leftover" && ! -L "$_leftover" ]] || continue
        pacman -Qqo "$_leftover" >/dev/null 2>&1 && continue
        [[ " $_sums " == *" $(md5sum < "$_leftover" | cut -d' ' -f1) "* ]] || continue
        [[ "$_leftover" != */nvidia-live.conf ]] || _nvidia_live_redundant || continue
        [[ "$_leftover" != */sudoers.d/g_wheel ]] || _wheel_keeps_sudo || continue
        [[ "$_leftover" != */nvidia-gsp-strip ]] || _gsp_hook_unused || continue
        if rm -f -- "$_leftover"; then
            ok "$(tf "Removed %s, left behind by the installer's live session" "$_leftover")"
            case "$_leftover" in
                */logind.conf.d/*)          _reload_logind=1 ;;
                */getty@tty1.service.d/*)   _reload_units=1 ;;
                */resolved.conf.d/*)        _reload_resolved=1 ;;
                */journald.conf.d/*)        _journal_dir=1 ;;
            esac
        else
            warn "$(tf "Could not remove %s" "$_leftover")"
            RC=1
        fi
    done <<'LIVE_LEFTOVERS'
/etc/systemd/logind.conf.d/do-not-suspend.conf 4b048fe0a1ea96ae4090aa8fd202322b
/etc/systemd/journald.conf.d/volatile-storage.conf 38a8ebba73bb122b54d90ae9a5220eb6
/etc/systemd/system/getty@tty1.service.d/autologin.conf b711780346682e17bb32e3c9da0984a3 f452e360b605a39aa0f378960b79f7e3 b016d08b0deadd4edffd24da5f9f50ae
/etc/systemd/resolved.conf.d/archiso.conf 205649a7db506d9f31cc15f440a1b81f
/etc/modprobe.d/nvidia-live.conf 4cc10f2193d8d2b2fdb5647fb7d37713
/etc/sudoers.d/g_wheel 80bed5eba711f3755e088a58cd1dbb21
/etc/sudoers.d/liveuser 228f342dc4e3bb421502a259ee676a0a
/etc/initcpio/install/nvidia-gsp-strip c382dd2ff279666b2073cafca33e3bc3
LIVE_LEFTOVERS
    # The live account's home, which the installer's account removal leaves
    # behind. Only while no account on this machine lives there.
    if [[ -d /home/liveuser && ! -L /home/liveuser ]] && ! id liveuser >/dev/null 2>&1 \
       && ! getent passwd | cut -d: -f6 | grep -qx /home/liveuser; then
        if rm -rf --one-file-system -- /home/liveuser; then
            ok "$(tf "Removed %s, left behind by the installer's live session" /home/liveuser)"
        else
            warn "$(tf "Could not remove %s" /home/liveuser)"
            RC=1
        fi
    fi
    # logind rereads its settings on a hangup, the way the power button helper
    # asks it to, without touching a session. journald keeps what it started
    # with until the next boot, which then keeps its logs in the directory.
    [[ $_reload_logind -eq 1 ]] && { systemctl kill -s HUP systemd-logind.service 2>/dev/null || true; }
    [[ $_reload_units -eq 1 ]] && { systemctl daemon-reload 2>/dev/null || true; }
    [[ $_reload_resolved -eq 1 ]] && { systemctl try-reload-or-restart systemd-resolved.service 2>/dev/null || true; }
    if [[ $_journal_dir -eq 1 && ! -d /var/log/journal ]]; then
        mkdir -p /var/log/journal && { systemd-tmpfiles --create --prefix /var/log/journal 2>/dev/null || true; }
    fi
fi

if [[ $RC -eq 0 ]]; then
    ok "$(t "System-level refresh complete.")"
else
    warn "$(t "System-level refresh finished with errors (see above).")"
fi
exit "$RC"
