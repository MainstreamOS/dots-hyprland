#!/usr/bin/env bash
# updatems-system — refresh Mainstream OS system-level files after a
# dotfiles tag bump. Invoked from the privileged mainstream-update-helper
# (section 5b) right after the user-level updatems step, so it runs as
# root and writes to /usr/share, /usr/share/polkit-1, and /usr/local/bin.
#
# Scope: file copies only. Specifically:
#   /usr/share/plymouth/themes/mainstream/   (Plymouth boot splash theme)
#   /usr/share/polkit-1/actions/...sddm-bg.policy
#   /usr/share/polkit-1/rules.d/50-sddm-bg.rules
#   /usr/local/bin/sddm-bg-helper
#   /usr/local/bin/mainstream-update-helper  (the helper that just ran us)
#   /usr/local/bin/updatems                  (the user-level command)
#   /usr/local/bin/updatems-system           (this script itself)
#
# Deliberately NOT done here:
#   - mkinitcpio rebuild (1–2 min per kernel × N kernels). Plymouth
#     reads its theme dir at boot, so a refreshed theme becomes active
#     on the next mkinitcpio run that the user triggers anyway.
#   - plymouth-set-default-theme (one-time install-time concern; already
#     pointing at "mainstream").
#   - /etc/kernel/cmdline rewrites for splash/quiet flags (set once at
#     install).
#
# For those install-time concerns, the user can still run:
#   cd ~/.cache/dots-hyprland && ./setup install-setups
#
# Usage: updatems-system [REPO_DIR]
#   REPO_DIR defaults to ~$ORIG_USER/.cache/dots-hyprland — the path
#   updatems uses for its clone. The helper passes this explicitly so
#   we don't have to resolve it ourselves.
set -u

[[ $EUID -eq 0 ]] || { echo "updatems-system: must run as root" >&2; exit 1; }

# Resolve REPO_DIR. Argument > $SUDO_USER's clone > $HOME's clone.
if [[ -n "${1:-}" ]]; then
    REPO_DIR="$1"
elif [[ -n "${SUDO_USER:-}" ]]; then
    REPO_DIR="$(getent passwd "$SUDO_USER" | cut -d: -f6)/.cache/dots-hyprland"
else
    REPO_DIR="$HOME/.cache/dots-hyprland"
fi

if [[ ! -d "$REPO_DIR/.git" ]]; then
    echo "updatems-system: no dots-hyprland clone at $REPO_DIR" >&2
    echo "  hint: run updatems as your user first to bootstrap the clone." >&2
    exit 1
fi

c_blue=$'\e[38;5;80m'; c_green=$'\e[38;5;79m'
c_yellow=$'\e[38;5;221m'; c_rst=$'\e[0m'
say()  { printf '%s==>%s %s\n' "$c_blue"   "$c_rst" "$*"; }
ok()   { printf '%s OK%s  %s\n' "$c_green"  "$c_rst" "$*"; }
warn() { printf '%s ! %s  %s\n' "$c_yellow" "$c_rst" "$*" >&2; }

cd "$REPO_DIR" || { echo "cannot cd to $REPO_DIR" >&2; exit 1; }

# Hand over to the copy the release being applied ships, rather than running
# the one the previous release installed. The update helper calls this script
# by name, so without this every step added here waits a whole release to
# take effect, and it refreshes itself at the end — one release too late to
# do the work it was added for. The guard variable keeps the handover from
# looping if the install fails to change anything.
if [[ -z "${UPDATEMS_SYSTEM_REEXEC:-}" && -f "$REPO_DIR/sdata/update/updatems-system" \
      && ! -L "$REPO_DIR/sdata/update/updatems-system" ]] \
   && [[ $(( 8#$(stat -c %a "$REPO_DIR/sdata/update/updatems-system" 2>/dev/null || echo 777) & 8#022 )) -eq 0 ]] \
   && ! cmp -s "$REPO_DIR/sdata/update/updatems-system" "$0"; then
    if install -m755 -o root -g root "$REPO_DIR/sdata/update/updatems-system" \
            /usr/local/bin/updatems-system 2>/dev/null; then
        export UPDATEMS_SYSTEM_REEXEC=1
        exec /usr/local/bin/updatems-system "$@"
    fi
fi

# Per-component rc tracking; any non-zero rolls up to a single soft fail
# (return 1). We DON'T abort on the first failure — best effort, refresh
# what we can.
RC=0
# Everything installed here runs as root later, and it comes out of a tree the
# user owns. A symlink or a file others can write is how a checkout that looks
# like a release turns into something else on the way in.
_src_ok() {
    local src="$1" mode
    [[ -f "$src" && ! -L "$src" ]] || return 1
    mode=$(stat -c %a "$src" 2>/dev/null) || return 1
    [[ $(( 8#$mode & 8#022 )) -eq 0 ]]
}
_install_file() {
    # $1 mode  $2 src  $3 dst  $4 label
    local mode="$1" src="$2" dst="$3" label="$4"
    if [[ ! -e "$src" ]]; then
        warn "$label source missing at $src — skipping"
        return 0
    fi
    if ! _src_ok "$src"; then
        warn "$label source is a symlink or writable by others ($src) — refusing to install it as root"
        RC=1
        return 0
    fi
    if install -m "$mode" -o root -g root "$src" "$dst"; then
        ok "$label refreshed -> $dst"
    else
        warn "$label install failed (src=$src dst=$dst)"
        RC=1
    fi
}

# ── Plymouth theme files (no rebuild — see header) ─────────────────────────
PLY_SRC="$REPO_DIR/sdata/plymouth/mainstream"
PLY_DST="/usr/share/plymouth/themes/mainstream"
if [[ -d "$PLY_SRC" ]]; then
    say "Refreshing Plymouth theme -> $PLY_DST"
    if rm -rf "$PLY_DST" && cp -r "$PLY_SRC" "$PLY_DST"; then
        chown -R root:root "$PLY_DST"
        find "$PLY_DST" -type d -exec chmod 755 {} +
        find "$PLY_DST" -type f -exec chmod 644 {} +
        ok "Plymouth theme refreshed (initramfs NOT rebuilt; takes effect on the next mkinitcpio pass)"
    else
        warn "Plymouth theme refresh failed"
        RC=1
    fi
else
    warn "No Plymouth source at $PLY_SRC — skipping"
fi

# ── SDDM background helper + polkit ────────────────────────────────────────
_install_file 0755 \
    "$REPO_DIR/dots/.config/quickshell/ii/scripts/colors/sddm-bg-helper.sh" \
    /usr/local/bin/sddm-bg-helper \
    "SDDM bg helper"

_install_file 0644 \
    "$REPO_DIR/sdata/polkit/org.illogicalimpulse.sddm-bg.policy" \
    /usr/share/polkit-1/actions/org.illogicalimpulse.sddm-bg.policy \
    "SDDM polkit action"

_install_file 0644 \
    "$REPO_DIR/sdata/polkit/50-sddm-bg.rules" \
    /usr/share/polkit-1/rules.d/50-sddm-bg.rules \
    "SDDM polkit rules"

# ── SDDM greeter config: .conf → .lua ──────────────────────────────────────
# Hyprland 0.56.1 puts a notice on screen for any .conf config and drops the
# format in 0.57. The greeter runs its own compositor, and its config is
# written by the installer — which an update never re-runs — so a machine
# installed before the switch would keep showing that notice at every login
# with nothing to clear it.
#
# Only touched when the directory already exists, so this never sets up a
# greeter on a machine that has not asked for one. Hyprland finds lua before
# conf, so writing the new file is what resolves it; the old one is moved
# aside afterwards, and only if the write succeeded.

# The repo copy of the greeter config carries no keyboard layout: the machine
# does. The installer appends the recorded layout to this file at first boot,
# and a pristine refresh would silently send a non-US greeter back to QWERTY,
# locking the password box to letters the keyboard does not have.
reseed_greeter_layout() {
    local target="$1" x11="/etc/X11/xorg.conf.d/00-keyboard.conf" layout="" variant=""
    if [[ -f "$x11" ]]; then
        layout=$(grep -oP 'Option\s+"XkbLayout"\s+"\K[^"]+' "$x11" 2>/dev/null | head -1)
        variant=$(grep -oP 'Option\s+"XkbVariant"\s+"\K[^"]*' "$x11" 2>/dev/null | head -1)
    fi
    if [[ -z "$layout" && -f /etc/vconsole.conf ]]; then
        layout=$(grep -oP '^KEYMAP=\K.*' /etc/vconsole.conf 2>/dev/null | tr -d '"' | head -1)
        layout="${layout%%-*}"
    fi
    [[ -n "$layout" ]] || return 0
    [[ "$layout" =~ ^[a-z]{2,8}(,[a-z]{2,8})*$ ]] || return 0
    [[ "$variant" =~ ^[a-z0-9_]*(,[a-z0-9_]*)*$ ]] || variant=""
    {
        printf '\nhl.config({\n    input = {\n        kb_layout = "%s",\n' "$layout"
        [[ -n "$variant" ]] && printf '        kb_variant = "%s",\n' "$variant"
        printf '    },\n})\n'
    } >> "$target"
}

GREETER_DIR=/var/lib/sddm/.config/hypr
GREETER_SRC="$REPO_DIR/sdata/sddm/hyprland.lua"
if [[ -d "$GREETER_DIR" ]]; then
    if [[ ! -f "$GREETER_SRC" ]]; then
        warn "SDDM greeter config source missing at $GREETER_SRC — skipping"
    elif install -m 600 -o sddm -g sddm "$GREETER_SRC" "$GREETER_DIR/hyprland.lua"; then
        reseed_greeter_layout "$GREETER_DIR/hyprland.lua"
        if [[ -f "$GREETER_DIR/hyprland.conf" ]]; then
            mv "$GREETER_DIR/hyprland.conf" "$GREETER_DIR/hyprland.conf.old"
            ok "SDDM greeter config moved to Lua (old kept as hyprland.conf.old)"
        else
            ok "SDDM greeter config refreshed -> $GREETER_DIR/hyprland.lua"
        fi
    else
        warn "SDDM greeter config install failed — leaving the existing one alone"
        RC=1
    fi
fi

# ── Printing ──────────────────────────────────────────────────────────────
# The spooler is reached through its socket rather than its service, and
# systemd starts it on the first print job. Arch ships no preset for cups and
# its default policy is `disable *`, so a machine nobody told to enable it
# simply cannot print. The installer tells a fresh install; one made before it
# learned to arrives here instead, which is the only route an existing machine
# has to the same fix.
#
# Skipped where cups is not installed at all: enabling a unit that is not there
# is not a failure worth reporting, and pulling in a package on an update is a
# bigger decision than this script gets to make.
if systemctl cat cups.socket &>/dev/null; then
    if systemctl is-enabled cups.socket &>/dev/null; then
        : # already on, nothing to say
    elif systemctl enable cups.socket &>/dev/null; then
        ok "Printing enabled (cups.socket)"
    else
        warn "Could not enable cups.socket"
        RC=1
    fi
fi

# Most home printers are found over mDNS and answer to a .local name, which
# nothing resolves until nss-mdns is named in nsswitch. The package installs the
# resolver and stops there, so a printer the machine can see advertised is still
# one it cannot reach. Inserted before `dns` so ordinary lookups are unchanged,
# and only when the entry is absent.
if [[ -f /etc/nsswitch.conf ]] && ! grep -q 'mdns_minimal' /etc/nsswitch.conf; then
    if sed -i -E 's/^(hosts:.*[[:space:]])(dns)([[:space:]]|$)/\1mdns_minimal [NOTFOUND=return] \2\3/' /etc/nsswitch.conf \
       && grep -q 'mdns_minimal' /etc/nsswitch.conf; then
        ok "Network printers resolvable (nss-mdns)"
    else
        warn "Could not add mdns_minimal to /etc/nsswitch.conf"
        RC=1
    fi
fi

# The rest of the printing experience, matching what a fresh install gets:
# the queue maker that gives an IPP-over-USB printer a permanent queue (the
# entry print dialogs list up front), the polkit rule that spares the
# printer app its unlock prompt, the test page that survives libcupsfilters
# 2.2, and queues that retry a failed job instead of stopping. The queue
# maker stays inert until ipp-usb arrives, which the mainstream-basic
# upgrade brings along on the same run.
# The queue maker, the printer-app unlock and the test-page hook now ship in
# mainstream-system, so they land with the package instead of from here. That
# matters most on the hop that first brings ipp-usb along: a machine that
# gained the daemon without the queue maker would have had its old USB queue
# claimed out from under it and nothing put in its place.
if [[ -f /usr/share/cups/data/default-testpage.pdf ]]; then
    cp /usr/share/cups/data/default-testpage.pdf /usr/share/cups/data/testprint || true
fi
if [[ -f /etc/cups/cupsd.conf ]] && ! grep -q '^ErrorPolicy' /etc/cups/cupsd.conf; then
    if cat >> /etc/cups/cupsd.conf <<'CUPSPOLICYEOF'

ErrorPolicy retry-job
JobRetryInterval 60
JobRetryLimit 5
CUPSPOLICYEOF
    then
        ok "CUPS queues retry rather than stop on a backend error"
    else
        warn "Could not set the CUPS error policy"
        RC=1
    fi
fi
# An earlier unreleased revision leaned on cups-browsed for the queue; its
# config gives way to the packaged queue maker. Only the config that revision
# wrote is removed: one a user authored themselves stays theirs.
if [[ -f /etc/cups/cups-browsed.conf ]] \
   && [[ "$(md5sum /etc/cups/cups-browsed.conf | cut -d' ' -f1)" == "aacb6fd7ddcab1c2e8a3f726abf1d9bf" ]]; then
    rm -f /etc/cups/cups-browsed.conf
fi
udevadm control --reload 2>/dev/null || true
systemctl daemon-reload 2>/dev/null || true
# A printer already plugged in gets its permanent queue on this run rather
# than at the next replug; with no printer this is a quiet no-op.
systemctl start mainstream-printer-setup.service 2>/dev/null || true

# ── pacman keyring + [mainstream] repo self-healing ───────────────────────
# This lands over git rather than over pacman, which is the only delivery path
# left on a machine whose [mainstream] signing key never got trusted: there
# pacman -Syu fails for every repo, core and extra included, so a fix shipped
# as a package could never arrive.
KEYRING_SRC="$REPO_DIR/sdata/keyring"

_install_file 0644 \
    "$REPO_DIR/sdata/dist-arch/mainstream.pub" \
    /usr/local/share/mainstream.pub \
    "[mainstream] signing key"

_install_file 0755 \
    "$KEYRING_SRC/mainstream-keyring-init" \
    /usr/local/bin/mainstream-keyring-init \
    "Keyring init"

_install_file 0755 \
    "$KEYRING_SRC/mainstream-keyring-repair" \
    /usr/local/bin/mainstream-keyring-repair \
    "Keyring repair command"

_install_file 0644 \
    "$KEYRING_SRC/pacman-keyring-init.service" \
    /etc/systemd/system/pacman-keyring-init.service \
    "Keyring init service"

_install_file 0644 \
    "$KEYRING_SRC/pacman-keyring-init.timer" \
    /etc/systemd/system/pacman-keyring-init.timer \
    "Keyring init timer"

systemctl daemon-reload 2>/dev/null || true
# Installs made while the unit disabled its own timer after one success have
# no watchdog left, so enabling here is what puts a stranded machine back
# under one.
if systemctl enable --now pacman-keyring-init.timer 2>/dev/null; then
    ok "Keyring check timer enabled"
else
    warn "Could not enable pacman-keyring-init.timer"
    RC=1
fi

if [[ -x /usr/local/bin/mainstream-keyring-init ]] \
   && ! /usr/local/bin/mainstream-keyring-init --check >/dev/null 2>&1; then
    say "Repairing the pacman keyring and [mainstream] repo..."
    /usr/local/bin/mainstream-keyring-init 2>&1 | sed 's/^/    /'
    if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
        ok "Keyring and [mainstream] repo verified"
    else
        warn "Keyring repair did not complete; the timer retries on its own"
        RC=1
    fi
fi

# ── Update tooling (refreshes itself + updatems + helper) ──────────────────
# Refreshing the helper while it's mid-run is safe on Linux — the
# kernel keeps the inode open via the existing fd until the process
# exits, then the new file takes over for subsequent invocations.
_install_file 0755 \
    "$REPO_DIR/sdata/update/mainstream-update-helper" \
    /usr/local/bin/mainstream-update-helper \
    "Update helper"

_install_file 0755 \
    "$REPO_DIR/sdata/update/updatems" \
    /usr/local/bin/updatems \
    "updatems"

_install_file 0755 \
    "$REPO_DIR/sdata/update/updatems-system" \
    /usr/local/bin/updatems-system \
    "updatems-system"

if [[ $RC -eq 0 ]]; then
    ok "System-level refresh complete."
else
    warn "System-level refresh finished with errors (see above)."
fi
exit "$RC"
