[Unit]
Description=Finish setting up Mainstream
ConditionPathExists=/var/log/mainstream-firstboot/options
Wants=NetworkManager.service
After=NetworkManager.service systemd-user-sessions.service
Before=getty@tty1.service display-manager.service

[Service]
Type=oneshot
RuntimeDirectory=mainstream-firstboot
RuntimeDirectoryMode=0750
ExecStart=/var/log/mainstream-firstboot/finish-fresh.sh
StandardInput=tty-force
StandardOutput=tty
StandardError=inherit
TTYPath=/dev/tty1
TTYReset=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
