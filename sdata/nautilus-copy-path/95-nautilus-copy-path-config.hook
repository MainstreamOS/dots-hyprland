# nautilus-copy-path hardcodes its config to the file shipped inside the
# package's own install dir — it never checks ~/.config or /etc. Flip
# the URI item to false after every install/upgrade so "Copy URI" is
# hidden from the context menu (Copy Path / Name / Content remain).

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = nautilus-copy-path

[Action]
Description = Disabling the nautilus-copy-path "Copy URI" menu entry...
When = PostTransaction
Exec = /bin/sh -c "sed -i 's/\"uri\": true/\"uri\": false/' /usr/share/nautilus-python/extensions/nautilus-copy-path/config.json"
