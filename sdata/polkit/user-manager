#!/usr/bin/env bash
# user-manager — create and manage accounts for the Accounts page in Settings
# (~/.config/quickshell/ii/modules/settings/AccountsConfig.qml).
# Installed at /usr/local/bin/user-manager.
#
# Subcommand dispatch:
#
#   list
#       Emit a JSON array of the machine's human accounts with their full
#       name, shell, home and whether they are an administrator. Read-only,
#       runs UNPRIVILEGED.
#
#   create <user> [full name]
#       Create the account and provision its home to the same standard the
#       installer applies to the first user. Reads the password from stdin,
#       and sets it LAST so the login screen cannot admit the account before
#       its home is ready. Invoked via pkexec.
#
#   provision <user>
#       Re-run provisioning over an existing account. This is what repairs an
#       account created before this helper existed, and it is deliberately
#       the same code path as create so the two cannot diverge.
#
#   set-password <user>       reads the new password from stdin
#   set-password <user> verify
#       Reads the current password first, on its own line, and changes
#       nothing unless it matches.
#   set-admin <user> yes|no   add to or remove from wheel
#   rename <user> <new name>  change the full name (GECOS), not the login
#   delete <user> keep-home|remove-home
#   set-avatar <user> <path>  install a face icon for the login screen
#
# Every subcommand except list is invoked via pkexec and matches the polkit
# action org.mainstreamos.user-manager. change-own-password also runs
# set-password <user> verify, under its own action and with no administrator.

set -euo pipefail
# pkexec keeps the caller's umask.
umask 022

PROVISION_LIB=/usr/local/lib/mainstream-provision-user.sh
# list runs unprivileged every time the page refreshes and needs none of it.
if [[ "${1:-}" != list && -r "$PROVISION_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$PROVISION_LIB"
fi

# Written to the provisioning log, so one file holds the whole story of an
# account: what was asked for, what ran, and what it found.
log() {
    local line f=/var/log/mainstream/user-provision.log
    printf -v line '%s [user-manager] %s' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
    printf '%s\n' "$line" >&2
    # Root appends here, so a log someone else could have swapped for a link is skipped.
    install -d -m 755 -o root -g root "${f%/*}" 2>/dev/null && [[ ! -L "$f" ]] \
        && printf '%s\n' "$line" >> "$f" 2>/dev/null || true
}
# Set while a verify run has not taken its account's lock: change-own-password
# gets that far with no administrator, so refusals there must not fill the log.
UNPROVEN=""
die() {
    if [[ -n "$UNPROVEN" ]]; then printf 'ERROR: %s\n' "$*" >&2; else log "ERROR: $*"; fi
    exit 22
}

# useradd's own rule, plus its 32-character ceiling. Checked here as the last
# stop rather than trusting the caller: this runs as root and the name reaches
# a shell command.
valid_name() {
    [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,30}\$?$ ]]
}

# Accounts below the login UID floor belong to the system. Refusing them here
# means no subcommand can be aimed at root or at a service account.
require_human_user() {  # $1 = user
    local uid
    valid_name "$1" || die "not a valid user name: $1"
    uid="$(id -u "$1" 2>/dev/null)" || die "no such user: $1"
    (( uid >= 1000 && uid < 65534 )) || die "refusing to act on system account: $1"
}

# The account the Settings page is running as must not be able to lock itself
# out, and the machine must keep at least one administrator.
last_admin() {  # $1 = user
    local name uid shell
    [[ " $(id -nG "$1" 2>/dev/null) " == *" wheel "* ]] || return 1
    while IFS=: read -r name _ uid _ _ _ shell; do
        [[ "$name" != "$1" ]] && _usable_admin "$name" "$uid" "$shell" && return 1
    done < <(getent passwd)
    return 0
}

# Someone who can still sign in and act as an administrator: a person's account
# in wheel, as a member or by its primary group, neither locked nor expired.
_usable_admin() {  # $1 = user  $2 = uid  $3 = shell
    local uid="$2" shell="$3" pw expire
    (( uid >= 1000 && uid < 65534 )) || return 1
    _no_login_shell "$shell" && return 1
    [[ " $(id -nG "$1" 2>/dev/null) " == *" wheel "* ]] || return 1
    IFS=: read -r _ pw _ _ _ _ _ expire _ < <(getent shadow "$1") || return 1
    case "$pw" in '!'*|'*'*) return 1 ;; esac
    [[ -z "$expire" ]] || (( expire > $(date +%s) / 86400 ))
}

# A uid above the login floor is not enough to make an account a person: a
# daemon handed one would otherwise render as a card with Delete and a working
# Make-administrator switch. A shell that cannot log in says it is not.
_no_login_shell() {  # $1 = shell
    case "${1##*/}" in
        nologin|false|halt|shutdown|sync|"") return 0 ;;
        *) return 1 ;;
    esac
}

cmd_list() {
    local rows=()
    while IFS=: read -r name _ uid _ gecos home shell; do
        (( uid >= 1000 && uid < 65534 )) || continue
        _no_login_shell "$shell" && continue
        local admin=false
        id -nG "$name" 2>/dev/null | tr ' ' '\n' | grep -qx wheel && admin=true
        rows+=("$(jq -nc --arg name "$name" --arg fullName "${gecos%%,*}" \
                        --arg home "$home" --arg shell "$shell" --argjson admin "$admin" \
                   '{name:$name, fullName:$fullName, home:$home, shell:$shell, admin:$admin}')") \
            || die "could not build the account list"
    done < <(getent passwd)
    printf '%s\n' "${rows[@]}" | jq -cs . || die "could not build the account list"
}

cmd_create() {  # $1 = user  $2 = full name (optional)  $3 = "admin" to grant wheel
    local u="${1:-}" full="${2:-}" admin="${3:-}" pw base fresh=fresh
    valid_name "$u" || die "not a valid user name: $u"
    id "$u" >/dev/null 2>&1 && die "user already exists: $u"
    [[ -r "$PROVISION_LIB" ]] || die "provisioning library missing at $PROVISION_LIB"

    pw="$(cat)"
    [[ -n "$pw" ]] || die "no password supplied on stdin"
    # chpasswd takes one account per line, so anything after a line break
    # would be read as another account's password.
    [[ "$pw" != *$'\n'* ]] || die "a password cannot contain a line break"

    # -m seeds the home from /etc/skel, which is the whole point: the new
    # account starts from the same tree a fresh install starts from.
    # A home kept when an earlier account of this name was deleted is still
    # that person's, and useradd leaves it as it is rather than seeding it. It
    # is set up like any home in use, and a failed setup must not take it with
    # the account.
    base="$(useradd -D 2>/dev/null | sed -n 's/^HOME=//p')"
    [[ -e "${base:-/home}/$u" ]] && fresh=""

    log "creating $u"
    useradd -m -c "$full" -s /bin/bash "$u" || die "useradd failed for $u"

    # lastlog2 keys its records by name and userdel leaves them, so a new
    # account with an old name would read as logged in already and never get
    # its first-login setup. A kept home keeps its record with it.
    if [[ -n "$fresh" ]] && command -v lastlog2 >/dev/null 2>&1; then
        lastlog2 -C -u "$u" >/dev/null 2>&1 || true
    fi

    # Asked for here rather than by a second authenticated call afterwards: a
    # prompt the user dismisses at that point leaves an account that can already
    # be logged into as a standard user, whatever the switch said.
    if [[ "$admin" == admin ]]; then
        PROVISION_ADMIN=1
        log "$u will be an administrator"
    fi
    # No password has been set yet, so nothing can reach this account, and it
    # holds nothing anyone typed. Removing it leaves the machine as it was
    # rather than leaving a broken entry on the Accounts page.
    if ! provision_user_home "$u" "$fresh"; then
        log "provisioning failed for $u; removing the half-built account"
        if [[ -n "$fresh" ]]; then
            userdel -r "$u" >/dev/null 2>&1 || log "WARN: could not remove $u after the failed provision"
        else
            userdel "$u" >/dev/null 2>&1 || log "WARN: could not remove $u after the failed provision"
        fi
        die "could not set up a home for $u; the account was not created"
    fi

    # Last, so an account can never be reachable at the login screen before
    # its home is finished.
    printf '%s:%s\n' "$u" "$pw" | chpasswd || die "could not set the password for $u"
    log "$u created and provisioned"
}

cmd_provision() {  # $1 = user
    local u="${1:-}"
    require_human_user "$u"
    [[ -r "$PROVISION_LIB" ]] || die "provisioning library missing at $PROVISION_LIB"
    provision_user_home "$u" || die "provisioning failed for $u"
    log "$u provisioned"
}

# The stored hash is checked with the same crypt(3) the login stack uses, so
# whatever scheme /etc/login.defs picked (yescrypt here) is handled by libcrypt
# rather than reimplemented.
_password_matches() {  # $1 = user  $2 = password
    local hash
    hash="$(getent shadow "$1" 2>/dev/null | cut -d: -f2)"
    # A locked or empty entry has no password to match, so nothing can verify.
    case "$hash" in ''|'!'*|'*'*) return 1 ;; esac
    HASH="$hash" PW="$2" python3 -I -c '
import ctypes, os, sys
lib = ctypes.CDLL("libcrypt.so.2")
lib.crypt.restype = ctypes.c_char_p
lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
h = os.environ["HASH"].encode()
got = lib.crypt(os.environ["PW"].encode(), h)
sys.exit(0 if got and got == h else 1)
' 2>/dev/null
}

# change-own-password reaches this without an administrator, and pam_faillock
# never sees a crypt(3) check, so each account gets one check every 2s.
_check_current_password() {  # $1 = user  $2 = password
    local lock fd mask
    # The caller's terminal can still signal this root process, and ending a
    # wrong guess's wait early would release the lock for the next one.
    trap '' INT QUIT HUP
    lock="/run/lock/mainstream-password-check-$(id -u "$1").lock"
    # Readable is enough to hold a flock, so anyone who could open it could
    # keep an account from ever changing its password here.
    mask="$(umask)"; umask 077
    { exec {fd}>>"$lock"; } 2>/dev/null || die "could not open $lock"
    umask "$mask"
    flock -w 30 "$fd" || die "another password check for $1 is still running"
    UNPROVEN=""
    log "$INVOKED"
    if ! _password_matches "$1" "$2"; then
        sleep 2
        die "the current password is not correct"
    fi
    # A match holds the lock 2s as well, through a sleep that inherits it, so
    # repeated changes cannot fill the log and the caller is not kept waiting.
    sleep 2 </dev/null >/dev/null 2>&1 &
    exec {fd}>&-
}

cmd_set_password() {  # $1 = user  $2 = "verify" to require the current password first
    local u="${1:-}" mode="${2:-}" old="" pw
    require_human_user "$u"
    if [[ "$mode" == verify ]]; then
        # Two lines on stdin, current then new, so neither ever reaches argv.
        IFS= read -r old || true
        [[ -n "$old" ]] || die "no current password supplied"
        _check_current_password "$u" "$old"
    fi
    pw="$(cat)"
    pw="${pw%$'\n'}"
    [[ -n "$pw" ]] || die "no password supplied on stdin"
    [[ "$pw" != *$'\n'* ]] || die "a password cannot contain a line break"
    printf '%s:%s\n' "$u" "$pw" | chpasswd || die "could not set the password for $u"
    log "password changed for $u"
}

cmd_set_admin() {  # $1 = user  $2 = yes|no
    local u="${1:-}" want="${2:-}"
    require_human_user "$u"
    case "$want" in
        yes) usermod -aG wheel "$u"; log "$u is now an administrator" ;;
        no)
            last_admin "$u" && die "$u is the only administrator who can sign in; promote someone else first"
            gpasswd -d "$u" wheel >/dev/null 2>&1 || true
            log "$u is no longer an administrator" ;;
        *) die "expected yes or no, got: $want" ;;
    esac
}

cmd_rename() {  # $1 = user  $2 = new full name
    local u="${1:-}" full="${2:-}"
    require_human_user "$u"
    usermod -c "$full" "$u" || die "could not rename $u"
    log "full name updated for $u"
}

# Folder sharing keeps per-account state where userdel does not look: the
# Samba password, the usershare files the account wrote, its entry on the
# usershare directory's ACL and the Sharing page's marker. Left behind, an
# account later given the same name would sign in with the old password, and
# one given the same uid would own the old shares, a kept home among them.
SAMBA_CONF=/etc/samba/smb.conf
USERSHARE_DIR=/var/lib/samba/usershares
SHARING_USERS_DIR=/var/lib/mainstream/sharing/users

# Runs after userdel, so a delete that fails (the account is still logged in)
# leaves sharing as it was. Nothing here is fatal: the account is already gone.
_sharing_cleanup() {  # $1 = user  $2 = the uid it had
    local u="$1" uid="$2" out acl
    # Without a config there are no Samba accounts to remove, and pdbedit run
    # as root would create an empty password database just to look.
    if [[ -f "$SAMBA_CONF" ]] && command -v pdbedit >/dev/null 2>&1; then
        # pdbedit warns that the Unix account is gone and removes the entry
        # anyway. An account that never set sharing up has none to remove.
        if out="$(pdbedit -s "$SAMBA_CONF" -x -u "$u" 2>&1)"; then
            log "removed the sharing password for $u"
        elif [[ "$out" != *"does not exist in the passdb"* ]]; then
            log "WARN: could not remove the sharing password for $u: ${out##*$'\n'}"
        fi
    fi
    if [[ -d "$USERSHARE_DIR" && ! -L "$USERSHARE_DIR" ]]; then
        # Everyone in sambashare can write here, so a file's name says nothing
        # about whose share it is: only its owner does. A link could point
        # anywhere, and nothing below the top level is a share.
        find "$USERSHARE_DIR" -mindepth 1 -maxdepth 1 -type f -uid "$uid" -delete \
            || log "WARN: could not remove every folder $u shared"
        # By number, since the name stopped resolving when userdel ran. Read
        # whole rather than piped into grep -q, which pipefail can turn into a
        # miss when getfacl is cut off mid-write.
        acl="$(getfacl -cnp "$USERSHARE_DIR" 2>/dev/null || true)"
        if grep -q "^user:$uid:" <<<"$acl"; then
            setfacl -x "u:$uid" "$USERSHARE_DIR" \
                || log "WARN: could not take $u off the usershare directory's access list"
        fi
    fi
    rm -f -- "$SHARING_USERS_DIR/$u" || log "WARN: could not remove the sharing marker for $u"
}

cmd_delete() {  # $1 = user  $2 = keep-home|remove-home
    local u="${1:-}" mode="${2:-keep-home}" uid home
    require_human_user "$u"
    [[ "$u" == "$(id -un "${PKEXEC_UID:-0}" 2>/dev/null)" ]] && die "refusing to delete the account asking"
    last_admin "$u" && die "$u is the only administrator who can sign in; promote someone else first"
    uid="$(id -u "$u")"
    home="$(getent passwd "$u" | cut -d: -f6)"
    case "$mode" in
        remove-home) userdel -r "$u" || die "could not delete $u" ;;
        keep-home)
            userdel "$u" || die "could not delete $u"
            # The kept files still carry the old account's number, which
            # useradd hands to the next account it makes. Closed to everyone
            # but root until an account of this name is made again.
            if [[ -n "$home" && "$home" != / && -d "$home" && ! -L "$home" ]]; then
                chown root:root "$home" && chmod 700 "$home" \
                    || log "WARN: could not close $home to the next account"
            fi
            ;;
        *) die "expected keep-home or remove-home, got: $mode" ;;
    esac
    # The login screen finds pictures and settings by name, so a later
    # account of this name would otherwise show this person's.
    rm -f -- "/var/lib/AccountsService/users/$u" "/var/lib/AccountsService/icons/$u"
    log "$u deleted ($mode)"
    _sharing_cleanup "$u" "$uid"
}

cmd_set_avatar() {  # $1 = user  $2 = source image
    local u="${1:-}" src="${2:-}" home dest conf edge tmp
    local -a as_caller=()
    require_human_user "$u"
    [[ -f "$src" && ! -L "$src" ]] || die "not a regular file: $src"
    # Read as whoever asked, so the path cannot name a file only root may read
    # and have it published as a picture anyone can open.
    if [[ -n "${PKEXEC_UID:-}" ]]; then
        as_caller=(setpriv --reuid="$PKEXEC_UID" --regid="$(id -g "$PKEXEC_UID")" --init-groups --)
    fi
    home="$(getent passwd "$u" | cut -d: -f6)"
    dest="/var/lib/AccountsService/icons/$u"
    conf="/var/lib/AccountsService/users/$u"
    mkdir -p /var/lib/AccountsService/icons /var/lib/AccountsService/users

    # Normalized rather than copied as picked. The login screen draws the
    # avatar at 272 logical pixels, over 500 real ones on a HiDPI panel, so a
    # small picture arrives there enlarged and soft, and a large one leaves a
    # multi-megabyte photo in /var/lib for a circle a couple of hundred pixels
    # across. Square-cropped from the middle, capped at 512, and never scaled
    # up, since enlarging here would add weight and not detail.
    # The first frame is taken by dropping the rest, not by the [0] selector:
    # ImageMagick copies a selected frame to a temporary file with no
    # extension and then cannot work out how to read it back, whatever the
    # format, so every picture fell through to an unresized copy.
    # Read whole, then take the first line. Piping into head lets identify die
    # on SIGPIPE, and under pipefail the `|| echo 0` then APPENDS to what it had
    # already printed, giving a two-line value that falls through to a plain copy.
    edge="$("${as_caller[@]}" identify -format '%[fx:min(w,h)]\n' "$src" 2>/dev/null || true)"
    edge="${edge%%$'\n'*}"
    case "$edge" in ''|*[!0-9]*) edge=0 ;; esac
    # Written beside the current picture and moved over it, so a file that
    # cannot be read leaves that picture in place.
    tmp="$(mktemp "$dest.XXXXXX")"
    if [[ "$edge" -gt 0 ]]; then
        (( edge > 512 )) && edge=512
        # The destination carries no extension, so the format is named rather
        # than guessed from a filename that has nothing to guess from.
        "${as_caller[@]}" magick "$src" -auto-orient -delete 1--1 -resize "${edge}x${edge}^" \
            -gravity center -extent "${edge}x${edge}" PNG:- > "$tmp" \
            || { rm -f -- "$tmp"; die "could not prepare the image for $u"; }
    else
        "${as_caller[@]}" cat -- "$src" > "$tmp" \
            || { rm -f -- "$tmp"; die "could not copy the image for $u"; }
    fi
    chmod 644 "$tmp"
    mv -f -- "$tmp" "$dest"
    install -Dm644 -o "$u" -g "$(id -g "$u")" "$dest" "$home/.face"

    if [[ -f "$conf" ]] && grep -q '^Icon=' "$conf"; then
        sed -i "s|^Icon=.*|Icon=$dest|" "$conf"
    elif [[ -f "$conf" ]]; then
        sed -i "/^\[User\]/a Icon=$dest" "$conf"
    else
        printf '[User]\nIcon=%s\n' "$dest" > "$conf"
    fi

    # The only thing on stdout, so the page can say when a picture is smaller
    # than the login screen will draw it.
    printf '%s\n' "$edge"
    log "avatar set for $u (${edge}px)"
}

# Every invocation is recorded before it runs, minus anything from stdin,
# which is where passwords travel precisely so they never reach a log.
# A verify run is recorded once it holds its account's lock instead.
INVOKED="invoked: $* (by uid ${PKEXEC_UID:-$EUID})"
if [[ "${1:-}" == set-password && "${3:-}" == verify ]]; then
    UNPROVEN=1
elif [[ "${1:-}" != list ]]; then
    log "$INVOKED"
fi

case "${1:-}" in
    list)          cmd_list ;;
    create)        shift; cmd_create "$@" ;;
    provision)     shift; cmd_provision "$@" ;;
    set-password)  shift; cmd_set_password "$@" ;;
    set-admin)     shift; cmd_set_admin "$@" ;;
    rename)        shift; cmd_rename "$@" ;;
    delete)        shift; cmd_delete "$@" ;;
    set-avatar)    shift; cmd_set_avatar "$@" ;;
    *) die "unknown subcommand: ${1:-<none>}" ;;
esac
