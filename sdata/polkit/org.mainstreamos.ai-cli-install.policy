<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
    polkit action for the AI sidebar's fallback CLI installer.

    Like the local-model helper, this ships no companion .rules file granting
    a passwordless path. Installing a package is not something that should
    happen silently on behalf of a click, and the prompt is paid at most once
    per CLI: the sidebar reaches this only when the vendor's own rootless
    installer could not fetch, and never again once the command exists.
    auth_admin everywhere, no _keep, because there is no second invocation
    for a cache to help.

    The exec.path annotation binds this policy to the system-installed
    helper. pkexec invocations with /usr/local/bin/ai-cli-install as the
    target program automatically match this action.
-->
<policyconfig>
    <vendor>Mainstream OS</vendor>
    <vendor_url>https://mainstreamos.org</vendor_url>
    <icon_name>applications-science</icon_name>

    <action id="org.mainstreamos.ai-cli-install">
        <description>Install an AI assistant command</description>
        <description xml:lang="en_US">Install an AI assistant command</description>
        <message>Authentication is required to install an AI assistant command</message>
        <message xml:lang="en_US">Authentication is required to install an AI assistant command</message>
        <defaults>
            <allow_any>auth_admin</allow_any>
            <allow_inactive>auth_admin</allow_inactive>
            <allow_active>auth_admin</allow_active>
        </defaults>
        <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/ai-cli-install</annotate>
        <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
    </action>
</policyconfig>
