#!/usr/bin/env bash
# mainstream-efi-resize: grows the EFI system partition for Settings > Storage, run through pkexec.
# Builds a replacement in free space or at the end of a single-device Btrfs volume.
# The original boot partition stays bootable until the replacement is verified.
#
# Usage: mainstream-efi-resize probe [target_mb] | plan | resize <target_mb> | recover | cancel,
# printing JSON progress lines. "mirror", run by a boot hook, brings the old partition's boot files
# in step while it waits to be retired.

set -euo pipefail
export LC_ALL=C
# Settings may close mid-run and take the progress pipe with it; the resize still has to finish.
trap '' PIPE HUP

MIN_TARGET_MB=1024
MAX_TARGET_MB=16384
BTRFS_SAFETY_MARGIN_BYTES=$((4 * 1024 * 1024 * 1024)) # Keep >= 4 GiB free on root Btrfs
SHRINK_CUSHION_BYTES=$((128 * 1024 * 1024))          # 128 MiB temporary cushion during GPT shrink
ESP_GPT_TYPE="C12A7328-F81F-11D2-BA4B-00A0C93EC93B"

FSTAB_PATH="${EFI_RESIZE_FSTAB:-/etc/fstab}"
BOOT_LOCK="${EFI_RESIZE_LOCK:-/run/lock/boot-partition.lock}"
BACKUP_BASE="${EFI_RESIZE_BACKUP_BASE:-/var/cache/mainstream}"
CUTOVER_STATE="${EFI_RESIZE_STATE:-/var/lib/mainstream/efi-resize.pending}"
BUILD_STATE="$(dirname -- "$CUTOVER_STATE")/efi-resize.building"
RETIRE_STATE="$(dirname -- "$CUTOVER_STATE")/efi-resize.retire"
RESIZE_LOCK=/run/lock/mainstream-efi-resize.lock
MOUNT_OVERRIDE="${EFI_RESIZE_MOUNT:-}"
SKIP_NVRAM="${EFI_RESIZE_SKIP_NVRAM:-0}"
FORCE_UEFI="${EFI_RESIZE_FORCE_UEFI:-0}"
MIN_FREE_OVERRIDE="${EFI_RESIZE_BTRFS_MARGIN_BYTES:-}"
if [[ -n "$MIN_FREE_OVERRIDE" && "$MIN_FREE_OVERRIDE" =~ ^[0-9]+$ ]]; then
    BTRFS_SAFETY_MARGIN_BYTES="$MIN_FREE_OVERRIDE"
fi

emit_progress() {
    local step="$1" pct="$2" msg="$3"
    jq -nc --arg step "$step" --argjson pct "$pct" --arg msg "$msg" \
        '{step: $step, percent: $pct, message: $msg}' 2>/dev/null || true
}

die_json() {
    local msg="$1"
    jq -nc --arg msg "$msg" '{step: "error", percent: 0, error: true, message: $msg}' 2>/dev/null || true
    exit 1
}

# For the system log: what a best effort step left undone. The progress lines are read as the
# result of the resize, so these stay out of them.
log_note() {
    logger -t mainstream-efi-resize -- "$1" 2>/dev/null || printf '%s\n' "$1" >&2 || true
}

# Only a partition typed as the EFI System Partition, wherever it is mounted: a FAT data partition
# at /efi or /boot/efi would otherwise be the one grown and formatted.
is_esp_partition() {
    local ptype
    ptype="$(lsblk -dno PARTTYPE "$1" 2>/dev/null || true)"
    # A minimal recovery environment may have no udev partition properties yet.
    [[ -n "$ptype" ]] || ptype="$(blkid -p -s PART_ENTRY_TYPE -o value "$1" 2>/dev/null || true)"
    [[ "${ptype,,}" == "${ESP_GPT_TYPE,,}" ]]
}

find_esp_mount() {
    if [[ -n "$MOUNT_OVERRIDE" ]]; then
        if mountpoint -q "$MOUNT_OVERRIDE" 2>/dev/null; then
            local fstype src
            fstype="$(findmnt -n -o FSTYPE -M "$MOUNT_OVERRIDE" 2>/dev/null | tail -n 1 || true)"
            src="$(findmnt -nv -o SOURCE -M "$MOUNT_OVERRIDE" 2>/dev/null | tail -n 1 || true)"
            if [[ "$fstype" == "vfat" && -b "$src" ]] && is_esp_partition "$src"; then
                printf '%s\n' "$MOUNT_OVERRIDE"
                return 0
            fi
        fi
        return 1
    fi

    local mp fstype src
    for mp in /boot/efi /efi /boot; do
        # An automount that has not fired yet shows only itself until the path is used.
        stat -- "$mp/." >/dev/null 2>&1 || true
        mountpoint -q "$mp" 2>/dev/null || continue
        fstype="$(findmnt -n -o FSTYPE -M "$mp" 2>/dev/null | tail -n 1 || true)"
        [[ "$fstype" == "vfat" ]] || continue
        src="$(findmnt -nv -o SOURCE -M "$mp" 2>/dev/null | tail -n 1 || true)"
        [[ -n "$src" && -b "$src" ]] || continue
        is_esp_partition "$src" || continue
        printf '%s\n' "$mp"
        return 0
    done
    return 1
}

resolve_parent_disk() {
    local part_dev="$1" pk
    pk="$(lsblk -dno PKNAME "$part_dev" 2>/dev/null | head -n1 || true)"
    if [[ -n "$pk" ]]; then
        printf '/dev/%s\n' "$pk"
        return 0
    fi
    return 1
}

resolve_part_num() {
    local part_dev="$1" base
    base="$(basename "$part_dev")"
    if [[ -r "/sys/class/block/$base/partition" ]]; then
        cat "/sys/class/block/$base/partition"
        return 0
    fi
    lsblk -dno PARTN "$part_dev" 2>/dev/null | tr -d ' '
}

part_path_for_num() {
    local disk="$1" num="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then
        printf '%sp%s\n' "$disk" "$num"
    else
        printf '%s%s\n' "$disk" "$num"
    fi
}

# Resolves the live mountpoint for a block device (handling Btrfs [/subvol] sources)
find_mount_for_dev() {
    local target_dev="$1"
    findmnt -rn -o SOURCE,TARGET 2>/dev/null | awk -v dev="$target_dev" '
        {
            src = $1
            sub(/\[.*\]$/, "", src)
            if (src == dev) {
                if ($2 == "/") { root_hit = 1 }
                else if (!first_hit) { first_hit = $2 }
            }
        }
        END {
            if (root_hit) print "/"
            else if (first_hit) print first_hit
        }
    '
}

# Sets the ESP_*, DISK_LABEL, SECTOR_SIZE, *_LBA, STRATEGY, CAN_RESIZE, REASON, MAX_TARGET_BYTES, GAP_* and
# TAIL_* globals: the ESP and how it can grow to $1 MB (default 2048).
analyze_layout() {
    local req_mb="$1"
    local req_bytes

    ESP_MNT=""
    ESP_DEV=""
    ESP_UUID=""
    ESP_DISK=""
    ESP_PARTN=0
    ESP_TOTAL_BYTES=0
    ESP_USED_BYTES=0
    ESP_FREE_BYTES=0
    STRATEGY="unsupported"
    CAN_RESIZE="false"
    REASON=""
    MAX_TARGET_BYTES=0
    GAP_START_SEC=0
    GAP_SIZE_SEC=0
    TAIL_DEV=""
    TAIL_PARTN=0
    TAIL_START_SEC=0
    TAIL_SIZE_SEC=0
    TAIL_FSTYPE=""
    TAIL_MNT=""
    TAIL_FREE_BYTES=0

    if [[ "$FORCE_UEFI" != "1" && ! -d /sys/firmware/efi ]]; then
        REASON="System booted in legacy BIOS mode rather than UEFI."
        return 1
    fi

    ESP_MNT="$(find_esp_mount || true)"
    if [[ -z "$ESP_MNT" ]]; then
        REASON="No mounted FAT32 EFI System Partition found at /boot/efi, /efi, or /boot."
        return 1
    fi

    ESP_DEV="$(findmnt -nv -o SOURCE -M "$ESP_MNT" 2>/dev/null | tail -n 1 || true)"
    if [[ -z "$ESP_DEV" || ! -b "$ESP_DEV" ]]; then
        REASON="Could not resolve backing block device for $ESP_MNT."
        return 1
    fi
    if [[ "$ESP_DEV" == /dev/mapper/* || "$ESP_DEV" == /dev/dm-* || "$ESP_DEV" == /dev/md* ]]; then
        REASON="EFI partition ($ESP_DEV) is on a mapped or RAID device."
        return 1
    fi

    ESP_UUID="$(findmnt -n -o UUID -M "$ESP_MNT" 2>/dev/null | tail -n 1 || true)"
    [[ -n "$ESP_UUID" ]] || ESP_UUID="$(blkid -s UUID -o value "$ESP_DEV" 2>/dev/null || true)"
    ESP_DISK="$(resolve_parent_disk "$ESP_DEV" || true)"
    ESP_PARTN="$(resolve_part_num "$ESP_DEV" || true)"
    if [[ -z "$ESP_DISK" || ! -b "$ESP_DISK" || -z "$ESP_PARTN" ]]; then
        REASON="Could not resolve parent disk or partition number for $ESP_DEV."
        return 1
    fi

    ESP_TOTAL_BYTES="$(lsblk -bdno SIZE "$ESP_DEV" 2>/dev/null | tr -d ' ' || echo 0)"
    if ! read -r ESP_USED_BYTES ESP_FREE_BYTES < <(df -B1 --output=used,avail "$ESP_MNT" 2>/dev/null | tail -n1) \
        || [[ ! "$ESP_USED_BYTES" =~ ^[0-9]+$ || ! "$ESP_FREE_BYTES" =~ ^[0-9]+$ || ! "$ESP_TOTAL_BYTES" =~ ^[0-9]+$ ]]; then
        ESP_TOTAL_BYTES=0 ESP_USED_BYTES=0 ESP_FREE_BYTES=0
        REASON="Could not measure the EFI partition."
        return 1
    fi

    if ! [[ "$req_mb" =~ ^[1-9][0-9]{3,4}$ ]] || (( req_mb < MIN_TARGET_MB || req_mb > MAX_TARGET_MB )); then
        REASON="Target size must be between ${MIN_TARGET_MB} MB and ${MAX_TARGET_MB} MB."
        return 1
    fi
    if (( req_mb <= ESP_TOTAL_BYTES / 1048576 + 32 )); then
        REASON="Choose a target more than 32 MiB larger than the current EFI partition."
        return 1
    fi
    if (( req_mb < ESP_USED_BYTES / 1048576 + 128 )); then
        REASON="The target is too small for the current boot files."
        return 1
    fi

    req_bytes=$(( req_mb * 1024 * 1024 ))
    local sfdisk_json=""
    sfdisk_json="$(sfdisk -J "$ESP_DISK" 2>/dev/null || true)"
    local disk_base
    disk_base="$(basename "$ESP_DISK")"

    if [[ -n "$sfdisk_json" ]]; then
        DISK_LABEL="$(jq -r '.partitiontable.label // ""' <<<"$sfdisk_json")"
        SECTOR_SIZE="$(jq -r '.partitiontable.sectorsize // 512' <<<"$sfdisk_json")"
        FIRST_LBA="$(jq -r '.partitiontable.firstlba // 2048' <<<"$sfdisk_json")"
        LAST_LBA="$(jq -r '.partitiontable.lastlba // 0' <<<"$sfdisk_json")"
        parts_tsv="$(jq -r '.partitiontable.partitions // [] | sort_by(.start) | .[] | "\(.start)\t\(.size)\t\(.node)"' <<<"$sfdisk_json")"
    else
        # Unprivileged probe fallback: read partition boundaries directly from world-readable sysfs
        DISK_LABEL="$(lsblk -dno PTTYPE "$ESP_DISK" 2>/dev/null || true)"
        if [[ "${2:-}" == resize ]]; then
            REASON="The on-disk GPT could not be read."
            return 1
        fi
        local logical_sector disk_sectors
        logical_sector="$(cat "/sys/class/block/$disk_base/queue/logical_block_size" 2>/dev/null || echo 512)"
        disk_sectors="$(cat "/sys/class/block/$disk_base/size" 2>/dev/null || echo 0)"
        # sysfs units are always 512 bytes. Reserve the backup GPT header and entry array.
        SECTOR_SIZE=512
        FIRST_LBA=2048
        LAST_LBA=$(( disk_sectors - 1 - (logical_sector + 16384) / 512 ))

        local sys_parts=()
        for p_dir in "/sys/class/block/$disk_base/"*; do
            [[ -f "$p_dir/start" && -f "$p_dir/size" ]] || continue
            local st sz p_name
            st="$(< "$p_dir/start")"
            sz="$(< "$p_dir/size")"
            p_name="/dev/$(basename "$p_dir")"
            sys_parts+=("$st	$sz	$p_name")
        done
        if (( ${#sys_parts[@]} > 0 )); then
            parts_tsv="$(printf '%s\n' "${sys_parts[@]}" | sort -n -k1,1)"
        else
            parts_tsv=""
        fi
    fi

    if [[ "${DISK_LABEL,,}" != "gpt" ]]; then
        REASON="Disk $ESP_DISK uses ${DISK_LABEL:-unknown} partitioning; GPT is required."
        return 1
    fi
    if [[ -z "$parts_tsv" ]]; then
        REASON="Could not read partition table or partitions from $ESP_DISK."
        return 1
    fi

    local align_sec=$(( 1048576 / SECTOR_SIZE ))
    (( align_sec < 1 )) && align_sec=1

    # Check partition count limit (GPT standard table has 128 slots)
    local part_count
    part_count="$(wc -l <<<"$parts_tsv" | tr -d ' ')"

    local p_start p_size p_node
    local best_gap_start=0 best_gap_sec=0 cursor="$FIRST_LBA"

    while IFS=$'\t' read -r p_start p_size p_node; do
        [[ -n "$p_start" ]] || continue
        local aligned_cursor=$(( ((cursor + align_sec - 1) / align_sec) * align_sec ))
        if (( p_start > aligned_cursor )); then
            local gap_s=$(( p_start - aligned_cursor ))
            if (( gap_s > best_gap_sec )); then
                best_gap_sec="$gap_s"
                best_gap_start="$aligned_cursor"
            fi
        fi
        cursor=$(( p_start + p_size ))
        TAIL_START_SEC="$p_start"
        TAIL_SIZE_SEC="$p_size"
        TAIL_DEV="$p_node"
    done <<<"$parts_tsv"

    # Check trailing unallocated gap after the last partition
    local aligned_tail_cursor=$(( ((cursor + align_sec - 1) / align_sec) * align_sec ))
    if (( LAST_LBA + 1 > aligned_tail_cursor )); then
        local tail_gap_s=$(( LAST_LBA + 1 - aligned_tail_cursor ))
        if (( tail_gap_s > best_gap_sec )); then
            best_gap_sec="$tail_gap_s"
            best_gap_start="$aligned_tail_cursor"
        fi
    fi

    # Check unallocated GPT gaps for a replacement partition.
    local best_gap_bytes=$(( best_gap_sec * SECTOR_SIZE ))
    if (( part_count < 128 && best_gap_bytes >= req_bytes )); then
        STRATEGY="new_esp_unallocated"
        CAN_RESIZE="true"
        MAX_TARGET_BYTES="$best_gap_bytes"
        GAP_START_SEC="$best_gap_start"
        GAP_SIZE_SEC="$best_gap_sec"
        REASON="Unallocated space on $ESP_DISK can host a new dedicated EFI System Partition with zero filesystem shrinking."
        return 0
    fi
    if (( best_gap_bytes > MAX_TARGET_BYTES )); then
        MAX_TARGET_BYTES="$best_gap_bytes"
    fi

    # Check tail partition for online Btrfs shrink + tail ESP creation
    if [[ -n "$TAIL_DEV" && -b "$TAIL_DEV" && "$TAIL_DEV" != "$ESP_DEV" ]] && (( part_count < 128 )); then
        TAIL_PARTN="$(resolve_part_num "$TAIL_DEV" || echo 0)"
        TAIL_FSTYPE="$(lsblk -dno FSTYPE "$TAIL_DEV" 2>/dev/null | tr -d ' ' || true)"
        # What lsblk knows can lag behind a filesystem that was just written to the partition.
        [[ -n "$TAIL_FSTYPE" ]] || TAIL_FSTYPE="$(blkid -p -s TYPE -o value "$TAIL_DEV" 2>/dev/null || true)"
        TAIL_MNT="$(find_mount_for_dev "$TAIL_DEV" || true)"

        if [[ "$TAIL_FSTYPE" == "crypto_LUKS" ]]; then
            REASON="Partition $TAIL_DEV is LUKS-encrypted and no unallocated space exists on $ESP_DISK. Shrink the encrypted partition from a live USB to free disk space first."
            return 1
        fi

        if [[ "$TAIL_FSTYPE" != "btrfs" ]]; then
            REASON="Last partition $TAIL_DEV uses ${TAIL_FSTYPE:-unknown} (online shrink requires mounted Btrfs or unallocated disk space)."
            return 1
        fi

        if [[ -z "$TAIL_MNT" ]]; then
            REASON="Btrfs partition $TAIL_DEV is not currently mounted."
            return 1
        fi

        # Refuse multi-device Btrfs pools
        local btrfs_devs
        btrfs_devs="$(btrfs filesystem show "$TAIL_MNT" 2>/dev/null | awk '/Total devices/ {print $3; exit}' || echo 0)"
        if [[ "$btrfs_devs" != "1" && "${2:-}" != resize ]]; then
            # The read-only preview can use sysfs when btrfs-progs needs administrator access.
            local fs_uuid
            fs_uuid="$(lsblk -dno UUID "$TAIL_DEV" 2>/dev/null || true)"
            if [[ "$fs_uuid" =~ ^[[:xdigit:]-]+$ && -d "/sys/fs/btrfs/$fs_uuid/devices" ]]; then
                local devices=("/sys/fs/btrfs/$fs_uuid/devices/"*)
                if [[ -e "${devices[0]}" ]]; then btrfs_devs="${#devices[@]}"; fi
            fi
        fi
        if [[ "$btrfs_devs" != "1" ]]; then
            REASON="Btrfs volume at $TAIL_MNT spans multiple devices ($btrfs_devs); automatic single-disk shrink is disabled."
            return 1
        fi

        TAIL_FREE_BYTES="$(df -B1 --output=avail "$TAIL_MNT" 2>/dev/null | tail -n1 | tr -d ' ' || echo 0)"
        # Account for any trailing unallocated sectors already after TAIL_DEV
        local trailing_unalloc_bytes=$(( (LAST_LBA - (TAIL_START_SEC + TAIL_SIZE_SEC) + 1) * SECTOR_SIZE ))
        (( trailing_unalloc_bytes < 0 )) && trailing_unalloc_bytes=0

        local shrinkable_bytes=$(( TAIL_FREE_BYTES + trailing_unalloc_bytes - BTRFS_SAFETY_MARGIN_BYTES - SHRINK_CUSHION_BYTES ))
        if (( shrinkable_bytes > MAX_TARGET_BYTES )); then
            MAX_TARGET_BYTES="$shrinkable_bytes"
        fi

        if (( shrinkable_bytes >= req_bytes )); then
            STRATEGY="tail_btrfs_relocate"
            CAN_RESIZE="true"
            REASON="Will safely shrink Btrfs volume ($TAIL_MNT) at the end of $ESP_DISK and transition to a dedicated EFI System Partition."
            return 0
        else
            local need_gb=$(( (req_bytes + BTRFS_SAFETY_MARGIN_BYTES + SHRINK_CUSHION_BYTES) / (1024 * 1024 * 1024) + 1 ))
            REASON="Insufficient free space on $TAIL_MNT ($(( TAIL_FREE_BYTES / (1024 * 1024 * 1024) )) GiB available; at least ${need_gb} GiB free required)."
            return 1
        fi
    fi

    REASON="No supported online expansion path found on $ESP_DISK."
    return 1
}

cmd_probe() {
    local req_mb="${1:-2048}"
    if [[ ! "$req_mb" =~ ^[0-9]+$ ]]; then
        req_mb=2048
    fi
    analyze_layout "$req_mb" || true

    jq -nc \
        --arg mount "${ESP_MNT:-}" \
        --arg device "${ESP_DEV:-}" \
        --arg uuid "${ESP_UUID:-}" \
        --arg disk "${ESP_DISK:-}" \
        --argjson part_num "${ESP_PARTN:-0}" \
        --argjson total_bytes "${ESP_TOTAL_BYTES:-0}" \
        --argjson used_bytes "${ESP_USED_BYTES:-0}" \
        --argjson free_bytes "${ESP_FREE_BYTES:-0}" \
        --arg strategy "${STRATEGY:-unsupported}" \
        --argjson can_resize "${CAN_RESIZE:-false}" \
        --arg reason "${REASON:-}" \
        --argjson max_target_bytes "${MAX_TARGET_BYTES:-0}" \
        --arg tail_device "${TAIL_DEV:-}" \
        --arg tail_fstype "${TAIL_FSTYPE:-}" \
        --arg tail_mount "${TAIL_MNT:-}" \
        --argjson tail_free_bytes "${TAIL_FREE_BYTES:-0}" \
        '{
            mount: $mount,
            device: $device,
            uuid: $uuid,
            disk: $disk,
            part_num: $part_num,
            total_bytes: $total_bytes,
            used_bytes: $used_bytes,
            free_bytes: $free_bytes,
            strategy: $strategy,
            can_resize: $can_resize,
            reason: $reason,
            max_target_bytes: $max_target_bytes,
            tail_device: $tail_device,
            tail_fstype: $tail_fstype,
            tail_mount: $tail_mount,
            tail_free_bytes: $tail_free_bytes
        }'
}

# Settings asks for the same plan the writer uses, once per offered size.
cmd_plan() {
    local target plans='[]' why="" first=""
    for target in 1024 2048 4096 8192; do
        if analyze_layout "$target"; then
            plans="$(jq -c --argjson size "$target" --arg strategy "$STRATEGY" --arg reason "$REASON" \
                '. + [{target_mb:$size,strategy:$strategy,reason:$reason}]' <<<"$plans")"
        else
            [[ -n "$first" ]] || first="$REASON"
            # A size the partition already has says nothing about why it cannot grow.
            if [[ -z "$why" ]] && (( target > ESP_TOTAL_BYTES / 1048576 + 32 )); then
                why="$REASON"
            fi
        fi
    done
    [[ -n "$ESP_MNT" && "$ESP_TOTAL_BYTES" -gt 0 ]] || return 0
    jq -nc --arg mount "$ESP_MNT" --arg device "$ESP_DEV" --arg uuid "$ESP_UUID" \
        --argjson used "$ESP_USED_BYTES" --argjson free "$ESP_FREE_BYTES" --argjson part "$ESP_TOTAL_BYTES" \
        --argjson plans "$plans" --arg reason "${why:-$first}" \
        '{kind:"efi",fstype:"vfat",mount:$mount,device:$device,uuid:$uuid,used:$used,free:$free,
          total:($used+$free),part_bytes:$part,resize_plans:$plans,reason:(if $plans == [] then $reason else "" end)}'
}

refresh_kernel_parttable() {
    local disk="$1"
    if command -v partprobe >/dev/null 2>&1; then
        partprobe "$disk" 2>/dev/null || true
    fi
    if command -v partx >/dev/null 2>&1; then
        partx -u "$disk" 2>/dev/null || true
    fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle --timeout=10 2>/dev/null || true
    fi
}

# Whether the kernel holds a partition at the start and size just written, in SECTOR_SIZE sectors.
# A refresh can report success and still leave the old geometry in place.
kernel_part_is() {
    local dev="$1" want_start="$2" want_size="$3" name
    [[ -b "$dev" ]] || return 1
    name="$(basename "$(readlink -f "$dev")")"
    [[ -r "/sys/class/block/$name/start" && -r "/sys/class/block/$name/size" ]] || return 1
    # sysfs counts 512-byte sectors, whatever the disk's own sector size.
    (( $(< "/sys/class/block/$name/start") * 512 == want_start * SECTOR_SIZE
        && $(< "/sys/class/block/$name/size") * 512 == want_size * SECTOR_SIZE ))
}

# The same geometry in the partition table on the disk itself.
disk_part_is() {
    local dev="$1" want_start="$2" want_size="$3" line
    line="$(sfdisk -d "$ESP_DISK" 2>/dev/null | awk -v d="$dev" '$1 == d && $2 == ":"')"
    [[ "$line" =~ start=\ *([0-9]+) ]] && (( BASH_REMATCH[1] == want_start )) || return 1
    [[ "$line" =~ size=\ *([0-9]+) ]] && (( BASH_REMATCH[1] == want_size ))
}

# A rollback that could not finish says so, in place of the error that started it.
rollback_incomplete() {
    jq -nc --arg msg "$1" '{step: "error", percent: 0, error: true, message: $msg}' 2>/dev/null || true
}

# Refreshes for up to five seconds until the kernel holds that geometry.
await_kernel_part() {
    local tries
    for (( tries = 0; tries < 25; tries++ )); do
        kernel_part_is "$@" && return 0
        sleep 0.2
        refresh_kernel_parttable "$ESP_DISK"
    done
    return 1
}

# Windows' own folder stays where it is: its boot manager, started from a copy on another partition,
# asks for the BitLocker recovery key.
copy_esp_tree() {
    local src_dir="$1" dst_dir="$2"
    rsync -rltD --no-perms --no-owner --no-group --modify-window=2 \
        --exclude='/[Ee][Ff][Ii]/[Mm][Ii][Cc][Rr][Oo][Ss][Oo][Ff][Tt]/' "$src_dir/" "$dst_dir/"
    sync
}

verify_esp_contents() {
    local src_dir="$1" dst_dir="$2" differ rc=0
    differ="$(diff -rq "$src_dir" "$dst_dir" 2>&1)" || rc=$?
    # The folder copy_esp_tree leaves behind is the one difference allowed.
    if (( rc != 0 )); then
        [[ $rc -eq 1 && "${differ,,}" == "only in ${src_dir,,}/efi: microsoft" ]] || return 1
    fi
    if [[ -f "$dst_dir/limine.conf" ]] && command -v mainstream-boot-verify >/dev/null 2>&1; then
        local rc=0
        # Quick: a rebuild would wait on the boot lock held here, and would write the live partition, not this copy.
        MAINSTREAM_ESP="$dst_dir" MAINSTREAM_BOOT_LOCK="/run/lock/efi-resize-inner.lock" \
            mainstream-boot-verify --repair --quick >/dev/null 2>&1 || rc=$?
        # Exit codes 0 (valid) and 3 (repaired from backup) mean bootable
        if (( rc != 0 && rc != 3 )); then
            return 1
        fi
    fi
    return 0
}

# Atomically change only the EFI mount, retaining other fstab edits.
update_fstab_esp_source() {
    local mp="$1" source="$2" match="${3:-}" tmp
    [[ -f "$FSTAB_PATH" ]] || return 1
    tmp="$(mktemp "${FSTAB_PATH}.efi-resize.XXXXXX")" || return 1
    if EFI_FSTAB_SOURCE="$source" awk -v mp="$mp" -v match_src="$match" '
        BEGIN { src = ENVIRON["EFI_FSTAB_SOURCE"] }
        /^[[:space:]]*#/ || NF < 3 { print; next }
        $2 == mp && (match_src == "" || $1 == match_src) {
            updated = 1
            if (src == "") next
            $1 = src
        }
        { print }
        END {
            if (!updated && match_src == "") printf "%s\t%s\tvfat\tumask=0077\t0 2\n", src, mp
        }
    ' "$FSTAB_PATH" > "$tmp" && chmod --reference="$FSTAB_PATH" "$tmp" \
        && mv -f -- "$tmp" "$FSTAB_PATH" && sync -f -- "$(dirname -- "$FSTAB_PATH")"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

loader_on_esp() {
    local dir="$1"
    # limine-install refreshes and signs this file, and adds its own entry when none names it.
    if [[ -f "$dir/EFI/limine/limine_x64.efi" ]]; then
        printf '%s' '\EFI\limine\limine_x64.efi'
    elif [[ -f "$dir/EFI/limine/BOOTX64.EFI" ]]; then
        printf '%s' '\EFI\limine\BOOTX64.EFI'
    elif [[ -f "$dir/EFI/systemd/systemd-bootx64.efi" ]]; then
        printf '%s' '\EFI\systemd\systemd-bootx64.efi'
    elif [[ -f "$dir/EFI/BOOT/BOOTX64.EFI" ]]; then
        printf '%s' '\EFI\BOOT\BOOTX64.EFI'
    else
        return 1
    fi
}

# A retry reuses any entry already created for this partition and loader.
boot_entry_for() {
    local entries="$1" guid="$2" loader="$3"
    grep -iF "GPT,$guid," <<<"$entries" | grep -iF "$loader" \
        | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*.*/\1/p' | head -n 1
}

nvram_skipped() {
    [[ "$SKIP_NVRAM" == "1" ]] || [[ ! -d /sys/firmware/efi/efivars && "$FORCE_UEFI" == "1" ]]
}

# Sets BOOT_ENTRY to the firmware entry for this partition and loader, creating it when missing.
# The new entry stays out of the boot order until promote_boot_entry.
ensure_boot_entry() {
    local dev="$1" guid="$2" loader="$3" entries disk partn
    BOOT_ENTRY=""
    entries="$(efibootmgr -v)" || return 1
    BOOT_ENTRY="$(boot_entry_for "$entries" "$guid" "$loader" || true)"
    [[ -z "$BOOT_ENTRY" ]] || return 0
    disk="$(resolve_parent_disk "$dev")" && partn="$(resolve_part_num "$dev")" || return 1
    # A firmware write can succeed even if the command exits with an error. Read back the result.
    efibootmgr --create-only --disk "$disk" --part "$partn" --label "Mainstream" --loader "$loader" --unicode >/dev/null || true
    entries="$(efibootmgr -v)" || return 1
    BOOT_ENTRY="$(boot_entry_for "$entries" "$guid" "$loader" || true)"
    [[ -n "$BOOT_ENTRY" ]]
}

promote_boot_entry() {
    local num="$1" order first
    order="$(efibootmgr | sed -n 's/^BootOrder: //p')" || return 1
    first="${order%%,*}"
    [[ "${first^^}" != "${num^^}" ]] || return 0
    order="$(awk -F, -v num="$num" '{
        printf "%s", num
        for (i=1;i<=NF;i++) if ($i != "" && toupper($i) != toupper(num)) printf ",%s", $i
    }' <<<"$order")"
    efibootmgr -o "$order" >/dev/null || return 1
    first="$(efibootmgr | sed -n 's/^BootOrder: //p' | cut -d, -f1)" || return 1
    [[ "${first^^}" == "${num^^}" ]]
}

activate_esp() {
    nvram_skipped && return 0
    ensure_boot_entry "$@" && promote_boot_entry "$BOOT_ENTRY"
}

# Prints the record of what the resize built, from whichever record holds it, or null. It travels
# with the switch so that undoing the switch can also remove the partition.
saved_build() {
    jq -ce 'select(type == "object")' "$BUILD_STATE" 2>/dev/null \
        || jq -ce '.build | select(type == "object")' "$CUTOVER_STATE" 2>/dev/null \
        || jq -ce '.build | select(type == "object")' "$RETIRE_STATE" 2>/dev/null \
        || printf 'null\n'
}

write_cutover_state() {
    local mp="$1" old="$2" new="$3" uuid="$4" loader="$5" action="${6:-finish}" dir tmp build
    dir="$(dirname -- "$CUTOVER_STATE")"
    mkdir -p "$dir"
    build="$(saved_build)"
    tmp="$(mktemp "$dir/efi-resize.XXXXXX")"
    jq -nc --arg mount "$mp" --arg old "$old" --arg new "$new" --arg uuid "$uuid" --arg loader "$loader" --arg action "$action" \
        --argjson build "$build" \
        '{mount:$mount, old:$old, new:$new, uuid:$uuid, loader:$loader, action:$action, build:$build}' > "$tmp"
    # Flushed before it takes its name, so a power cut never leaves an empty record behind.
    sync -- "$tmp"
    mv -f -- "$tmp" "$CUTOVER_STATE"
    # Nothing can delete the verified replacement once the record might be durable.
    ROLLBACK_DISK=""
    ROLLBACK_BTRFS_MNT=""
    ROLLBACK_BOOT_ENTRY=""
    sync -f -- "$dir"
    # From here the build is a switch to finish, never something to undo.
    rm -f -- "$BUILD_STATE"
}

# Fills the caller's fields from the record.
read_cutover_state() {
    mp="$(jq -er '.mount' "$CUTOVER_STATE" 2>/dev/null)" && old="$(jq -er '.old' "$CUTOVER_STATE")" \
        && guid="$(jq -er '.new' "$CUTOVER_STATE")" && uuid="$(jq -er '.uuid' "$CUTOVER_STATE")" \
        && loader="$(jq -er '.loader' "$CUTOVER_STATE")" && action="$(jq -er '.action // "finish"' "$CUTOVER_STATE")" \
        || die_json "The EFI resize record cannot be read. Boot updates are paused."
    [[ "$mp" == /boot || "$mp" == /boot/efi || "$mp" == /efi || ( -n "$MOUNT_OVERRIDE" && "$mp" == "$MOUNT_OVERRIDE" ) ]] \
        || die_json "The EFI resize record has an invalid mount path."
    [[ "$guid" =~ ^[[:xdigit:]-]+$ && "$old" =~ ^[[:xdigit:]-]+$ && "$uuid" =~ ^[[:xdigit:]-]+$ ]] \
        || die_json "The EFI resize record has an invalid partition identifier."
    [[ "$guid" != "$old" && ( "$action" == finish || "$action" == cancel ) ]] \
        || die_json "The EFI resize record has an invalid operation."
}

# Records that the old partition, with partition id $2, waits to be retired until a start has come
# from the new one, with partition id $3. The new one's volume id $4 and loader $5 are what undoing
# the switch needs; $6 counts the starts that came from another partition. The record is stamped
# with the running start, which is the one that finished the switch or the one last counted.
write_retire_state() {
    local dir tmp boot build
    dir="$(dirname -- "$RETIRE_STATE")"
    boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
    build="$(saved_build)"
    tmp="$(mktemp "$dir/efi-resize.XXXXXX")" || return 1
    if jq -nc --arg mount "$1" --arg old "$2" --arg new "$3" --arg uuid "$4" --arg loader "$5" \
            --arg boot "$boot" --argjson misses "${6:-0}" --argjson build "$build" \
            '{mount:$mount, old:$old, new:$new, uuid:$uuid, loader:$loader, boot_id:$boot, misses:$misses, build:$build}' > "$tmp" \
        && sync -- "$tmp" && mv -f -- "$tmp" "$RETIRE_STATE" && sync -f -- "$dir"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

# Fills the caller's fields from the record of a waiting retirement. A record without the fields
# an undo needs leaves them empty.
read_retire_state() {
    mp="$(jq -er '.mount' "$RETIRE_STATE" 2>/dev/null)" && old="$(jq -er '.old' "$RETIRE_STATE" 2>/dev/null)" \
        && guid="$(jq -er '.new' "$RETIRE_STATE" 2>/dev/null)" || return 1
    [[ "$mp" == /boot || "$mp" == /boot/efi || "$mp" == /efi || ( -n "$MOUNT_OVERRIDE" && "$mp" == "$MOUNT_OVERRIDE" ) ]] \
        || return 1
    [[ "$guid" =~ ^[[:xdigit:]-]+$ && "$old" =~ ^[[:xdigit:]-]+$ && "${guid,,}" != "${old,,}" ]] || return 1
    uuid="$(jq -r '.uuid // ""' "$RETIRE_STATE" 2>/dev/null || true)"
    loader="$(jq -r '.loader // ""' "$RETIRE_STATE" 2>/dev/null || true)"
    boot_id="$(jq -r '.boot_id // ""' "$RETIRE_STATE" 2>/dev/null || true)"
    misses="$(jq -r '.misses // 0' "$RETIRE_STATE" 2>/dev/null || true)"
    [[ "$uuid" =~ ^[[:xdigit:]-]+$ && -n "$loader" ]] || uuid="" loader=""
    [[ "$misses" =~ ^[0-9]+$ ]] || misses=0
}

# Prints the partition id named by the firmware entry this start came from, or nothing when the
# firmware does not say.
started_from_part() {
    local entries cur
    nvram_skipped && return 0
    entries="$(efibootmgr -v 2>/dev/null || true)"
    cur="$(sed -n 's/^BootCurrent: *\([0-9A-Fa-f]\{4\}\).*/\1/p' <<<"$entries" | head -n 1)"
    [[ -n "$cur" ]] || return 0
    grep -i "^Boot${cur}[* ]" <<<"$entries" | sed -n 's/.*HD([0-9]*,GPT,\([0-9A-Fa-f-]\{36\}\),.*/\1/p' | head -n 1
}

# The device mounted at $1, once any pending automount has fired.
esp_mount_source() {
    local src
    stat -- "$1/." >/dev/null 2>&1 || true
    src="$(findmnt -nv -o SOURCE -M "$1" 2>/dev/null | tail -n 1 || true)"
    [[ -z "$src" ]] || readlink -f -- "$src"
}

# Moves the mount at $1 from $3 (empty when nothing is mounted) to $2. A device that will not
# mount gives the mount back to the one it came from. Returns 2 when the mount is busy.
switch_esp_mount() {
    local mp="$1" dev="$2" current="$3" unit
    if [[ -n "$current" ]]; then
        unit="$(systemd-escape -p --suffix=automount "$mp" 2>/dev/null || true)"
        if [[ -n "$unit" ]] && systemctl is-active --quiet "$unit" 2>/dev/null; then
            AUTOMOUNT_UNIT="$unit"
            systemctl stop "$unit" || return 2
        fi
        # Stopping an automount can take the filesystem mounted through it along.
        if mountpoint -q "$mp" 2>/dev/null; then
            umount "$mp" || return 2
        fi
    fi
    mount -t vfat -o umask=0077 "$dev" "$mp" && return 0
    [[ -z "$current" ]] || mount -t vfat -o umask=0077 "$current" "$mp" 2>/dev/null || true
    return 1
}

# Mounts $2 at $1 unless it is mounted there already.
remount_esp() {
    if [[ "$(esp_mount_source "$1")" != "$2" ]]; then
        mount -t vfat -o umask=0077 "$2" "$1" 2>/dev/null || mount "$1" 2>/dev/null \
            || log_note "The EFI partition $2 could not be mounted at $1 again. Mount it before installing updates."
    fi
}

# Gives the new partition $3 the volume id of the old one $2, so an fstab from before the resize, in
# a snapshot for one, mounts the partition in use. fstab is first made to name the partition id,
# which nothing here changes, so $3 is found at $1 however far this gets.
hand_over_esp_id() {
    local mp="$1" old_dev="$2" dev="$3" guid="$4" old_id new_id unit now
    if ! command -v fatlabel >/dev/null 2>&1; then
        log_note "fatlabel is not installed, so the EFI partition ${dev} keeps its own volume id."
        return 0
    fi
    old_id="$(blkid -p -s UUID -o value "$old_dev" 2>/dev/null || true)"
    new_id="$(blkid -p -s UUID -o value "$dev" 2>/dev/null || true)"
    if [[ ! "$old_id" =~ ^[[:xdigit:]]{4}-[[:xdigit:]]{4}$ || ! "$new_id" =~ ^[[:xdigit:]]{4}-[[:xdigit:]]{4}$ \
        || "${old_id^^}" == "${new_id^^}" ]]; then
        log_note "The EFI volume ids could not be read, so the EFI partition ${dev} keeps its own."
        return 0
    fi
    if ! update_fstab_esp_source "$mp" "PARTUUID=$guid"; then
        log_note "fstab could not be rewritten, so the EFI partition ${dev} keeps its own volume id."
        return 0
    fi
    # Until systemd has read the new line, its mount unit is tied to the volume id about to change.
    if [[ -d /run/systemd/system ]] && ! systemctl daemon-reload 2>/dev/null; then
        log_note "systemd could not reload fstab, so the EFI partition ${dev} keeps its own volume id."
        return 0
    fi
    unit="$(systemd-escape -p --suffix=automount "$mp" 2>/dev/null || true)"
    if [[ -n "$unit" ]] && systemctl is-active --quiet "$unit" 2>/dev/null; then
        AUTOMOUNT_UNIT="$unit"
        if ! systemctl stop "$unit" 2>/dev/null; then
            log_note "The automount for ${mp} could not be stopped, so the EFI partition ${dev} keeps its own volume id."
            return 0
        fi
    fi
    # Nothing has changed an id yet, so a busy mountpoint stops here with both partitions as they were.
    if mountpoint -q "$mp" 2>/dev/null && ! umount "$mp" 2>/dev/null; then
        log_note "${mp} is busy, so the EFI partition ${dev} keeps its own volume id."
        return 0
    fi
    if mountpoint -q "$mp" 2>/dev/null || findmnt -n -S "$dev" >/dev/null 2>&1 \
        || findmnt -n -S "$old_dev" >/dev/null 2>&1; then
        remount_esp "$mp" "$dev"
        log_note "An EFI partition is still mounted, so the EFI partition ${dev} keeps its own volume id."
        return 0
    fi

    fatlabel -i -r "$old_dev" >/dev/null 2>&1 || true
    sync -- "$old_dev" 2>/dev/null || true
    now="$(blkid -p -s UUID -o value "$old_dev" 2>/dev/null || true)"
    if [[ -z "$now" || "${now^^}" == "${old_id^^}" ]]; then
        remount_esp "$mp" "$dev"
        log_note "The old EFI partition ${old_dev} did not take a new volume id, so ${dev} keeps its own."
        return 0
    fi
    fatlabel -i "$dev" "${old_id//-/}" >/dev/null 2>&1 || true
    sync -- "$dev" 2>/dev/null || true
    now="$(blkid -p -s UUID -o value "$dev" 2>/dev/null || true)"
    if [[ "${now^^}" == "${new_id^^}" ]]; then
        # The new partition did not take the id, so the old one gets it back and nothing is lost.
        fatlabel -i "$old_dev" "${old_id//-/}" >/dev/null 2>&1 || true
        sync -- "$old_dev" 2>/dev/null || true
    fi
    udevadm settle --timeout=10 2>/dev/null || true
    remount_esp "$mp" "$dev"
    if [[ "${now^^}" == "${old_id^^}" && "$(esp_mount_source "$mp")" == "$dev" ]]; then
        log_note "The EFI partition ${dev} took over the volume id ${old_id} from ${old_dev}."
    else
        log_note "The EFI partition ${dev} has the volume id ${now:-unknown} where ${old_id} was wanted; fstab names it by partition id."
    fi
}

# Runs once a start has come from the new partition. The old one, with partition id $2, must not be
# able to start or be mounted in place of the one in use, so Mainstream's own loader, menu, boot
# images and firmware entry on it go. Best effort: whatever cannot be done is left as it was and
# logged.
retire_old_esp() {
    local mp="$1" old="$2" dev="$3" guid="$4"
    local old_dev o f name mid foreign=0 left="" entries num="" tries
    # A kernel whose name starts with the prefix keeps its name alone (mainstream.efi).
    local -a ours=(-iname 'mainstream_*.efi' -o -iname 'mainstream.efi' -o -iname 'mainstream-*.efi')
    emit_progress "retire" 96 "Retiring the old EFI partition..."
    old_dev="$(blkid -t "PARTUUID=$old" -o device 2>/dev/null || true)"
    if [[ ! -b "$old_dev" || "$old_dev" == "$dev" ]] || ! is_esp_partition "$old_dev" \
        || findmnt -n -S "$old_dev" >/dev/null 2>&1; then
        log_note "The old EFI partition could not be identified or is mounted, so it was left as it is."
        return 0
    fi
    mid="$(tr -d '[:space:]' < /etc/machine-id 2>/dev/null || true)"
    mid="${mid,,}"
    if [[ "$mid" =~ ^[0-9a-f]{32}$ ]]; then
        ours+=(-o -iname "${mid}_*.efi")
    else
        mid=""
    fi
    mkdir -p /run/mainstream 2>/dev/null || true
    o="$(mktemp -d /run/mainstream/old-esp.XXXXXX 2>/dev/null || true)"
    if [[ -z "$o" ]] || ! mount -t vfat -o umask=0077 "$old_dev" "$o" 2>/dev/null; then
        [[ -z "$o" ]] || rmdir "$o" 2>/dev/null || true
        log_note "The old EFI partition ${old_dev} could not be mounted, so it was left as it is."
        return 0
    fi
    TMP_ESP_MNT="$o"

    # Another system's boot images beside Mainstream's mean the loader and its menu are shared.
    for f in "$o"/*; do
        name="${f##*/}"
        name="${name,,}"
        if [[ -d "$f" && "$name" =~ ^[0-9a-f]{32}$ && "$name" != "$mid" ]]; then
            foreign=1
        fi
    done
    for f in "$o"/EFI/Linux/*; do
        [[ -e "$f" ]] || continue
        name="${f##*/}"
        name="${name,,}"
        case "$name" in
            mainstream_*.efi|mainstream.efi|mainstream-*.efi) ;;
            *) [[ -n "$mid" && "$name" == "$mid"_*.efi ]] || foreign=1 ;;
        esac
    done
    if (( foreign )); then
        log_note "Another system keeps boot images on the old EFI partition ${old_dev}, so Mainstream's loader there was left in place."
    else
        if ! nvram_skipped; then
            for (( tries = 0; tries < 4; tries++ )); do
                entries="$(efibootmgr -v 2>/dev/null || true)"
                num="$(boot_entry_for "$entries" "$old" '\EFI\limine\' || true)"
                [[ -n "$num" ]] || break
                efibootmgr -q -b "$num" -B >/dev/null 2>&1 || true
            done
            [[ -z "$num" ]] || log_note "The firmware kept a boot entry for the old EFI partition ${old_dev}."
        fi
        # The fallback loader goes only when it is a copy of Mainstream's loader.
        for f in "$o"/EFI/limine/* /usr/share/limine/BOOTX64.EFI; do
            if [[ -f "$f" && -f "$o/EFI/BOOT/BOOTX64.EFI" ]] && cmp -s -- "$f" "$o/EFI/BOOT/BOOTX64.EFI"; then
                rm -f -- "$o/EFI/BOOT/BOOTX64.EFI"
            fi
        done
        # The loaders go before the menu, so an interruption never leaves a loader that has no menu.
        rm -rf -- "$o/EFI/limine"
        rm -f -- "$o/limine.conf" "$o/limine.conf.old"
        find "$o/EFI/Linux" -maxdepth 1 -type f \( "${ours[@]}" \) -delete 2>/dev/null
        [[ -z "$mid" ]] || rm -rf -- "$o/$mid"
        # systemd writes these two at every start; left behind they would count as someone else's files.
        rm -f -- "$o/loader/random-seed" "$o/loader/boot-secret-mixin"
        rmdir "$o/loader" "$o/EFI/Linux" "$o/EFI/BOOT" "$o/EFI" 2>/dev/null
        left="$(find "$o" -mindepth 1 -print -quit 2>/dev/null)" || left="unknown"
        sync -f -- "$o" 2>/dev/null
    fi
    if ! umount "$o" 2>/dev/null; then
        log_note "The old EFI partition ${old_dev} could not be unmounted from ${o}."
        return 0
    fi
    rmdir "$o" 2>/dev/null
    TMP_ESP_MNT=""
    if (( foreign )); then
        return 0
    fi
    if [[ -n "$left" ]]; then
        log_note "Files that are not Mainstream's remain on the old EFI partition ${old_dev}, so it keeps its volume id."
        return 0
    fi
    # The record goes before the ids change hands: a second handover would swap them back.
    rm -f -- "$RETIRE_STATE"
    sync -f -- "$(dirname -- "$RETIRE_STATE")" 2>/dev/null || true
    hand_over_esp_id "$mp" "$old_dev" "$dev" "$guid"
}

# While the old partition waits to be retired the firmware may still start it, and boot updates
# only reach the one in use. This copies Mainstream's loaders, boot images and menu over to the old
# one after such an update. Snapshot copies of boot images stay behind, as the old partition is the
# small one. Runs from a boot hook, under the boot lock its caller holds, and never fails that caller.
mirror_old_esp() {
    local mp old guid uuid loader boot_id misses dev old_dev o mid problem=""
    local -a ours=(--include='/EFI/' --include='/EFI/limine/' --include='/EFI/limine/**'
        --include='/EFI/Linux/' --include='/EFI/Linux/mainstream_*.efi'
        --include='/EFI/Linux/mainstream.efi' --include='/EFI/Linux/mainstream-*.efi')
    read_retire_state || return 0
    exec 8>>"$RESIZE_LOCK" && flock -s -n 8 || return 0
    dev="$(blkid -t "PARTUUID=$guid" -o device 2>/dev/null || true)"
    [[ -b "$dev" && "$(esp_mount_source "$mp")" == "$dev" && -f "$mp/limine.conf" ]] || return 0
    old_dev="$(blkid -t "PARTUUID=$old" -o device 2>/dev/null || true)"
    mkdir -p /run/mainstream 2>/dev/null || true
    if [[ ! -b "$old_dev" || "$old_dev" == "$dev" ]] || ! is_esp_partition "$old_dev" \
        || findmnt -n -S "$old_dev" >/dev/null 2>&1; then
        problem="could not be identified or is mounted"
    elif ! o="$(mktemp -d /run/mainstream/old-esp.XXXXXX 2>/dev/null)" \
        || ! mount -t vfat -o umask=0077 "$old_dev" "$o" 2>/dev/null; then
        [[ -z "${o:-}" ]] || rmdir "$o" 2>/dev/null || true
        problem="could not be mounted"
    fi
    if [[ -n "$problem" ]]; then
        mirror_note "The old EFI partition ${problem}, so its boot files were not updated. Until the next restart, start this computer only from the new EFI partition."
        return 0
    fi
    TMP_ESP_MNT="$o"
    # Nothing of Mainstream's there means nothing that could be started out of step.
    if [[ -f "$o/limine.conf" && -d "$o/EFI/limine" ]]; then
        mid="$(tr -d '[:space:]' < /etc/machine-id 2>/dev/null || true)"
        [[ ! "${mid,,}" =~ ^[0-9a-f]{32}$ ]] || ours+=(--include="/EFI/Linux/${mid,,}_*.efi")
        # The default loader path can hold another system's loader.
        if grep -aq 'Limine [0-9]' -- "$o/EFI/BOOT/BOOTX64.EFI" 2>/dev/null; then
            ours+=(--include='/EFI/BOOT/' --include='/EFI/BOOT/BOOTX64.EFI')
        fi
        # The menu goes last and only after its images, so the old partition is never left with
        # a menu that names images it does not hold.
        if rsync -rltD --no-perms --no-owner --no-group --modify-window=2 --delete \
                "${ours[@]}" --exclude='*' "$mp/" "$o/" >/dev/null 2>&1 \
            && { cmp -s -- "$mp/limine.conf" "$o/limine.conf" \
                || { cp -f -- "$mp/limine.conf" "$o/limine.conf.new" \
                    && mv -f -- "$o/limine.conf.new" "$o/limine.conf"; }; } \
            && sync -f -- "$o"; then
            :
        else
            rm -f -- "$o/limine.conf.new"
            mirror_note "The boot files on the old EFI partition ${old_dev} could not be updated; it may be full. Until the next restart, start this computer only from the new EFI partition."
        fi
    fi
    umount "$o" 2>/dev/null && rmdir "$o" 2>/dev/null && TMP_ESP_MNT="" || true
}

mirror_note() {
    log_note "$1"
    printf '[efi-resize] %s\n' "$1"
}

# Retires the old partition when this start came from the new one. Any other start leaves both
# partitions in place, so a firmware that ignores the new entry still finds the old loader. A start
# the firmware says came from another partition puts the new entry first again, and the second such
# start undoes the switch: boot updates only reach the new partition, so the old one must not stay
# the one that is started.
retire_after_restart() {
    local mp old guid uuid loader boot_id misses dev from now again
    if ! read_retire_state; then
        log_note "The record of the old EFI partition cannot be read, so that partition was left as it is."
        rm -f -- "$RETIRE_STATE"
        return 0
    fi
    dev="$(blkid -t "PARTUUID=$guid" -o device 2>/dev/null || true)"
    from="$(started_from_part || true)"
    if [[ ! -b "$dev" || "${from,,}" != "${guid,,}" ]]; then
        now="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
        # Counted once per start, and never in the start that finished the switch, which still came
        # from the old entry. Nothing is counted when the firmware does not say where it started.
        if [[ -z "$from" || "${from,,}" == "${guid,,}" || -z "$uuid" || -z "$now" || -z "$boot_id" \
            || "$now" == "$boot_id" ]]; then
            log_note "The old EFI partition was kept, because this start did not come from the new one."
            return 0
        fi
        if (( misses >= 1 )); then
            cancel_cutover
            log_note "The firmware would not start from the new EFI partition, so the resize was undone and the old EFI partition is in use again."
            return 0
        fi
        write_retire_state "$mp" "$old" "$guid" "$uuid" "$loader" $(( misses + 1 )) \
            || log_note "The start from another EFI partition could not be recorded."
        again="is first in the boot order again"
        activate_esp "$dev" "$guid" "$loader" || again="could not be put first in the boot order again"
        log_note "The old EFI partition was kept, because this start did not come from the new one. The new one ${again}; if the next start does not come from it either, the resize is undone."
        return 0
    fi
    if [[ "$(esp_mount_source "$mp")" != "$dev" ]]; then
        log_note "The old EFI partition was kept, because the new one is not mounted at ${mp}."
        return 0
    fi
    ESP_MNT="$mp"
    ESP_DEV="$dev"
    retire_old_esp "$mp" "$old" "$dev" "$guid" || true
    rm -f -- "$RETIRE_STATE"
    sync -f -- "$(dirname -- "$RETIRE_STATE")" 2>/dev/null || true
}

finish_cutover() {
    local mp old guid uuid loader action dev current rc
    read_cutover_state
    if [[ "$action" == cancel ]]; then
        cancel_cutover
        return
    fi
    dev="$(blkid -t "PARTUUID=$guid" -o device || true)"
    [[ -b "$dev" && "$(blkid -s UUID -o value "$dev")" == "$uuid" ]] && is_esp_partition "$dev" \
        || die_json "The replacement EFI partition could not be verified. Boot updates are paused."

    current="$(esp_mount_source "$mp")"
    if [[ "$current" != "$dev" ]]; then
        [[ -z "$current" || "$(blkid -s PARTUUID -o value "$current")" == "$old" ]] \
            || die_json "Another device is mounted at $mp. Boot updates are paused."
        rc=0
        switch_esp_mount "$mp" "$dev" "$current" || rc=$?
        (( rc != 2 )) || die_json "The old EFI partition is still busy. Close files on it and retry EFI recovery."
        (( rc == 0 )) || die_json "The replacement EFI partition could not be mounted. Boot updates are paused."
    fi
    local loader_path
    loader_path="${loader//\\//}"
    [[ -f "$mp/$loader_path" ]] || die_json "The replacement EFI loader is missing. Boot updates are paused."
    activate_esp "$dev" "$guid" "$loader" || die_json "The new firmware boot entry could not be activated. Boot updates are paused."
    # By partition id, which stays what it is when the volume ids change hands later.
    update_fstab_esp_source "$mp" "PARTUUID=$guid" || die_json "Could not save the replacement EFI mount in fstab. Boot updates are paused."
    if [[ "$(findmnt -en -o MAJ:MIN -M "$mp" | tail -n 1)" != "$(lsblk -dno MAJ:MIN "$dev")" ]]; then
        die_json "The mounted EFI partition does not match the replacement. Boot updates are paused."
    fi
    if [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload
    fi
    # The old partition keeps its loader and firmware entry until a start has come from the new one.
    write_retire_state "$mp" "$old" "$guid" "$uuid" "$loader" \
        || log_note "The old EFI partition could not be recorded for retirement, so it stays as it is."
    rm -f -- "$BUILD_STATE" "$CUTOVER_STATE"
    sync -f -- "$(dirname -- "$CUTOVER_STATE")"
    ESP_MNT="$mp"
    ESP_DEV="$dev"
    # A Windows entry in the menu still names the partition Limine starts from, which changed here.
    if command -v mainstream-limine-windows >/dev/null 2>&1 && [[ -f "$mp/limine.conf" ]]; then
        mainstream-limine-windows >/dev/null 2>&1 || true
    fi
    if [[ "${1:-}" == report_recovery ]]; then
        emit_progress "done" 100 "The interrupted EFI resize was completed."
    fi
}

# Backs out of a prepared switch that cannot finish, or of a finished one whose old partition still
# waits to be retired. The original partition takes the mount, fstab and firmware order back. Remove
# the replacement's loader files before allowing boot updates.
cancel_cutover() {
    local mp old guid uuid loader action old_dev old_uuid new_dev current rc entries num original_source named
    local boot_id misses build tmp disk ours=0
    if [[ -e "$CUTOVER_STATE" ]]; then
        read_cutover_state
    else
        read_retire_state && [[ -n "$uuid" ]] \
            || die_json "The record of the finished EFI resize cannot be read, so the resize cannot be undone."
        action=finish
    fi
    old_dev="$(blkid -t "PARTUUID=$old" -o device || true)"
    old_uuid=""
    [[ ! -b "$old_dev" ]] || old_uuid="$(blkid -s UUID -o value "$old_dev" || true)"
    [[ -n "$old_uuid" ]] && is_esp_partition "$old_dev" \
        || die_json "The original EFI partition could not be verified, so the resize cannot be canceled."
    new_dev="$(blkid -t "PARTUUID=$guid" -o device || true)"

    current="$(esp_mount_source "$mp")"
    if [[ "$current" != "$old_dev" ]]; then
        [[ -z "$current" || "$current" == "$new_dev" ]] \
            || die_json "Another device is mounted at $mp. Boot updates are paused."
        rc=0
        switch_esp_mount "$mp" "$old_dev" "$current" || rc=$?
        (( rc != 2 )) || die_json "The EFI partition is busy. Close files on it and retry."
        (( rc == 0 )) || die_json "The original EFI partition could not be mounted, so the resize was not canceled."
    fi
    if [[ ! -f "$mp/${loader//\\//}" ]]; then
        [[ -z "$current" || "$current" == "$old_dev" ]] || switch_esp_mount "$mp" "$current" "$old_dev" || true
        die_json "The original EFI loader is missing, so the resize was not canceled."
    fi
    if [[ "$action" != cancel ]]; then
        write_cutover_state "$mp" "$old" "$guid" "$uuid" "$loader" cancel
    fi
    for named in "PARTUUID=$guid" "UUID=$uuid"; do
        awk -v mp="$mp" -v src="$named" '!/^[[:space:]]*#/ && $2 == mp && $1 == src { found = 1 } END { exit !found }' "$FSTAB_PATH" \
            || continue
        original_source="UUID=$old_uuid"
        if [[ -f "${FSTAB_PATH}.bak-efi-resize" ]]; then
            original_source="$(awk -v mp="$mp" '!/^[[:space:]]*#/ && NF >= 3 && $2 == mp { print $1; exit }' "${FSTAB_PATH}.bak-efi-resize")"
        fi
        update_fstab_esp_source "$mp" "$original_source" "$named" \
            || die_json "Could not put the original EFI mount back in fstab. Boot updates are paused."
    done
    if ! nvram_skipped; then
        entries="$(efibootmgr -v)" || die_json "The firmware boot entries could not be read. Boot updates are paused."
        num="$(boot_entry_for "$entries" "$guid" "$loader" || true)"
        if [[ -n "$num" ]]; then
            efibootmgr -q -b "$num" -B >/dev/null 2>&1 || true
            entries="$(efibootmgr -v)" || die_json "The firmware boot entries could not be read. Boot updates are paused."
            num="$(boot_entry_for "$entries" "$guid" "$loader" || true)"
            [[ -z "$num" ]] || die_json "The firmware entry for the replacement EFI partition could not be removed. Boot updates are paused."
        fi
    fi
    if [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload
    fi
    # Firmware can scan the replacement even after its NVRAM entry is gone.
    if [[ -b "$new_dev" && "$(blkid -s UUID -o value "$new_dev" 2>/dev/null || true)" == "$uuid" ]]; then
        is_esp_partition "$new_dev" || die_json "The replacement is no longer an EFI partition. Boot updates are paused."
        if findmnt -n -S "$new_dev" >/dev/null 2>&1; then
            die_json "The replacement EFI partition is still mounted. Unmount it and retry cancellation. Boot updates are paused."
        fi
        mkdir -p /run/mainstream
        TMP_ESP_MNT="$(mktemp -d /run/mainstream/cancel-esp.XXXXXX)"
        mount -t vfat -o umask=0077 "$new_dev" "$TMP_ESP_MNT" \
            || die_json "Could not mount the replacement EFI partition. Retry cancellation before updating."
        rm -rf -- "$TMP_ESP_MNT/EFI" && sync -f -- "$TMP_ESP_MNT" \
            || die_json "Could not remove the replacement EFI loaders. Retry cancellation before updating."
        umount "$TMP_ESP_MNT" || die_json "Could not unmount the replacement EFI partition. Retry cancellation before updating."
        rmdir "$TMP_ESP_MNT"
        TMP_ESP_MNT=""
        ours=1
    fi
    # A partition verified as the replacement goes the way one left by an interrupted build does.
    # Its build record is back in place before the others go, so an interruption still removes it.
    build=null
    (( ! ours )) || build="$(saved_build)"
    if [[ "$build" != null ]]; then
        tmp="$(mktemp "$(dirname -- "$BUILD_STATE")/efi-resize.XXXXXX")"
        printf '%s\n' "$build" > "$tmp"
        sync -- "$tmp"
        mv -f -- "$tmp" "$BUILD_STATE"
    else
        rm -f -- "$BUILD_STATE"
    fi
    # The original partition is the one in use again, so nothing waits to retire it.
    rm -f -- "$RETIRE_STATE" "$CUTOVER_STATE"
    sync -f -- "$(dirname -- "$CUTOVER_STATE")"
    if [[ "$build" != null ]]; then
        disk="$(resolve_parent_disk "$new_dev" || true)"
        # In a subshell, so a partition that cannot be removed safely does not fail the cancel.
        set +e
        ( set -e; undo_interrupted_build ) >/dev/null
        rc=$?
        set -e
        if (( rc == 0 )); then
            emit_progress "done" 100 "The EFI resize was canceled and the unused replacement partition was removed."
            return 0
        fi
        # With the partition gone from the table its space is still to be given back, which the
        # record makes the next start retry.
        if ! sfdisk -d "$disk" 2>/dev/null | dump_parts | awk -v id="${guid^^}" '$5 == id { hit = 1 } END { exit !hit }'; then
            die_json "The EFI resize was canceled, but the space of the replacement partition was not given back. Restart to retry."
        fi
        rm -f -- "$BUILD_STATE"
        sync -f -- "$(dirname -- "$BUILD_STATE")"
        log_note "The unused EFI partition ${new_dev} could not be removed, so it was left in place."
    fi
    emit_progress "done" 100 "The EFI resize was canceled. The unused replacement partition was left in place."
}

find_next_free_partn() {
    local disk="$1" sfdisk_json used_nums n
    sfdisk_json="$(sfdisk -J "$disk")"
    used_nums="$(jq -r '.partitiontable.partitions // [] | .[].node' <<<"$sfdisk_json" | while read -r nd; do
        resolve_part_num "$nd" || true
    done)"
    for (( n = 1; n <= 128; n++ )); do
        if ! grep -qx "$n" <<<"$used_nums"; then
            printf '%s\n' "$n"
            return 0
        fi
    done
    return 1
}

# Prints "<id>:" for device $1 in the Btrfs mounted at $2, the prefix a resize takes to address it.
# Prints nothing when the id cannot be found, which leaves btrfs on its default, device 1.
btrfs_devid_prefix() {
    local want id path
    want="$(readlink -f -- "$1" 2>/dev/null || true)"
    [[ -n "$want" ]] || return 0
    while read -r id path; do
        [[ "$id" =~ ^[0-9]+$ && -n "$path" ]] || continue
        if [[ "$(readlink -f -- "$path" 2>/dev/null || true)" == "$want" ]]; then
            printf '%s:' "$id"
            return 0
        fi
    done < <(btrfs filesystem show "$2" 2>/dev/null \
        | awk '$1 == "devid" { for (i = 3; i < NF; i++) if ($i == "path") { print $2, $(i + 1); break } }')
    return 0
}

# Variables tracked for emergency rollback
TMP_ESP_MNT=""
SFDISK_BACKUP=""
ROLLBACK_DISK=""
ROLLBACK_BTRFS_MNT=""
ROLLBACK_BOOT_ENTRY=""
AUTOMOUNT_UNIT=""
TAIL_DEVID=""
BUILD_STATE_WRITTEN=""

cleanup_and_rollback() {
    local exit_code=$? undone=1
    if [[ -n "$TMP_ESP_MNT" ]]; then
        umount "$TMP_ESP_MNT" 2>/dev/null || true
        rmdir "$TMP_ESP_MNT" 2>/dev/null || true
    fi
    # After the cutover is prepared, keep both ESPs and retry instead of undoing part of the switch.
    if (( exit_code != 0 )) && [[ ! -e "$CUTOVER_STATE" ]]; then
        if [[ -n "$ROLLBACK_BOOT_ENTRY" ]]; then
            efibootmgr -q -b "$ROLLBACK_BOOT_ENTRY" -B >/dev/null 2>&1 || true
        fi
        if [[ -n "$ROLLBACK_DISK" && -n "$SFDISK_BACKUP" && -f "$SFDISK_BACKUP" ]]; then
            if ! sfdisk --force --no-reread "$ROLLBACK_DISK" < "$SFDISK_BACKUP" >/dev/null 2>&1; then
                rollback_incomplete "The partition table could not be put back; its backup is ${SFDISK_BACKUP}."
                undone=0
            fi
            refresh_kernel_parttable "$ROLLBACK_DISK"
        elif [[ -n "$ROLLBACK_DISK" ]]; then
            undone=0
        fi
        if [[ -n "$ROLLBACK_BTRFS_MNT" ]]; then
            # Grown back only once both the table on disk and the kernel hold the partition at its old
            # size again. Left smaller is safe; grown past the partition is not.
            if disk_part_is "$TAIL_DEV" "$TAIL_START_SEC" "$TAIL_SIZE_SEC" \
                && await_kernel_part "$TAIL_DEV" "$TAIL_START_SEC" "$TAIL_SIZE_SEC"; then
                btrfs filesystem resize "${TAIL_DEVID}max" "$ROLLBACK_BTRFS_MNT" >/dev/null 2>&1 || undone=0
            else
                rollback_incomplete "Btrfs on ${TAIL_DEV} was left smaller, since its partition could not be confirmed back at its old size. The backups are in ${BACKUP_BASE}."
                undone=0
            fi
        fi
        # The record of the build stays while anything it describes is still on the disk.
        if (( undone )) && [[ -n "$BUILD_STATE_WRITTEN" ]]; then
            rm -f -- "$BUILD_STATE" || true
            sync -f -- "$(dirname -- "$BUILD_STATE")" 2>/dev/null || true
        fi
    fi
    if [[ -n "$AUTOMOUNT_UNIT" ]]; then
        systemctl daemon-reload 2>/dev/null || true
        systemctl start "$AUTOMOUNT_UNIT" 2>/dev/null || true
    fi
    # The partition table backup stays after a failure for recovery by hand.
    if (( exit_code == 0 )); then
        [[ -n "$SFDISK_BACKUP" && -f "$SFDISK_BACKUP" ]] && rm -f "$SFDISK_BACKUP"
    fi
    return 0
}

lock_resize() {
    local old_umask
    mkdir -p "$(dirname "$BOOT_LOCK")" "$(dirname "$RESIZE_LOCK")"
    # Any account that can read a lock file can hold it.
    old_umask="$(umask)"
    umask 077
    exec 8>"$RESIZE_LOCK" 9>"$BOOT_LOCK"
    umask "$old_umask"
    flock -w 30 8 && flock -w 30 9 \
        || die_json "Boot partition is currently locked by another system update or snapshot task."
    # Pacman holds its database lock from before the pre-transaction guard until after all boot hooks.
    [[ ! -e /var/lib/pacman/db.lck ]] || die_json "Wait for the package transaction to finish before resizing EFI."
}

# Prints "<node> <start> <size> <type> <partition id>" for each partition in the sfdisk dump on stdin.
dump_parts() {
    awk '$2 == ":" {
        line = $0
        sub(/,[[:space:]]*name=".*/, "", line)
        split("start size type uuid", keys, " ")
        for (i = 1; i <= 4; i++) {
            val[i] = "-"
            if (match(line, keys[i] "=[[:space:]]*[0-9A-Fa-f-]+")) {
                val[i] = substr(line, RSTART, RLENGTH)
                sub(/^[a-z]+=[[:space:]]*/, "", val[i])
            }
        }
        print $1, val[1], val[2], toupper(val[3]), toupper(val[4])
    }'
}

# Whether partition $1, with partition id $2, is mounted or named in fstab. In doubt it is.
part_in_use() {
    local dev="$1" guid="$2" real fsid verdict src
    real="$(readlink -f -- "$dev" 2>/dev/null || true)"
    [[ -n "$real" ]] || return 0
    ! findmnt -n -S "$dev" >/dev/null 2>&1 || return 0
    [[ -z "$(lsblk -dno MOUNTPOINTS "$dev" 2>/dev/null | tr -d '[:space:]')" ]] || return 0
    [[ -f "$FSTAB_PATH" ]] || return 1
    fsid="$(blkid -p -s UUID -o value "$dev" 2>/dev/null || true)"
    verdict="$(awk -v a="${guid,,}" -v b="${fsid,,}" -v d="$dev" -v r="$real" '
        /^[[:space:]]*#/ || NF < 2 { next }
        { l = tolower($0) }
        index(l, a) || (b != "" && index(l, b)) || $1 == d || $1 == r { named = 1 }
        END { print (named ? "named" : "clear") }
    ' "$FSTAB_PATH" 2>/dev/null || true)"
    [[ "$verdict" == clear ]] || return 0
    while read -r src; do
        [[ "$(readlink -f -- "$src" 2>/dev/null || true)" != "$real" ]] || return 0
    done < <(findmnt --fstab -F "$FSTAB_PATH" -e -n -o SOURCE 2>/dev/null || true)
    return 1
}

# Records what is about to be built, before the first write to the disk, so a run that dies before
# the switch is recorded can be undone later. $4 is the partition being shrunk, when there is one.
write_build_state() {
    local partn="$1" start="$2" size="$3" tail="${4:-}" disk_id tail_id="" tstart=0 tsize=0 dir tmp
    disk_id="$(awk '$1 == "label-id:" { print toupper($2); exit }' "$SFDISK_BACKUP")"
    [[ "$disk_id" =~ ^[[:xdigit:]-]+$ ]] \
        || die_json "The partition table on ${ESP_DISK} has no identifier; nothing was changed."
    if [[ -n "$tail" ]]; then
        tail_id="$(dump_parts < "$SFDISK_BACKUP" | awk -v d="$tail" '$1 == d { print $5 }')"
        [[ "$tail_id" =~ ^[[:xdigit:]-]{36}$ ]] \
            || die_json "The partition ${tail} has no identifier; nothing was changed."
        tstart="$TAIL_START_SEC"
        tsize="$TAIL_SIZE_SEC"
    fi
    dir="$(dirname -- "$BUILD_STATE")"
    mkdir -p "$dir"
    tmp="$(mktemp "$dir/efi-resize.XXXXXX")"
    jq -nc --arg disk "$ESP_DISK" --arg disk_id "$disk_id" --argjson sector "$SECTOR_SIZE" \
        --argjson partn "$partn" --argjson start "$start" --argjson size "$size" \
        --arg tail "$tail_id" --argjson tail_start "$tstart" --argjson tail_size "$tsize" \
        '{disk:$disk, disk_id:$disk_id, sector:$sector, partn:$partn, start:$start, size:$size,
          tail:$tail, tail_start:$tail_start, tail_size:$tail_size}' > "$tmp"
    sync -- "$tmp"
    mv -f -- "$tmp" "$BUILD_STATE"
    sync -f -- "$dir"
    BUILD_STATE_WRITTEN=1
}

# Reads dump_parts lines on stdin and says what became of a planned build: the new partition at
# $1 with size $2 and, when $3 names a partition to shrink, that partition from $4 with size $5.
# Prints "built <node> <partition id> <shrunk node>" when the table holds exactly what the build
# writes, "unbuilt - - <shrunk node>" when it holds none of it, and nothing for any other table.
build_verdict() {
    awk -v nstart="$1" -v nsize="$2" -v tail_id="$3" -v tstart="$4" -v tsize="$5" -v esp="$ESP_GPT_TYPE" '
        $2 == nstart { hits++; nnode = $1; nsz = $3; ntype = $4; nid = $5 }
        tail_id != "" && $5 == toupper(tail_id) { tnode = $1; ts = $2; tz = $3; next }
        tail_id != "" && $2 != nstart && $2 ~ /^[0-9]+$/ && $2 + 0 >= tstart + 0 && $2 + 0 < tstart + tsize { clash = 1 }
        END {
            if (tail_id != "" && (tnode == "" || ts != tstart || tz !~ /^[0-9]+$/ || clash)) exit
            if (tnode == "") tnode = "-"
            if (hits == 1 && nsz == nsize && ntype == toupper(esp) && nid ~ /^[0-9A-F-]+$/ && length(nid) == 36 \
                && (tail_id == "" || tz + 0 == nstart - tstart))
                print "built", nnode, nid, tnode
            else if (hits == 0 && (tail_id == "" || tz == tsize))
                print "unbuilt", "-", "-", tnode
        }'
}

# Undoes a build that never got as far as recording the switch. The partition goes only when it sits
# exactly where it was planned and nothing uses it; anything else is left for a check by hand.
undo_interrupted_build() {
    local disk disk_id sector partn nstart nsize tail_id tstart tsize dump
    local state="" new_node="" new_id="" tail_node="" mnt="" backup restored entries num tries stray
    local manual="An EFI resize was interrupted and could not be undone automatically; nothing was changed. Check the partitions by hand, then remove ${BUILD_STATE}."

    [[ ! -e "$CUTOVER_STATE" ]] || return 0
    disk="$(jq -er '.disk' "$BUILD_STATE" 2>/dev/null)" && disk_id="$(jq -er '.disk_id' "$BUILD_STATE")" \
        && sector="$(jq -er '.sector' "$BUILD_STATE")" && partn="$(jq -er '.partn' "$BUILD_STATE")" \
        && nstart="$(jq -er '.start' "$BUILD_STATE")" && nsize="$(jq -er '.size' "$BUILD_STATE")" \
        && tail_id="$(jq -er '.tail' "$BUILD_STATE")" && tstart="$(jq -er '.tail_start' "$BUILD_STATE")" \
        && tsize="$(jq -er '.tail_size' "$BUILD_STATE")" \
        || die_json "$manual"
    [[ "$disk" == /dev/* && "$disk_id" =~ ^[[:xdigit:]-]+$ && "$sector" =~ ^[1-9][0-9]*$ \
        && "$partn" =~ ^[1-9][0-9]*$ && "$nstart" =~ ^[1-9][0-9]*$ && "$nsize" =~ ^[1-9][0-9]*$ \
        && "$tstart" =~ ^[0-9]+$ && "$tsize" =~ ^[0-9]+$ \
        && ( -z "$tail_id" || "$tail_id" =~ ^[[:xdigit:]-]{36}$ ) ]] || die_json "$manual"

    dump="$(sfdisk -d "$disk" 2>/dev/null || true)"
    if [[ "$(awk '$1 == "label-id:" { print toupper($2); exit }' <<<"$dump")" != "${disk_id^^}" ]]; then
        # Disk names can change from one start to the next.
        disk="$(lsblk -dnpo NAME,PTUUID 2>/dev/null | awk -v id="${disk_id^^}" 'toupper($2) == id { print $1 }' || true)"
        [[ -n "$disk" && "$disk" != *$'\n'* && -b "$disk" ]] || die_json "$manual"
        dump="$(sfdisk -d "$disk" 2>/dev/null || true)"
        [[ "$(awk '$1 == "label-id:" { print toupper($2); exit }' <<<"$dump")" == "${disk_id^^}" ]] \
            || die_json "$manual"
    fi
    read -r state new_node new_id tail_node \
        <<<"$(dump_parts <<<"$dump" | build_verdict "$nstart" "$nsize" "$tail_id" "$tstart" "$tsize" || true)" || true
    [[ "$state" == built || "$state" == unbuilt ]] || die_json "$manual"
    [[ "$tail_node" != "-" ]] || tail_node=""

    ESP_DISK="$disk"
    SECTOR_SIZE="$sector"
    if [[ -n "$tail_id" ]]; then
        [[ -b "$tail_node" ]] || die_json "$manual"
        mnt="$(find_mount_for_dev "$tail_node" || true)"
        [[ -n "$mnt" ]] || die_json "$manual"
    fi

    if [[ "$state" == built ]]; then
        [[ "$new_node" == "$(part_path_for_num "$disk" "$partn")" && -b "$new_node" \
            && "$(awk -v n="$new_node" '$1 == n && $2 == ":"' <<<"$dump")" == *'name="Mainstream EFI"'* ]] \
            || die_json "$manual"
        is_esp_partition "$new_node" && kernel_part_is "$new_node" "$nstart" "$nsize" || die_json "$manual"
        # A run that was killed while it filled the partition left it mounted in its own folder.
        while read -r stray; do
            [[ "$stray" =~ ^/run/mainstream/new-esp\.[A-Za-z0-9]+$ ]] || continue
            umount "$stray" 2>/dev/null && rmdir "$stray" 2>/dev/null || true
        done < <(findmnt -rn -o TARGET -S "$new_node" 2>/dev/null || true)
        if part_in_use "$new_node" "$new_id"; then
            die_json "$manual"
        fi

        emit_progress "undo" 3 "Removing the partition an interrupted EFI resize left behind..."
        if ! nvram_skipped; then
            for (( tries = 0; tries < 4; tries++ )); do
                entries="$(efibootmgr -v 2>/dev/null || true)"
                num="$(boot_entry_for "$entries" "$new_id" "" || true)"
                [[ -n "$num" ]] || break
                efibootmgr -q -b "$num" -B >/dev/null 2>&1 || true
            done
        fi
        mkdir -p -m 0700 "$BACKUP_BASE"
        backup="$(mktemp "$BACKUP_BASE/sfdisk-backup.XXXXXX")"
        printf '%s\n' "$dump" > "$backup"
        restored="$(awk -v ndev="$new_node" -v tdev="$tail_node" -v tsize="$tsize" '
            $1 == ndev && $2 == ":" { next }
            tdev != "" && $1 == tdev && $2 == ":" { sub(/size=[[:space:]]*[0-9]+/, "size= " tsize) }
            { print }
        ' <<<"$dump")"
        sfdisk --force --no-reread "$disk" <<<"$restored" >/dev/null 2>&1 \
            || die_json "The partition table on ${disk} could not be put back; its backup is ${backup}."
        refresh_kernel_parttable "$disk"
        dump="$(sfdisk -d "$disk" 2>/dev/null || true)"
        if [[ -z "$dump" ]] || dump_parts <<<"$dump" | awk -v s="$nstart" '$2 == s { hit = 1 } END { exit !hit }'; then
            die_json "The partition table on ${disk} still holds the unused EFI partition; its backup is ${backup}."
        fi
        rm -f -- "$backup"
    fi

    if [[ -n "$tail_id" ]]; then
        # The same rule as the rollback: grown only once the disk and the kernel hold the old size.
        TAIL_DEV="$tail_node"
        if disk_part_is "$TAIL_DEV" "$tstart" "$tsize" && await_kernel_part "$TAIL_DEV" "$tstart" "$tsize"; then
            btrfs filesystem resize "$(btrfs_devid_prefix "$TAIL_DEV" "$mnt")max" "$mnt" >/dev/null 2>&1 \
                || die_json "Btrfs on ${TAIL_DEV} could not be grown back to its partition. Run the EFI resize again to retry."
        else
            die_json "Btrfs on ${TAIL_DEV} was left smaller, since its partition could not be confirmed back at its old size. Restart, then run the EFI resize again."
        fi
    fi
    rm -f -- "$BUILD_STATE"
    sync -f -- "$(dirname -- "$BUILD_STATE")"
}

cmd_resize() {
    local target_mb="${1:-}"
    lock_resize

    if [[ -e "$CUTOVER_STATE" ]]; then
        trap cleanup_and_rollback EXIT
        finish_cutover report_recovery
        return 0
    fi
    if [[ -e "$RETIRE_STATE" ]]; then
        die_json "The last EFI resize is completed at the next restart. Restart, then run the EFI resize again."
    fi
    if [[ -e "$BUILD_STATE" ]]; then
        trap cleanup_and_rollback EXIT
        undo_interrupted_build
    fi

    emit_progress "preflight" 5 "Inspecting GPT layout and free space..."
    if ! analyze_layout "$target_mb" resize; then
        die_json "${REASON:-Unsupported partition layout.}"
    fi
    is_esp_partition "$ESP_DEV" || die_json "${ESP_DEV} is not an EFI System Partition; nothing was changed."

    trap cleanup_and_rollback EXIT

    mkdir -p -m 0700 "$BACKUP_BASE"
    SFDISK_BACKUP="$(mktemp "$BACKUP_BASE/sfdisk-backup.XXXXXX")"
    sfdisk -d "$ESP_DISK" > "$SFDISK_BACKUP"

    local align_sec=$(( 1048576 / SECTOR_SIZE ))
    (( align_sec < 1 )) && align_sec=1
    local target_sec=$(( (target_mb * 1048576) / SECTOR_SIZE ))
    target_sec=$(( (target_sec / align_sec) * align_sec ))

    # Build and verify the replacement before changing the boot or mount targets.
    local new_esp_start=0 new_esp_sec="$target_sec"
    local new_partn
    new_partn="$(find_next_free_partn "$ESP_DISK")" || die_json "No free GPT partition number available on $ESP_DISK."
    local new_esp_dev
    new_esp_dev="$(part_path_for_num "$ESP_DISK" "$new_partn")"

    # Enabled before the first write, so a build cut short by a power loss is undone at the next start.
    if [[ -d /run/systemd/system ]]; then
        systemctl enable mainstream-efi-resize-recover.service >/dev/null 2>&1 \
            || die_json "The EFI recovery service could not be enabled; nothing was changed."
    fi

    if [[ "$STRATEGY" == "new_esp_unallocated" ]]; then
        new_esp_start="$GAP_START_SEC"
        if (( new_esp_sec > GAP_SIZE_SEC )); then
            new_esp_sec="$GAP_SIZE_SEC"
        fi
        write_build_state "$new_partn" "$new_esp_start" "$new_esp_sec"
        ROLLBACK_DISK="$ESP_DISK"
        emit_progress "partition" 25 "Creating new ${target_mb} MB EFI System Partition (${new_esp_dev})..."
        local updated_dump
        updated_dump="$(cat "$SFDISK_BACKUP")"$'\n'"${new_esp_dev} : start= ${new_esp_start}, size= ${new_esp_sec}, type=${ESP_GPT_TYPE}, name=\"Mainstream EFI\""
        sfdisk --force --no-reread "$ESP_DISK" <<<"$updated_dump" >/dev/null
        refresh_kernel_parttable "$ESP_DISK"
        await_kernel_part "$new_esp_dev" "$new_esp_start" "$new_esp_sec" \
            || die_json "The kernel did not take the new partition ${new_esp_dev}; nothing was formatted."

    elif [[ "$STRATEGY" == "tail_btrfs_relocate" ]]; then
        new_esp_start=$(( ((LAST_LBA - new_esp_sec + 1) / align_sec) * align_sec ))
        new_esp_sec=$(( ((LAST_LBA - new_esp_start + 1) / align_sec) * align_sec ))
        local new_tail_end=$(( new_esp_start - 1 ))
        local new_tail_size=$(( new_tail_end - TAIL_START_SEC + 1 ))
        if (( new_tail_size <= align_sec )); then
            die_json "Calculated shrunk partition size for ${TAIL_DEV} is invalid."
        fi

        local old_tail_bytes=$(( TAIL_SIZE_SEC * SECTOR_SIZE ))
        local new_tail_bytes=$(( new_tail_size * SECTOR_SIZE ))
        local shrink_bytes=$(( old_tail_bytes - new_tail_bytes + SHRINK_CUSHION_BYTES ))

        emit_progress "shrink" 20 "Shrinking Btrfs filesystem (${TAIL_MNT}) to free ${target_mb} MB at end of disk..."
        TAIL_DEVID="$(btrfs_devid_prefix "$TAIL_DEV" "$TAIL_MNT")"
        write_build_state "$new_partn" "$new_esp_start" "$new_esp_sec" "$TAIL_DEV"
        ROLLBACK_BTRFS_MNT="$TAIL_MNT"
        btrfs filesystem resize "${TAIL_DEVID}-${shrink_bytes}" "$TAIL_MNT" >/dev/null
        btrfs filesystem sync "$TAIL_MNT" >/dev/null 2>&1 || sync

        # Verify Btrfs logical device size is strictly <= new_tail_bytes before touching GPT!
        local btrfs_cur_bytes
        btrfs_cur_bytes="$(btrfs filesystem usage -b "$TAIL_MNT" 2>/dev/null | awk '/Device size:/ {print $3; exit}' || echo 0)"
        if (( btrfs_cur_bytes == 0 || btrfs_cur_bytes > new_tail_bytes )); then
            die_json "Btrfs volume size (${btrfs_cur_bytes}) did not shrink below target boundary (${new_tail_bytes}); aborting safely before partition edit."
        fi

        emit_progress "partition" 42 "Updating GPT boundaries and creating ${new_esp_dev}..."
        ROLLBACK_DISK="$ESP_DISK"
        local rewritten_dump
        rewritten_dump="$(awk -v tdev="$TAIL_DEV" -v nsize="$new_tail_size" '
            $1 == tdev && $2 == ":" {
                sub(/size=[[:space:]]*[0-9]+/, "size= " nsize)
            }
            { print }
        ' "$SFDISK_BACKUP")"$'\n'"${new_esp_dev} : start= ${new_esp_start}, size= ${new_esp_sec}, type=${ESP_GPT_TYPE}, name=\"Mainstream EFI\""

        sfdisk --force --no-reread "$ESP_DISK" <<<"$rewritten_dump" >/dev/null
        refresh_kernel_parttable "$ESP_DISK"
        # Growing Btrfs to a partition the kernel still holds at its old size would run it into the new one.
        await_kernel_part "$TAIL_DEV" "$TAIL_START_SEC" "$new_tail_size" \
            && await_kernel_part "$new_esp_dev" "$new_esp_start" "$new_esp_sec" \
            || die_json "The kernel did not take the new partition sizes; Btrfs was not grown and nothing was formatted."

        emit_progress "reexpand" 55 "Snapping Btrfs filesystem to updated partition boundary..."
        btrfs filesystem resize "${TAIL_DEVID}max" "$TAIL_MNT" >/dev/null
        btrfs filesystem sync "$TAIL_MNT" >/dev/null 2>&1 || sync
    else
        die_json "Unhandled resize strategy '${STRATEGY}'."
    fi

    kernel_part_is "$new_esp_dev" "$new_esp_start" "$new_esp_sec" \
        || die_json "The kernel no longer holds ${new_esp_dev} where it was written; nothing was formatted."

    emit_progress "format" 68 "Formatting new EFI System Partition (${new_esp_dev}) as FAT32..."
    mkfs.vfat -F 32 -n "MSEFI" "$new_esp_dev" >/dev/null
    refresh_kernel_parttable "$ESP_DISK"
    local new_uuid=""
    tries=0
    while [[ -z "$new_uuid" ]] && (( tries < 15 )); do
        new_uuid="$(blkid -s UUID -o value "$new_esp_dev" 2>/dev/null || lsblk -dno UUID "$new_esp_dev" 2>/dev/null | tr -d ' ' || true)"
        [[ -n "$new_uuid" ]] && break
        sleep 0.2
        tries=$(( tries + 1 ))
    done
    [[ -n "$new_uuid" ]] || die_json "Could not read FAT32 UUID from ${new_esp_dev}."

    emit_progress "copy" 80 "Copying bootloader and UKI images to ${new_esp_dev}..."
    mkdir -p /run/mainstream
    TMP_ESP_MNT="$(mktemp -d /run/mainstream/new-esp.XXXXXX)"
    mount -t vfat -o umask=0077 "$new_esp_dev" "$TMP_ESP_MNT"
    copy_esp_tree "$ESP_MNT" "$TMP_ESP_MNT"

    emit_progress "verify" 90 "Verifying UKIs and Limine pins on the new partition..."
    verify_esp_contents "$ESP_MNT" "$TMP_ESP_MNT" || die_json "Verification of new EFI partition failed; rolling back cleanly."

    local old_guid new_guid loader
    [[ -f "$FSTAB_PATH" ]] || die_json "The EFI mount requires an fstab to relocate it."
    loader="$(loader_on_esp "$TMP_ESP_MNT")" || die_json "No supported EFI loader was found."
    old_guid="$(blkid -s PARTUUID -o value "$ESP_DEV")"
    new_guid="$(blkid -s PARTUUID -o value "$new_esp_dev")"
    # Firmware that will not keep the entry is found out while the resize can still be undone.
    if ! nvram_skipped; then
        ensure_boot_entry "$new_esp_dev" "$new_guid" "$loader" \
            || die_json "The firmware did not keep a boot entry for the new EFI partition; rolling back cleanly."
        ROLLBACK_BOOT_ENTRY="$BOOT_ENTRY"
    fi
    cp -a -- "$FSTAB_PATH" "${FSTAB_PATH}.bak-efi-resize"
    sync -f -- "$(dirname -- "$FSTAB_PATH")"
    umount "$TMP_ESP_MNT"
    rmdir "$TMP_ESP_MNT"
    TMP_ESP_MNT=""

    emit_progress "cutover" 93 "Recording the EFI switch so it can finish after a restart..."
    write_cutover_state "$ESP_MNT" "$old_guid" "$new_guid" "$new_uuid" "$loader"
    finish_cutover

    local final_bytes
    final_bytes="$(lsblk -bdno SIZE "$new_esp_dev" 2>/dev/null | tr -d ' ' || echo 0)"
    emit_progress "done" 100 "EFI boot partition expanded to $(( final_bytes / (1024 * 1024) )) MB on ${new_esp_dev}."
}

case "${1:-}" in
    mirror)
        [[ $EUID == 0 && -e "$RETIRE_STATE" && ! -e "$CUTOVER_STATE" && ! -e "$BUILD_STATE" ]] || exit 0
        trap '[[ -z "$TMP_ESP_MNT" ]] || { umount "$TMP_ESP_MNT" 2>/dev/null; rmdir "$TMP_ESP_MNT" 2>/dev/null; } || true' EXIT
        mirror_old_esp || true
        exit 0
        ;;
    probe)
        cmd_probe "${2:-2048}"
        ;;
    plan)
        cmd_plan
        ;;
    resize)
        cmd_resize "${2:-}"
        ;;
    recover)
        [[ $EUID == 0 ]] || exit 1
        [[ -e "$CUTOVER_STATE" || -e "$BUILD_STATE" || -e "$RETIRE_STATE" ]] || exit 0
        lock_resize
        trap cleanup_and_rollback EXIT
        if [[ -e "$CUTOVER_STATE" ]]; then
            finish_cutover
        elif [[ -e "$BUILD_STATE" ]]; then
            undo_interrupted_build
        fi
        if [[ -e "$RETIRE_STATE" && ! -e "$CUTOVER_STATE" && ! -e "$BUILD_STATE" ]]; then
            retire_after_restart
        fi
        ;;
    cancel)
        [[ $EUID == 0 ]] || exit 1
        [[ -e "$CUTOVER_STATE" || -e "$RETIRE_STATE" ]] || exit 0
        lock_resize
        trap cleanup_and_rollback EXIT
        if [[ -e "$CUTOVER_STATE" || -e "$RETIRE_STATE" ]]; then cancel_cutover; fi
        ;;
    *)
        echo "Usage: $0 {probe [target_mb]|plan|resize <target_mb>|recover|cancel}" >&2
        exit 1
        ;;
esac
