#!/usr/bin/env bash
# change-own-password: change the password of the account that runs it, for
# the Accounts page in Settings. Installed at /usr/local/bin/change-own-password.
#
# Its polkit action needs no administrator because the current password is
# checked instead, so it takes no account name and acts only on the caller's.
#
# Reads the current password and then the new one, a line each, from stdin.
# user-manager checks the first and applies its usual rules to the second.

set -euo pipefail
# pkexec keeps the caller's umask.
umask 022

USER_MANAGER=/usr/local/bin/user-manager

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 22; }

[[ $# -eq 0 ]] || fail "takes no arguments; it only changes the password of the account running it"
[[ $EUID -eq 0 && "${PKEXEC_UID:-}" =~ ^[0-9]+$ ]] || fail "must be run through pkexec"
[[ "$PKEXEC_UID" != 0 ]] || fail "refusing to change the root password"

IFS=: read -r user _ uid _ < <(getent passwd "$PKEXEC_UID") || fail "no account has uid $PKEXEC_UID"
[[ "$uid" == "$PKEXEC_UID" ]] || fail "no account has uid $PKEXEC_UID"

# A failed exec exits 126 or 127, which the page reads as a canceled or
# failed authentication.
[[ -x "$USER_MANAGER" ]] || fail "user-manager is not installed at $USER_MANAGER"
# An older user-manager ignores verify and would set the password unchecked,
# or check it with no limit on guesses.
grep -q '^_check_current_password()' "$USER_MANAGER" \
    || fail "the installed user-manager cannot check the current password; update the system first"
exec "$USER_MANAGER" set-password "$user" verify
